@model Income
@{
    ViewData["Title"] = "Edit Income";
    Layout = "_Layout";
}

<div style="max-width: 640px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; margin: 0;">Edit Income Record</h1>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Update earnings, inflow source, or member attribution</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Cancel
        </a>
    </div>

    <div class="glass-card">
        <div class="glass-card-header" style="background: rgba(16, 185, 129, 0.08); border-bottom: 1px solid rgba(16, 185, 129, 0.2);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(16, 185, 129, 0.2); color: var(--emerald-400); display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-pen"></i>
                </div>
                <h3 style="font-size: 15px; font-weight: 700; margin: 0; color: var(--text-primary);">Income Details</h3>
            </div>
            <span class="badge badge-emerald">Admin Function</span>
        </div>

        <div class="glass-card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; color: #fb7185; font-size: 13px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p style="margin: 0 0 4px;"><i class="fa-solid fa-circle-exclamation"></i> @error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-action="Edit" method="post" autocomplete="off">
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="form-group">
                    <label class="form-label" for="MemberName">Family Member *</label>
                    <input type="text" id="MemberName" name="MemberName" class="form-control" required value="@Model.MemberName" placeholder="e.g. Father, Mother, Rohan" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Source">Source / Client *</label>
                    <input type="text" id="Source" name="Source" class="form-control" required placeholder="e.g. Monthly Salary, Business Sales, Dividends, Rent" value="@Model.Source" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Amount">Amount (₹) *</label>
                    <input type="number" id="Amount" name="Amount" class="form-control font-mono" required step="0.01" min="0" value="@Model.Amount.ToString("F2")" style="font-size: 18px; font-weight: 700;" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Date">Date *</label>
                    <input type="date" id="Date" name="Date" class="form-control" required value="@Model.Date.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Description">Description (Optional)</label>
                    <textarea id="Description" name="Description" class="form-control" rows="3" placeholder="Additional notes or payment mode...">@Model.Description</textarea>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 28px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1; background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 8px 24px -4px rgba(16, 185, 129, 0.4);">
                        <i class="fa-solid fa-floppy-disk"></i> Update Income
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>