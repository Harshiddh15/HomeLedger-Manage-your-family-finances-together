@model Income
@{
    var isMember = Context.Session.GetString("LoginType") == "Member";
    var memberName = Context.Session.GetString("MemberName") ?? Model?.MemberName;
    ViewData["Title"] = "Record Income";
    Layout = "_Layout";
}

<div style="max-width: 640px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; margin: 0;">Record New Income</h1>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Add an earnings entry to the family ledger</p>
        </div>
        <a asp-action="@(isMember ? "MemberDashboard" : "Index")" asp-controller="@(isMember ? "Home" : "Income")" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Cancel
        </a>
    </div>

    <div class="glass-card">
        <div class="glass-card-header" style="background: rgba(16, 185, 129, 0.08); border-bottom: 1px solid rgba(16, 185, 129, 0.2);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(16, 185, 129, 0.2); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
                <h3 style="font-size: 15px; font-weight: 700; margin: 0; color: var(--text-primary);">Income Details</h3>
            </div>
            <span class="badge badge-emerald">Credit (+)</span>
        </div>

        <div class="glass-card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; color: #fb7185; font-size: 13px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p style="margin: 0 0 4px;"><i class="fa-solid fa-circle-exclamation"></i> @error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-action="Create" method="post" autocomplete="off">
                <div class="form-group">
                    <label class="form-label" for="MemberName">Contributing Member *</label>
                    @if (isMember)
                    {
                        <input type="text" id="MemberName" name="MemberName" class="form-control" required value="@memberName" readonly style="opacity: 0.9; font-weight: 700; color: var(--emerald-400);" />
                        <small style="color: var(--emerald-400); font-size: 11.5px; display: block; margin-top: 4px;">
                            <i class="fa-solid fa-lock"></i> Auto-locked to your authenticated member identity: <strong>@memberName</strong>
                        </small>
                    }
                    else
                    {
                        <input type="text" id="MemberName" name="MemberName" class="form-control" required value="@Model?.MemberName" placeholder="e.g. Father, Mother, Rohan" />
                    }
                </div>

                <div class="form-group">
                    <label class="form-label" for="Amount">Amount (₹) *</label>
                    <input type="number" id="Amount" name="Amount" class="form-control font-mono" required step="0.01" min="0" placeholder="0.00" value="@Model?.Amount" style="font-size: 18px; font-weight: 700;" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Source">Income Source / Category *</label>
                    <input type="text" id="Source" name="Source" class="form-control" required placeholder="e.g. Monthly Salary, Freelance, Investment Return, Rental" value="@Model?.Source" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Date">Transaction Date *</label>
                    <input type="date" id="Date" name="Date" class="form-control" required value="@(Model?.Date != null ? Model.Date.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Description">Description / Notes (Optional)</label>
                    <textarea id="Description" name="Description" class="form-control" rows="3" placeholder="Additional details or reference notes...">@Model?.Description</textarea>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 28px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">
                        <i class="fa-solid fa-floppy-disk"></i> Save Income Entry
                    </button>
                    @if (isMember)
                    {
                        <a asp-controller="Home" asp-action="MemberDashboard" class="btn btn-secondary">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-secondary">
                            Cancel
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
