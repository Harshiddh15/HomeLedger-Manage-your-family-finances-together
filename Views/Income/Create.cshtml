@model Income
@{
    var isMember = Context.Session.GetString("LoginType") == "Member";
    var memberName = Context.Session.GetString("MemberName") ?? Model?.MemberName;
    ViewData["Title"] = "Add Income";
    Layout = "_Layout";
}

<style>
    .page-header {
        margin-bottom: 30px;
        text-align: center;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: var(--hud-text-white);
        font-family: 'JetBrains Mono', monospace;
    }

    .form-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 200px);
        width: 100%;
    }

    .card {
        background: var(--hud-bg-card);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        overflow: hidden;
        max-width: 600px;
        width: 100%;
        margin: 0 auto;
    }

    .card-header {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(0, 229, 255, 0.25) 100%);
        border-bottom: 1px solid var(--hud-border-cyan);
        color: white;
        padding: 20px 25px;
    }

    .card-header h3 {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        color: var(--hud-text-white);
    }

    .card-body {
        padding: 30px 25px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: var(--hud-text-white);
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        background: var(--hud-bg-input);
        border: 1px solid var(--hud-border);
        border-radius: 8px;
        color: var(--hud-text-white);
        font-size: 14px;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--hud-cyan);
        box-shadow: 0 0 10px rgba(0, 229, 255, 0.25);
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #10b981 0%, #00e5ff 100%);
        color: #0b111e;
        border: none;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 229, 255, 0.3);
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--hud-border);
        color: var(--hud-text-muted);
        margin-left: 10px;
    }

    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.15);
        color: white;
    }

    .validation-summary {
        background: rgba(244, 63, 94, 0.12);
        border: 1px solid #f43f5e;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #f43f5e;
        font-size: 13px;
    }
</style>

<div class="page-header">
    <h1 class="page-title"><span style="color: var(--hud-cyan);">//</span> Add Income</h1>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fa-solid fa-arrow-trend-up" style="color: #10b981; margin-right: 8px;"></i> New Income Record</h3>
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p style="margin: 0 0 5px 0;"><i class="fa-solid fa-circle-exclamation"></i> @error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Create" method="post">
            <div class="form-group">
                <label for="MemberName">Member Name</label>
                @if (isMember)
                {
                    <input type="text" id="MemberName" name="MemberName" class="form-control" required value="@memberName" readonly style="opacity: 0.9; font-weight: 700; color: #10b981;">
                    <small style="color: var(--hud-teal); font-size: 11px; display: block; margin-top: 4px;">
                        <i class="fa-solid fa-lock"></i> Auto-locked to your logged-in Member account: <strong>@memberName</strong>
                    </small>
                }
                else
                {
                    <input type="text" id="MemberName" name="MemberName" class="form-control" required value="@Model?.MemberName" placeholder="e.g. Father, Mother, Rohan">
                }
            </div>
            <div class="form-group">
                <label for="Amount">Amount (₹)</label>
                <input type="number" id="Amount" name="Amount" class="form-control" required step="0.01" min="0" value="@Model?.Amount">
            </div>
            <div class="form-group">
                <label for="Source">Source</label>
                <input type="text" id="Source" name="Source" class="form-control" required placeholder="e.g., Salary, Business, Freelance" value="@Model?.Source">
            </div>
            <div class="form-group">
                <label for="Date">Date</label>
                <input type="date" id="Date" name="Date" class="form-control" required value="@(Model?.Date != null ? Model.Date.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))">
            </div>
            <div class="form-group">
                <label for="Description">Description (Optional)</label>
                <textarea id="Description" name="Description" class="form-control" rows="3">@Model?.Description</textarea>
            </div>
            <div style="margin-top: 25px; display: flex; align-items: center;">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-save"></i> Save Income
                </button>
                @if (isMember)
                {
                    <a asp-controller="Home" asp-action="MemberDashboard" class="btn btn-secondary">
                        <i class="fa-solid fa-xmark"></i> Cancel
                    </a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-xmark"></i> Cancel
                    </a>
                }
            </div>
        </form>
    </div>
</div>
