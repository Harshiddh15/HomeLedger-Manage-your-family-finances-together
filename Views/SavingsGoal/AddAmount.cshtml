@model SavingsGoal
@{
    ViewData["Title"] = "Add Amount";
    Layout = "_Layout";
}

<style>
    .page-header {
        margin-bottom: 30px;
        text-align: center;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #333;
    }

    .card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        max-width: 600px;
        width: 100%;
        margin: 0 auto;
    }

    .card-header {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        padding: 20px 25px;
    }

    .card-header h3 {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
    }

    .card-body {
        padding: 30px 25px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #333;
        font-weight: 500;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 14px;
        transition: border-color 0.3s;
    }

    .form-control:focus {
        outline: none;
        border-color: #11998e;
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-primary {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(17, 153, 142, 0.3);
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Add Amount to @Model.GoalName</h1>
</div>

<div class="card">
    <div class="card-header">
        <h3>Add Savings</h3>
    </div>
    <div class="card-body">
        <p style="margin-bottom: 20px;"><strong>Current Progress:</strong> ₹@Model.CurrentAmount.ToString("N2") / ₹@Model.TargetAmount.ToString("N2")</p>
        
        <form asp-action="AddAmount" method="post">
            <input type="hidden" name="id" value="@Model.Id">
            <div class="form-group">
                <label for="amount">Amount to Add (₹)</label>
                <input type="number" id="amount" name="amount" class="form-control" required step="0.01" min="0" placeholder="Enter amount">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add Amount
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
