@model List<Member>
@{
    ViewData["Title"] = "Family Members & Access Keys";
    Layout = "_Layout";
}

<div>
    <!-- Page Header & Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                <h1 style="font-size: 24px; font-weight: 800; margin: 0;">Family Members &amp; Access Keys</h1>
                <span class="badge badge-indigo">@Model.Count Members</span>
            </div>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">
                Manage family member identities, relationships, and individual portal passwords
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-user-plus"></i> Add New Member
        </a>
    </div>

    <!-- Table Container -->
    <div class="table-container">
        @if (Model != null && Model.Any())
        {
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Member Name</th>
                        <th>Relation</th>
                        <th>Mobile</th>
                        <th>Portal Login Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        var isHead = (member.Relation ?? "").Equals("Father", StringComparison.OrdinalIgnoreCase) ||
                                     (member.Relation ?? "").Equals("Head", StringComparison.OrdinalIgnoreCase) ||
                                     (member.MemberName ?? "").Equals("Father", StringComparison.OrdinalIgnoreCase);
                        var hasPassword = !string.IsNullOrEmpty(member.Password);
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: @(isHead ? "rgba(16, 185, 129, 0.15)" : "rgba(99, 102, 241, 0.15)"); color: @(isHead ? "#10b981" : "#818cf8"); display: flex; align-items: center; justify-content: center; font-size: 13px;">
                                        <i class="fa-solid @(isHead ? "fa-crown" : "fa-user")"></i>
                                    </div>
                                    <strong style="color: var(--text-primary); font-size: 14px;">@member.MemberName</strong>
                                </div>
                            </td>
                            <td>
                                <span class="badge" style="background: rgba(255, 255, 255, 0.05); color: var(--text-secondary); border: 1px solid var(--border-subtle);">
                                    @member.Relation
                                </span>
                            </td>
                            <td style="color: var(--text-muted); font-size: 13px;">
                                @(string.IsNullOrEmpty(member.Mobile) ? "—" : member.Mobile)
                            </td>
                            <td>
                                @if (isHead)
                                {
                                    <span class="badge badge-emerald">
                                        <i class="fa-solid fa-crown" style="font-size: 9px;"></i> Admin Head
                                    </span>
                                }
                                else if (hasPassword)
                                {
                                    <span class="badge badge-cyan">
                                        <i class="fa-solid fa-key" style="font-size: 9px;"></i> Active Key Set
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-amber">
                                        <i class="fa-solid fa-triangle-exclamation" style="font-size: 9px;"></i> Key Pending
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 8px;">
                                    <a asp-action="Edit" asp-route-id="@member.Id" class="btn btn-secondary btn-sm" style="padding: 4px 10px; font-size: 11px;">
                                        <i class="fa-solid fa-key"></i> Set Password
                                    </a>
                                    @if (!isHead)
                                    {
                                        <a asp-action="Delete" asp-route-id="@member.Id" class="btn btn-danger btn-sm" style="padding: 4px 10px; font-size: 11px;">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="text-align: center; padding: 60px 20px; color: var(--text-muted);">
                <i class="fa-solid fa-users" style="font-size: 36px; opacity: 0.35; margin-bottom: 12px; display: block;"></i>
                <h4 style="font-size: 16px; font-weight: 700; color: var(--text-secondary); margin-bottom: 4px;">No Members Found</h4>
                <p style="font-size: 13.5px; margin: 0 0 16px;">Add your family members to give them personal ledger access.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-user-plus"></i> Add First Member
                </a>
            </div>
        }
    </div>
</div>
