@model Member
@{
    ViewData["Title"] = "Edit Member Profile";
    Layout = "_Layout";
}

<div style="max-width: 640px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; margin: 0;">Edit Member Profile</h1>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Update member details and portal password</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Cancel
        </a>
    </div>

    <div class="glass-card">
        <div class="glass-card-header" style="background: rgba(14, 165, 233, 0.08); border-bottom: 1px solid rgba(14, 165, 233, 0.2);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(14, 165, 233, 0.2); color: #0ea5e9; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-user-pen"></i>
                </div>
                <h3 style="font-size: 15px; font-weight: 700; margin: 0; color: var(--text-primary);">Update @Model.MemberName</h3>
            </div>
            <span class="badge badge-cyan">Identity Key</span>
        </div>

        <div class="glass-card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; color: #fb7185; font-size: 13px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p style="margin: 0 0 4px;"><i class="fa-solid fa-circle-exclamation"></i> @error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-action="Edit" method="post" autocomplete="off">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FamilyId" />

                <div class="form-group">
                    <label class="form-label" for="MemberName">Member Name *</label>
                    <input type="text" id="MemberName" name="MemberName" class="form-control" required value="@Model?.MemberName" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Relation">Relationship *</label>
                    <input type="text" id="Relation" name="Relation" class="form-control" required value="@Model?.Relation" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Password">New Member Password (Optional)</label>
                    <div style="position: relative;">
                        <input type="password" id="Password" name="Password" class="form-control" placeholder="Leave empty to keep current password" autocomplete="new-password" />
                        <button type="button" onclick="togglePassword('Password', 'toggleIconEdit')" style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-dim); cursor: pointer; padding: 4px;">
                            <i class="fa-solid fa-eye" id="toggleIconEdit"></i>
                        </button>
                    </div>
                    <small style="color: var(--text-dim); font-size: 12px; margin-top: 6px; display: block;">
                        Naya password set karne ke liye type karein, warna purana password hi rahega.
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label" for="Mobile">Mobile Number (Optional)</label>
                    <input type="text" id="Mobile" name="Mobile" class="form-control" value="@Model?.Mobile" />
                </div>

                <div style="display: flex; gap: 12px; margin-top: 28px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">
                        <i class="fa-solid fa-floppy-disk"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
