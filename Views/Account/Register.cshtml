@{
    ViewData["Title"] = "Create Family Workspace — HomeLedger";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    
    <!-- Google Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Master Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
            background-color: var(--bg-base);
            background-image: 
                radial-gradient(circle at 50% 20%, rgba(16, 185, 129, 0.12), transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(99, 102, 241, 0.1), transparent 50%);
        }

        .auth-wrapper {
            width: 100%;
            max-width: 480px;
            animation: fadeInUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .auth-card {
            background: rgba(18, 26, 42, 0.88);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-xl);
            padding: 40px 36px;
            box-shadow: 0 24px 60px -10px rgba(0, 0, 0, 0.7);
        }

        .input-group-custom {
            position: relative;
        }

        .input-group-custom .toggle-eye {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 14px;
            padding: 4px;
            transition: color var(--transition-fast);
        }

        .input-group-custom .toggle-eye:hover {
            color: var(--text-primary);
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <!-- Brand Header -->
        <div style="text-align: center; margin-bottom: 28px;">
            <a href="/" style="display: inline-flex; align-items: center; gap: 12px; margin-bottom: 12px; text-decoration: none;">
                <div class="brand-icon-box" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="fa-solid fa-vault"></i>
                </div>
                <div style="text-align: left;">
                    <span style="font-size: 22px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em;">
                        Home<span style="color: var(--emerald-400);">Ledger</span>
                    </span>
                    <small style="display: block; font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.8px;">
                        Family Wealth OS
                    </small>
                </div>
            </a>
            <h2 style="font-size: 22px; font-weight: 800; margin-bottom: 6px;">Create Your Family Workspace</h2>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Set up your household ledger in under 60 seconds</p>
        </div>

        <div class="auth-card">
            <!-- Flash Alert Messages -->
            @if (TempData["Error"] != null)
            {
                <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; color: #fb7185; font-size: 13px; display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-circle-exclamation" style="font-size: 16px;"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <form asp-action="Register" method="post" autocomplete="off">
                <div class="form-group">
                    <label class="form-label" for="familyId">Unique Family ID *</label>
                    <input type="text" id="familyId" name="familyId" class="form-control" placeholder="e.g. Patel's Family or Sharma2026" required autofocus />
                    <small style="color: var(--text-dim); font-size: 11.5px; display: block; margin-top: 4px;">
                        Family members will use this identifier to locate your family portal.
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label" for="familyName">Display Family Name *</label>
                    <input type="text" id="familyName" name="familyName" class="form-control" placeholder="e.g. The Patel Household" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Family Head (Admin) Password *</label>
                    <div class="input-group-custom">
                        <input type="password" id="password" name="password" class="form-control" placeholder="Create a strong password (min 6 characters)" required />
                        <button type="button" class="toggle-eye" onclick="togglePassword('password', 'eyeReg1')">
                            <i class="fa-solid fa-eye" id="eyeReg1"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="confirmPassword">Confirm Password *</label>
                    <div class="input-group-custom">
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Re-enter admin password" required />
                        <button type="button" class="toggle-eye" onclick="togglePassword('confirmPassword', 'eyeReg2')">
                            <i class="fa-solid fa-eye" id="eyeReg2"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 13px; font-size: 15px; margin-top: 10px;">
                    <i class="fa-solid fa-sparkles"></i>
                    <span>Register Family Vault</span>
                </button>
            </form>

            <div style="margin-top: 24px; text-align: center; border-top: 1px solid var(--border-subtle); padding-top: 18px; font-size: 13px; color: var(--text-muted);">
                Already have a family workspace?
                <a asp-action="Login" style="color: var(--emerald-400); font-weight: 700; margin-left: 4px;">Sign In</a>
            </div>
        </div>

        <div style="text-align: center; margin-top: 20px;">
            <a href="/" style="font-size: 13px; color: var(--text-dim); text-decoration: none;">
                <i class="fa-solid fa-arrow-left"></i> Back to Home Overview
            </a>
        </div>
    </div>

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-solid fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-solid fa-eye';
            }
        }
    </script>
</body>
</html>
