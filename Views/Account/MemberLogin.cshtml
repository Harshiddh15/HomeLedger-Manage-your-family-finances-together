@{
    ViewData["Title"] = "Member Login — HomeLedger";
    Layout = null;
    var hasFlash = TempData["Error"] != null || TempData["Success"] != null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-base);
            overflow-x: hidden;
            position: relative;
        }

        .login-bg-canvas {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
            background-image: radial-gradient(rgba(148, 163, 184, 0.1) 1px, transparent 1px);
            background-size: 28px 28px;
        }

        .login-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(85px);
            opacity: 0.3;
        }

        .login-orb-1 {
            width: 460px;
            height: 460px;
            top: -120px;
            left: -80px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.6), transparent 70%);
            animation: orbDriftA 14s ease-in-out infinite alternate;
        }

        .login-orb-2 {
            width: 420px;
            height: 420px;
            bottom: -100px;
            right: -60px;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.55), transparent 70%);
            animation: orbDriftB 17s ease-in-out infinite alternate;
        }

        body.light-mode .login-orb { opacity: 0.18; }

        .login-topbar {
            position: relative;
            z-index: 10;
            max-width: 1180px;
            width: 100%;
            margin: 0 auto;
            padding: 20px 28px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .auth-center {
            position: relative;
            z-index: 2;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 20px 40px;
        }

        .auth-wrapper {
            width: 100%;
            max-width: 460px;
            animation: fadeInUp 0.58s cubic-bezier(0.16, 1, 0.3, 1) @(hasFlash ? "0s" : "1.38s") both;
        }

        .auth-card {
            position: relative;
            background: var(--bg-card);
            backdrop-filter: blur(26px);
            -webkit-backdrop-filter: blur(26px);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-xl);
            padding: 38px 34px;
            box-shadow: var(--shadow-xl), 0 0 44px rgba(99, 102, 241, 0.14);
            overflow: hidden;
        }

        .auth-card-topline {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #6366f1, #38bdf8, #10b981, transparent);
            background-size: 200% 100%;
            animation: cardTopShimmer 4s linear infinite;
        }

        .input-icon-field { position: relative; }
        .input-icon-field .lead-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-dim);
            font-size: 14px;
            pointer-events: none;
            transition: color 0.2s ease, transform 0.2s ease;
        }
        .input-icon-field .form-control { padding-left: 42px; }
        .input-icon-field:focus-within .lead-icon { color: var(--indigo-400); transform: translateY(-50%) scale(1.1); }
        .input-icon-field.has-eye .form-control { padding-right: 42px; }
        .input-icon-field .toggle-eye {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 14px;
            padding: 4px;
        }

        @@keyframes orbDriftA { from { transform: translate(0, 0); } to { transform: translate(35px, 25px); } }
        @@keyframes orbDriftB { from { transform: translate(0, 0); } to { transform: translate(-30px, -22px); } }
        @@keyframes cardTopShimmer { 0% { background-position: 200% 0%; } 100% { background-position: -200% 0%; } }
    </style>
</head>
<body>
    @await Html.PartialAsync("_LoginIntroOverlay")

    <div class="login-bg-canvas" aria-hidden="true">
        <div class="login-orb login-orb-1"></div>
        <div class="login-orb login-orb-2"></div>
    </div>

    <header class="login-topbar">
        <a asp-controller="Home" asp-action="Landing" class="brand-logo">
            <div class="brand-icon-box"><i class="fa-solid fa-user-shield"></i></div>
            <div>
                <span>Home<span style="color: var(--emerald-400);">Ledger</span></span>
                <small style="display: block; font-size: 10px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.8px;">Member Portal</small>
            </div>
        </a>
        <button class="nav-icon-btn" id="themeToggle" title="Toggle Theme" aria-label="Toggle theme"><i class="fa-solid fa-sun"></i></button>
    </header>

    <main class="auth-center">
        <div class="auth-wrapper">
            <div class="auth-card">
                <div class="auth-card-topline"></div>

                <div style="margin-bottom: 22px;">
                    <span class="badge badge-indigo" style="margin-bottom: 10px;"><i class="fa-solid fa-user-check"></i> Member Workspace</span>
                    <h2 style="font-size: 22px; font-weight: 800; margin-bottom: 4px;">Member Sign In</h2>
                    <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Access your isolated family member ledger</p>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.38); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; color: #fb7185; font-size: 13px; display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                }

                <form asp-action="MemberLogin" method="post">
                    <div class="form-group">
                        <label class="form-label" for="family_id">Family ID *</label>
                        <div class="input-icon-field">
                            <i class="fa-solid fa-house-user lead-icon"></i>
                            <input type="text" id="family_id" name="familyId" class="form-control" placeholder="e.g. Patel's Family" required autofocus>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="member_name">Member Name *</label>
                        <div class="input-icon-field">
                            <i class="fa-solid fa-user lead-icon"></i>
                            <input type="text" id="member_name" name="memberName" class="form-control" placeholder="e.g. Mother, Son" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="password">Password *</label>
                        <div class="input-icon-field has-eye">
                            <i class="fa-solid fa-lock lead-icon"></i>
                            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your member password" required>
                            <button type="button" class="toggle-eye" onclick="togglePassword('password', 'eyeMem')">
                                <i class="fa-solid fa-eye" id="eyeMem"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-indigo" style="width: 100%; padding: 13px; font-size: 15px;">
                        <span>Sign In to Member Portal</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>

                <div style="margin-top: 22px; text-align: center; border-top: 1px solid var(--border-subtle); padding-top: 18px; font-size: 13px; color: var(--text-muted);">
                    Need Admin login?
                    <a asp-action="Login" style="color: var(--emerald-400); font-weight: 700; margin-left: 4px;">Switch to Admin Sign In</a>
                </div>
            </div>

            <div style="text-align: center; margin-top: 18px;">
                <a asp-controller="Home" asp-action="Landing" style="font-size: 13px; color: var(--text-muted); text-decoration: none;">
                    <i class="fa-solid fa-arrow-left"></i> Back to Home Overview
                </a>
            </div>
        </div>
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
