@{
    ViewData["Title"] = "Member Login - HomeLedger";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #0b111e;
            background-image: 
                linear-gradient(rgba(15, 23, 42, 0.85), rgba(11, 17, 30, 0.95)),
                linear-gradient(90deg, rgba(0, 229, 255, 0.1) 1px, transparent 1px),
                linear-gradient(rgba(0, 229, 255, 0.1) 1px, transparent 1px);
            background-size: 100% 100%, 40px 40px, 40px 40px;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #f8fafc;
        }

        .login-container {
            width: 100%;
            max-width: 440px;
        }

        .login-card {
            position: relative;
            background: rgba(19, 29, 45, 0.92);
            backdrop-filter: blur(16px);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 229, 255, 0.15);
            border: 1px solid #1e2d42;
        }

        .login-card::before, .login-card::after {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            pointer-events: none;
        }

        .login-card::before {
            top: 0;
            left: 0;
            border-top: 3px solid #00e5ff;
            border-left: 3px solid #00e5ff;
        }

        .login-card::after {
            bottom: 0;
            right: 0;
            border-bottom: 3px solid #00e5ff;
            border-right: 3px solid #00e5ff;
        }

        .login-header {
            text-align: center;
            margin-bottom: 32px;
        }

        .logo-icon {
            width: 68px;
            height: 68px;
            background: rgba(0, 229, 255, 0.1);
            border: 2px solid #00e5ff;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: #00e5ff;
            font-size: 28px;
            box-shadow: 0 0 20px rgba(0, 229, 255, 0.4);
        }

        .login-header h2 {
            color: #f8fafc;
            font-size: 26px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 8px;
            font-family: 'JetBrains Mono', monospace;
        }

        .login-header p {
            color: #94a3b8;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .alert {
            background: rgba(244, 63, 94, 0.15);
            border: 1px solid #f43f5e;
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 24px;
            color: #fb7185;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #94a3b8;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .input-icon-wrapper {
            position: relative;
        }

        .input-icon-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #00e5ff;
        }

        .input-icon-wrapper input {
            width: 100%;
            padding: 13px 14px 13px 44px;
            border: 1px solid #1e2d42;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.3s;
            background: #0f1826;
            color: #f8fafc;
        }

        .input-icon-wrapper input:focus {
            outline: none;
            border-color: #00e5ff;
            box-shadow: 0 0 16px rgba(0, 229, 255, 0.3);
        }

        .btn {
            width: 100%;
            padding: 14px;
            border: 1px solid #00e5ff;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-primary {
            background: rgba(0, 229, 255, 0.15);
            color: #00e5ff;
            box-shadow: 0 0 15px rgba(0, 229, 255, 0.2);
        }

        .btn-primary:hover {
            background: #00e5ff;
            color: #0b111e;
            box-shadow: 0 0 25px rgba(0, 229, 255, 0.7);
            transform: translateY(-2px);
        }

        .btn-block {
            display: block;
        }

        .login-link {
            text-align: center;
            margin-top: 24px;
            color: #94a3b8;
            font-size: 13px;
        }

        .login-link a {
            color: #00e5ff;
            text-decoration: none;
            font-weight: 600;
        }

        .login-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="logo-icon">
                    <i class="fa-solid fa-user"></i>
                </div>
                <h2>Member Login</h2>
                <p>Access your family account</p>
            </div>
            
            @if (TempData["Error"] != null)
            {
                <div class="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @TempData["Error"]
                </div>
            }

            <form asp-action="MemberLogin" method="post" class="login-form">
                <div class="form-group">
                    <label for="family_id">Family ID</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-users"></i>
                        <input type="text" id="family_id" name="familyId" placeholder="Enter Family ID" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="member_name">Member Name</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" id="member_name" name="memberName" placeholder="Enter your name" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" id="password" name="password" placeholder="Enter password" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    Login <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="login-link">
                <a asp-action="Dashboard" asp-controller="Home">Back to Dashboard</a>
            </div>
        </div>
    </div>
</body>
</html>
