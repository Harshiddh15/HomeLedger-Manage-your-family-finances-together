@{
    ViewData["Title"] = "Sign In — HomeLedger";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    
    <!-- Google Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
            background-color: var(--bg-base);
            background-image: 
                radial-gradient(circle at 50% 20%, rgba(16, 185, 129, 0.12), transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(99, 102, 241, 0.1), transparent 50%);
        }

        .auth-wrapper {
            width: 100%;
            max-width: 460px;
            animation: fadeInUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .auth-card {
            background: rgba(18, 26, 42, 0.88);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-xl);
            padding: 40px 36px;
            box-shadow: 0 24px 60px -10px rgba(0, 0, 0, 0.7);
        }

        .tab-switcher {
            display: flex;
            background: rgba(12, 18, 30, 0.8);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-full);
            padding: 4px;
            margin-bottom: 28px;
            position: relative;
        }

        .tab-btn {
            flex: 1;
            padding: 10px 14px;
            border-radius: var(--radius-full);
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all var(--transition-fast);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
        }

        .tab-btn.member-active {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
        }

        .input-group-custom {
            position: relative;
        }

        .input-group-custom .toggle-eye {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 14px;
            padding: 4px;
            transition: color var(--transition-fast);
        }

        .input-group-custom .toggle-eye:hover {
            color: var(--text-primary);
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <!-- Brand Header -->
        <div style="text-align: center; margin-bottom: 28px;">
            <a href="/" style="display: inline-flex; align-items: center; gap: 12px; margin-bottom: 12px; text-decoration: none;">
                <div class="brand-icon-box" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="fa-solid fa-vault"></i>
                </div>
                <div style="text-align: left;">
                    <span style="font-size: 22px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em;">
                        Home<span style="color: var(--emerald-400);">Ledger</span>
                    </span>
                    <small style="display: block; font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.8px;">
                        Family Wealth OS
                    </small>
                </div>
            </a>
            <h2 style="font-size: 22px; font-weight: 800; margin-bottom: 6px;">Sign In to Your Workspace</h2>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Select your account type to proceed</p>
        </div>

        <div class="auth-card">
            <!-- Flash Alert Messages -->
            @if (TempData["Error"] != null)
            {
                <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; color: #fb7185; font-size: 13px; display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-circle-exclamation" style="font-size: 16px;"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; color: #34d399; font-size: 13px; display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-circle-check" style="font-size: 16px;"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }

            <!-- Dual Tab Switcher -->
            <div class="tab-switcher">
                <button type="button" class="tab-btn active" id="tabAdmin" onclick="setLoginMode('admin')">
                    <i class="fa-solid fa-crown" style="font-size: 12px;"></i>
                    <span>Family Head (Admin)</span>
                </button>
                <button type="button" class="tab-btn" id="tabMember" onclick="setLoginMode('member')">
                    <i class="fa-solid fa-user-check" style="font-size: 12px;"></i>
                    <span>Family Member</span>
                </button>
            </div>

            <!-- 1. ADMIN LOGIN FORM -->
            <form id="adminForm" asp-action="Login" method="post" autocomplete="on">
                <div class="form-group">
                    <label class="form-label" for="adminFamilyId">Family ID *</label>
                    <input type="text" id="adminFamilyId" name="familyId" class="form-control" placeholder="e.g. Patel's Family" required autofocus />
                </div>

                <div class="form-group">
                    <label class="form-label" for="adminPassword">Admin Password *</label>
                    <div class="input-group-custom">
                        <input type="password" id="adminPassword" name="password" class="form-control" placeholder="Enter family admin password" required />
                        <button type="button" class="toggle-eye" onclick="togglePassword('adminPassword', 'eyeAdmin')">
                            <i class="fa-solid fa-eye" id="eyeAdmin"></i>
                        </button>
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
                    <a asp-action="ForgotPassword" style="font-size: 12.5px; color: var(--emerald-400); font-weight: 600;">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 13px; font-size: 15px;">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    <span>Sign In as Family Head</span>
                </button>
            </form>

            <!-- 2. MEMBER LOGIN FORM (ISOLATED) -->
            <form id="memberForm" asp-action="MemberLogin" method="post" autocomplete="on" style="display: none;">
                <div class="form-group">
                    <label class="form-label" for="memberFamilyId">Family ID *</label>
                    <input type="text" id="memberFamilyId" name="familyId" class="form-control" placeholder="e.g. Patel's Family" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="memberNameInput">Your Member Name *</label>
                    <input type="text" id="memberNameInput" name="memberName" class="form-control" placeholder="e.g. Mother, Son, Rohan" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="memberPassword">Member Password *</label>
                    <div class="input-group-custom">
                        <input type="password" id="memberPassword" name="password" class="form-control" placeholder="Enter your member password (e.g. 123)" required />
                        <button type="button" class="toggle-eye" onclick="togglePassword('memberPassword', 'eyeMember')">
                            <i class="fa-solid fa-eye" id="eyeMember"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-indigo" style="width: 100%; padding: 13px; font-size: 15px; margin-top: 10px;">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Access Member Portal</span>
                </button>
            </form>

            <!-- Quick Evaluation Helper Badge -->
            <div style="margin-top: 24px; padding: 12px 14px; background: rgba(255, 255, 255, 0.03); border: 1px dashed var(--border-subtle); border-radius: var(--radius-md); font-size: 12px; color: var(--text-dim); line-height: 1.5;">
                <span style="color: var(--emerald-400); font-weight: 700; display: block; margin-bottom: 2px;">
                    <i class="fa-solid fa-lightbulb"></i> Quick Test Credentials:
                </span>
                <span><strong>Admin:</strong> <code>Patel's Family</code> / <code>123</code></span> &bull; 
                <span><strong>Member:</strong> <code>Mother</code> / <code>123</code></span>
            </div>

            <!-- Footer Links Inside Card -->
            <div style="margin-top: 24px; text-align: center; border-top: 1px solid var(--border-subtle); padding-top: 18px; font-size: 13px; color: var(--text-muted);">
                Don't have a family workspace yet?
                <a asp-action="Register" style="color: var(--emerald-400); font-weight: 700; margin-left: 4px;">Register Free</a>
            </div>
        </div>

        <div style="text-align: center; margin-top: 20px;">
            <a href="/" style="font-size: 13px; color: var(--text-dim); text-decoration: none; transition: color 0.2s;">
                <i class="fa-solid fa-arrow-left"></i> Back to Home Overview
            </a>
        </div>
    </div>

    <!-- Interactive Tab Script -->
    <script>
        function setLoginMode(mode) {
            const adminTab = document.getElementById('tabAdmin');
            const memberTab = document.getElementById('tabMember');
            const adminForm = document.getElementById('adminForm');
            const memberForm = document.getElementById('memberForm');

            if (mode === 'admin') {
                adminTab.className = 'tab-btn active';
                memberTab.className = 'tab-btn';
                adminForm.style.display = 'block';
                memberForm.style.display = 'none';
            } else {
                adminTab.className = 'tab-btn';
                memberTab.className = 'tab-btn member-active';
                adminForm.style.display = 'none';
                memberForm.style.display = 'block';
            }
        }

        // Auto-select tab if URL has ?tab=member
        const params = new URLSearchParams(window.location.search);
        if (params.get('tab') === 'member') {
            setLoginMode('member');
        }

        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-solid fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-solid fa-eye';
            }
        }
    </script>
</body>
</html>
