@model RecurringExpense
@{
    ViewData["Title"] = "Delete Recurring Expense";
    Layout = "_Layout";
}

<style>
    .page-header {
        margin-bottom: 30px;
        text-align: center;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #333;
    }

    .card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        max-width: 600px;
        width: 100%;
        margin: 0 auto;
    }

    .card-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 20px 25px;
    }

    .card-header h3 {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
    }

    .card-body {
        padding: 30px 25px;
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-danger {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(240, 147, 251, 0.3);
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Delete Recurring Expense</h1>
</div>

<div class="card">
    <div class="card-header">
        <h3>Confirm Deletion</h3>
    </div>
    <div class="card-body">
        <p>Are you sure you want to delete this recurring expense?</p>
        <p><strong>Member:</strong> @Model.MemberName</p>
        <p><strong>Category:</strong> @Model.Category</p>
        <p><strong>Amount:</strong> ₹@Model.Amount.ToString("N2")</p>
        <p><strong>Frequency:</strong> @Model.Frequency</p>
        <p><strong>Day:</strong> @Model.DayOfMonth</p>
        
        <form asp-action="Delete" method="post" style="margin-top: 20px;">
            <input type="hidden" name="Id" value="@Model.Id">
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
