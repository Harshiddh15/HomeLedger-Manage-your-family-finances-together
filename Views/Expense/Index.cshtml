@model List<Expense>
@{
    var isMember = Context.Session.GetString("LoginType") == "Member";
    var memberName = Context.Session.GetString("MemberName");
    ViewData["Title"] = isMember ? "My Expenses" : "Expense Management";
    Layout = "_Layout";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px;">
    <h1 class="page-title" style="font-size: 24px; font-weight: 800; color: var(--hud-text-white); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 1px;">
        <span style="color: var(--hud-cyan); margin-right: 8px;">//</span> @(isMember ? $"My Expense Records ({memberName})" : "Expense Management")
    </h1>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        @if (isMember)
        {
            <a asp-controller="Home" asp-action="MemberDashboard" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Member Dashboard
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add Expense
            </a>
        }
        else
        {
            <a asp-action="ExportToCsv" class="btn btn-secondary">
                <i class="fa-solid fa-file-csv"></i> Export CSV
            </a>
            <a asp-action="ExportToPdf" class="btn btn-secondary">
                <i class="fa-solid fa-file-pdf"></i> Export PDF
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add Expense
            </a>
        }
    </div>
</div>

<div class="card" style="margin-bottom: 20px;">
    <div class="card-body">
        <form asp-action="Index" method="get" style="display: flex; gap: 10px;">
            <input type="text" name="search" class="form-control" placeholder="Search by category, member, or description..." value="@Context.Request.Query["search"]" style="flex: 1;">
            <button type="submit" class="btn btn-secondary">
                <i class="fa-solid fa-search"></i> Search
            </button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700;">
            <i class="fa-solid fa-arrow-trend-down" style="color: #ef4444; margin-right: 8px;"></i>
            @(isMember ? $"My Recorded Expenses ({Model.Count})" : $"All Family Expense Records ({Model.Count})")
        </h3>
    </div>
    <div class="table-responsive">
        @if (Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Member Name</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Description</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model)
                    {
                        <tr>
                            <td>@expense.Date.ToString("d MMM yyyy")</td>
                            <td>
                                <span class="badge" style="background: rgba(0, 229, 255, 0.1); color: var(--hud-cyan); border: 1px solid rgba(0, 229, 255, 0.3);">
                                    @expense.MemberName
                                </span>
                            </td>
                            <td>@expense.Category</td>
                            <td style="font-weight: 700; color: #ef4444; font-family: 'JetBrains Mono', monospace;">₹@expense.Amount.ToString("N2")</td>
                            <td>@(expense.Description ?? "-")</td>
                            <td style="text-align: right;">
                                @if (isMember)
                                {
                                    <span style="font-size: 11px; color: var(--hud-text-muted); padding: 4px 8px; background: rgba(255, 255, 255, 0.05); border-radius: 4px;">
                                        <i class="fa-solid fa-lock" style="font-size: 9px;"></i> View Only
                                    </span>
                                }
                                else
                                {
                                    <div class="action-buttons" style="display: inline-flex; gap: 6px;">
                                        <a asp-action="Edit" asp-route-id="@expense.Id" class="btn btn-sm btn-success">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@expense.Id" class="btn btn-sm btn-danger">Delete</a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state" style="text-align: center; padding: 40px; color: var(--hud-text-muted);">
                <i class="fa-solid fa-receipt" style="font-size: 32px; opacity: 0.5; margin-bottom: 12px; display: block;"></i>
                <p>No expense records found.</p>
            </div>
        }
    </div>
</div>
