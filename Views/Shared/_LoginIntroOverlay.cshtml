@* Dedicated Login Security Vault Unlock Intro Animation (Distinct from Home [HomeLedger] Animation — 1.35s) *@
@{
    var hasFlash = TempData["Error"] != null || TempData["Success"] != null;
}
<script>
    if (localStorage.getItem('homeledger_theme') === 'light') { document.body.classList.add('light-mode'); }
</script>

@if (!hasFlash)
{
    <style>
        .login-vault-curtain {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at 50% 45%, rgba(99, 102, 241, 0.22) 0%, rgba(16, 22, 38, 0.98) 65%),
                linear-gradient(90deg, rgba(99, 102, 241, 0.04) 1px, transparent 1px),
                linear-gradient(rgba(99, 102, 241, 0.04) 1px, transparent 1px);
            background-size: 100% 100%, 36px 36px, 36px 36px;
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            cursor: pointer;
            user-select: none;
        }

        body.light-mode .login-vault-curtain {
            background:
                radial-gradient(circle at 50% 45%, rgba(99, 102, 241, 0.14) 0%, rgba(235, 241, 248, 0.98) 65%),
                linear-gradient(90deg, rgba(99, 102, 241, 0.06) 1px, transparent 1px),
                linear-gradient(rgba(99, 102, 241, 0.06) 1px, transparent 1px);
            background-size: 100% 100%, 36px 36px, 36px 36px;
        }

        .login-vault-curtain.is-playing {
            animation: loginCurtainIris 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.90s forwards;
        }

        .login-vault-stage {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 18px;
        }

        .vault-orbital-wrap {
            position: relative;
            width: 96px;
            height: 96px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .vault-ring-outer {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px dashed rgba(129, 140, 248, 0.55);
            opacity: 0;
            animation: vaultRingSpin 0.95s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .vault-ring-inner {
            position: absolute;
            inset: 9px;
            border-radius: 50%;
            border: 2px solid transparent;
            border-top-color: #38bdf8;
            border-right-color: #818cf8;
            opacity: 0;
            animation: vaultRingCounterSpin 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
        }

        .vault-shield-core {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.28), rgba(56, 189, 248, 0.22));
            border: 1px solid rgba(129, 140, 248, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 28px rgba(99, 102, 241, 0.35);
            opacity: 0;
            transform: scale(0.7);
            animation: vaultCorePop 0.48s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s forwards;
        }

        .vault-scan-beam {
            position: absolute;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #38bdf8, #ffffff, #38bdf8, transparent);
            box-shadow: 0 0 12px #38bdf8;
            top: -10%;
            animation: vaultLaserScan 0.68s ease-in-out 0.18s forwards;
        }

        .vault-lock-icon {
            font-size: 23px;
            color: #a5b4fc;
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .vault-lock-icon.is-unlocked {
            color: #34d399;
            transform: scale(1.1);
        }

        .login-title-reveal {
            font-family: var(--font-display, 'Plus Jakarta Sans', sans-serif);
            font-size: clamp(22px, 3.6vw, 30px);
            font-weight: 800;
            text-transform: uppercase;
            color: var(--text-primary, #f8fafc);
            opacity: 0;
            letter-spacing: 0.4em;
            animation: loginTitleCondense 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.16s forwards;
        }

        .login-title-reveal span {
            color: #818cf8;
        }

        .login-sub-reveal {
            font-family: var(--font-mono, 'JetBrains Mono', monospace);
            font-size: 12px;
            color: #38bdf8;
            letter-spacing: 0.08em;
            opacity: 0;
            transform: translateY(8px);
            animation: loginSubFade 0.45s ease 0.38s forwards;
        }

        .vault-auth-bar {
            width: 190px;
            height: 4px;
            border-radius: 999px;
            background: rgba(148, 163, 184, 0.18);
            overflow: hidden;
        }

        .vault-auth-fill {
            width: 0%;
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg, #6366f1, #38bdf8, #10b981);
            animation: vaultBarFill 0.78s cubic-bezier(0.16, 1, 0.3, 1) 0.12s forwards;
        }

        @@keyframes vaultRingSpin {
            0% { opacity: 0; transform: scale(0.75) rotate(-90deg); }
            30% { opacity: 1; }
            100% { opacity: 1; transform: scale(1) rotate(90deg); }
        }

        @@keyframes vaultRingCounterSpin {
            0% { opacity: 0; transform: rotate(120deg); }
            30% { opacity: 1; }
            100% { opacity: 1; transform: rotate(-60deg); }
        }

        @@keyframes vaultCorePop {
            from { opacity: 0; transform: scale(0.7); }
            to { opacity: 1; transform: scale(1); }
        }

        @@keyframes vaultLaserScan {
            0% { top: -15%; opacity: 0; }
            20% { opacity: 1; }
            80% { opacity: 1; }
            100% { top: 115%; opacity: 0; }
        }

        @@keyframes loginTitleCondense {
            0% { opacity: 0; letter-spacing: 0.42em; transform: translateY(10px); }
            100% { opacity: 1; letter-spacing: 0.14em; transform: translateY(0); }
        }

        @@keyframes loginSubFade {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes vaultBarFill {
            from { width: 0%; }
            to { width: 100%; }
        }

        @@keyframes loginCurtainIris {
            0% { opacity: 1; transform: scale(1) translateY(0); pointer-events: auto; }
            15% { pointer-events: none; }
            100% { opacity: 0; transform: scale(0.96) translateY(-12px); visibility: hidden; pointer-events: none; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .login-vault-curtain { display: none !important; }
        }
    </style>

    <div id="hlLoginIntroOverlay" class="login-vault-curtain is-playing" aria-hidden="true">
        <div class="login-vault-stage">
            <div class="vault-orbital-wrap">
                <div class="vault-ring-outer"></div>
                <div class="vault-ring-inner"></div>
                <div class="vault-shield-core">
                    <div class="vault-scan-beam"></div>
                    <i id="vaultLockGlyph" class="fa-solid fa-lock vault-lock-icon"></i>
                </div>
            </div>
            <div>
                <div class="login-title-reveal">Secure <span>Login</span></div>
                <div class="login-sub-reveal" id="loginStatusText">INITIALIZING ACCESS PORTAL...</div>
            </div>
            <div class="vault-auth-bar">
                <div class="vault-auth-fill"></div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var overlay = document.getElementById('hlLoginIntroOverlay');
            var glyph = document.getElementById('vaultLockGlyph');
            var statusEl = document.getElementById('loginStatusText');
            if (!overlay) return;

            function startUnlockSequence() {
                if (glyph) {
                    glyph.className = 'fa-solid fa-lock vault-lock-icon';
                }
                if (statusEl) {
                    statusEl.textContent = 'INITIALIZING ACCESS PORTAL...';
                }
                setTimeout(function () {
                    if (glyph) {
                        glyph.className = 'fa-solid fa-unlock-keyhole vault-lock-icon is-unlocked';
                    }
                    if (statusEl) {
                        statusEl.textContent = 'PORTAL READY — VERIFY IDENTITY';
                    }
                }, 560);
                setTimeout(function () {
                    overlay.style.pointerEvents = 'none';
                }, 900);
                setTimeout(dismissLoginIntro, 1380);
            }

            function dismissLoginIntro() {
                overlay.style.display = 'none';
                overlay.classList.remove('is-playing');
            }

            startUnlockSequence();
            overlay.addEventListener('click', dismissLoginIntro, { once: true });
            document.addEventListener('keydown', function (ev) {
                if (ev.key === 'Escape') dismissLoginIntro();
            }, { once: true });

            window.replayLoginVaultIntro = function () {
                overlay.style.display = 'flex';
                overlay.style.pointerEvents = 'auto';
                overlay.classList.remove('is-playing');
                void overlay.offsetWidth;
                overlay.classList.add('is-playing');
                startUnlockSequence();
            };
        })();
    </script>
}
else
{
    <script>
        window.replayLoginVaultIntro = function () { window.location.href = window.location.pathname + window.location.search; };
    </script>
}
