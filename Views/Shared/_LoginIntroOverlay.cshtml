@* Trending 2.0s Live Warp-Grid Canvas + SVG Passkey Biometric Draw Login Intro (100% Distinct from Home) *@
@{
    var hasFlash = TempData["Error"] != null || TempData["Success"] != null;
}
<script>
    if (localStorage.getItem('homeledger_theme') === 'light') { document.body.classList.add('light-mode'); }
</script>

@if (!hasFlash)
{
    <style>
        .login-vault-curtain {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at 50% 45%, #191f3a 0%, #0d111e 75%);
            cursor: pointer;
            user-select: none;
            overflow: hidden;
        }

        body.light-mode .login-vault-curtain {
            background: radial-gradient(circle at 50% 45%, #f1f5f9 0%, #dbe4f0 75%);
        }

        .login-vault-curtain.is-playing {
            animation: loginIrisDissolve 0.54s cubic-bezier(0.76, 0, 0.24, 1) 1.46s forwards;
        }

        #hlLoginIntroCanvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .login-vault-stage {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 18px;
        }

        .login-vault-curtain.is-playing .login-vault-stage {
            animation: loginStageWarpOut 0.44s cubic-bezier(0.16, 1, 0.3, 1) 1.42s forwards;
        }

        .biometric-scanner-box {
            position: relative;
            width: 112px;
            height: 112px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(99, 102, 241, 0.12);
            border: 1.5px solid rgba(129, 140, 248, 0.45);
            box-shadow: 0 0 42px rgba(99, 102, 241, 0.38), inset 0 0 24px rgba(56, 189, 248, 0.16);
            overflow: hidden;
            opacity: 0;
            transform: scale(0.7);
            animation: bioBoxPop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.05s forwards;
        }

        .bio-laser-line {
            position: absolute;
            left: 6px;
            right: 6px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #38bdf8, #ffffff, #38bdf8, transparent);
            box-shadow: 0 0 14px #38bdf8;
            top: -10%;
            animation: bioLaserSweep 0.95s ease-in-out 0.18s forwards;
        }

        .bio-svg-path {
            stroke-dasharray: 220;
            stroke-dashoffset: 220;
            animation: bioStrokeDraw 0.92s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
            transition: stroke 0.25s ease;
        }

        .biometric-scanner-box.verified {
            border-color: rgba(52, 211, 153, 0.78);
            background: rgba(16, 185, 129, 0.16);
            box-shadow: 0 0 48px rgba(16, 185, 129, 0.55);
            transform: scale(1.06);
            transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .biometric-scanner-box.verified .bio-svg-path {
            stroke: #34d399 !important;
        }

        .bio-pulse-ring {
            position: absolute;
            width: 112px;
            height: 112px;
            border-radius: 50%;
            border: 2px solid #34d399;
            opacity: 0;
            pointer-events: none;
            animation: bioBurstRing 0.65s cubic-bezier(0.16, 1, 0.3, 1) 1.04s forwards;
        }

        .login-title-reveal {
            font-family: var(--font-display, 'Plus Jakarta Sans', sans-serif);
            font-size: clamp(24px, 3.8vw, 34px);
            font-weight: 800;
            text-transform: uppercase;
            color: var(--text-primary, #f8fafc);
            opacity: 0;
            letter-spacing: 0.42em;
            animation: loginTitleFocus 0.78s cubic-bezier(0.16, 1, 0.3, 1) 0.18s forwards;
        }

        .login-title-reveal span {
            background: linear-gradient(135deg, #818cf8 0%, #38bdf8 60%, #34d399 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .login-sub-reveal {
            font-family: var(--font-mono, 'JetBrains Mono', monospace);
            font-size: 12px;
            color: #38bdf8;
            letter-spacing: 0.1em;
            opacity: 0;
            transform: translateY(8px);
            animation: loginSubIn 0.45s ease 0.38s forwards;
        }

        .vault-auth-bar {
            width: 230px;
            height: 4px;
            border-radius: 999px;
            background: rgba(148, 163, 184, 0.18);
            overflow: hidden;
        }

        .vault-auth-fill {
            width: 0%;
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg, #6366f1, #38bdf8, #10b981);
            box-shadow: 0 0 14px rgba(56, 189, 248, 0.7);
            animation: vaultBarGo 1.25s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
        }

        @@keyframes bioBoxPop { to { opacity: 1; transform: scale(1); } }
        @@keyframes bioStrokeDraw { to { stroke-dashoffset: 0; } }
        @@keyframes bioBurstRing {
            0% { opacity: 0.9; transform: scale(1); }
            100% { opacity: 0; transform: scale(1.85); }
        }
        @@keyframes bioLaserSweep {
            0% { top: -10%; opacity: 0; }
            20% { opacity: 1; }
            55% { top: 105%; opacity: 1; }
            100% { top: -10%; opacity: 0; }
        }
        @@keyframes loginTitleFocus {
            from { opacity: 0; letter-spacing: 0.44em; filter: blur(6px); transform: translateY(10px); }
            to { opacity: 1; letter-spacing: 0.14em; filter: blur(0px); transform: translateY(0); }
        }
        @@keyframes loginSubIn { to { opacity: 1; transform: translateY(0); } }
        @@keyframes vaultBarGo { to { width: 100%; } }
        @@keyframes loginStageWarpOut {
            to { opacity: 0; transform: scale(1.12); filter: blur(8px); }
        }
        @@keyframes loginIrisDissolve {
            0% { opacity: 1; pointer-events: auto; }
            15% { pointer-events: none; }
            100% { opacity: 0; visibility: hidden; pointer-events: none; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .login-vault-curtain { display: none !important; }
        }
    </style>

    <div id="hlLoginIntroOverlay" class="login-vault-curtain is-playing" aria-hidden="true">
        <canvas id="hlLoginIntroCanvas"></canvas>

        <div class="login-vault-stage">
            <div style="position: relative; display: flex; align-items: center; justify-content: center;">
                <div class="bio-pulse-ring"></div>
                <div class="biometric-scanner-box" id="bioScannerBox">
                    <div class="bio-laser-line"></div>
                    <!-- Live Stroke-Drawn Biometric Passkey Shield SVG -->
                    <svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path class="bio-svg-path" d="M32 6L10 15V31C10 44.5 19.4 56.8 32 60C44.6 56.8 54 44.5 54 31V15L32 6Z" stroke="#818cf8" stroke-width="2.6" stroke-linejoin="round" />
                        <circle class="bio-svg-path" cx="32" cy="29" r="7" stroke="#38bdf8" stroke-width="2.5" />
                        <path class="bio-svg-path" d="M23 45C23 40 27 37 32 37C37 37 41 40 41 45" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
                    </svg>
                </div>
            </div>

            <div>
                <div class="login-title-reveal">Portal <span>Login</span></div>
                <div class="login-sub-reveal" id="loginStatusText">AUTHENTICATING ACCESS GATE...</div>
            </div>

            <div class="vault-auth-bar">
                <div class="vault-auth-fill"></div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var overlay = document.getElementById('hlLoginIntroOverlay');
            var canvas = document.getElementById('hlLoginIntroCanvas');
            var bioBox = document.getElementById('bioScannerBox');
            var statusEl = document.getElementById('loginStatusText');
            if (!overlay) return;

            var t1 = null, t2 = null, t3 = null, rafId = null;

            function startWarpGridCanvas() {
                if (!canvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                var ctx = canvas.getContext('2d');
                var w = canvas.width = window.innerWidth;
                var h = canvas.height = window.innerHeight;
                var cx = w / 2, cy = h / 2;
                var startTs = performance.now();

                var rays = [];
                for (var i = 0; i < 48; i++) {
                    rays.push({
                        angle: (Math.PI * 2 * i) / 48 + Math.random() * 0.1,
                        dist: Math.random() * 260,
                        speed: 4.5 + Math.random() * 6.5,
                        len: 18 + Math.random() * 44,
                        color: i % 3 === 0 ? '#38bdf8' : (i % 3 === 1 ? '#818cf8' : '#34d399')
                    });
                }

                function drawFrame(now) {
                    var elapsed = now - startTs;
                    ctx.clearRect(0, 0, w, h);
                    var maxR = Math.max(w, h) * 0.75;

                    for (var i = 0; i < rays.length; i++) {
                        var r = rays[i];
                        r.dist += r.speed * (1 + elapsed / 900);
                        if (r.dist > maxR) r.dist = 30 + Math.random() * 50;

                        var x1 = cx + Math.cos(r.angle) * r.dist;
                        var y1 = cy + Math.sin(r.angle) * r.dist;
                        var x2 = cx + Math.cos(r.angle) * (r.dist + r.len);
                        var y2 = cy + Math.sin(r.angle) * (r.dist + r.len);

                        ctx.beginPath();
                        ctx.moveTo(x1, y1);
                        ctx.lineTo(x2, y2);
                        ctx.strokeStyle = r.color;
                        ctx.globalAlpha = Math.min(0.65, r.dist / 220) * (elapsed > 1450 ? Math.max(0, 1 - (elapsed - 1450) / 500) : 1);
                        ctx.lineWidth = 1.8;
                        ctx.lineCap = 'round';
                        ctx.stroke();
                    }
                    ctx.globalAlpha = 1;

                    if (elapsed < 2050) {
                        rafId = requestAnimationFrame(drawFrame);
                    }
                }
                rafId = requestAnimationFrame(drawFrame);
            }

            function dismissLoginIntro() {
                clearTimeout(t1); clearTimeout(t2); clearTimeout(t3);
                cancelAnimationFrame(rafId);
                overlay.style.display = 'none';
                overlay.classList.remove('is-playing');
            }

            startWarpGridCanvas();
            t1 = setTimeout(function () {
                if (bioBox) bioBox.classList.add('verified');
                if (statusEl) {
                    statusEl.textContent = 'ACCESS VERIFIED — READY';
                    statusEl.style.color = '#34d399';
                }
            }, 1020);
            t2 = setTimeout(function () { overlay.style.pointerEvents = 'none'; }, 1460);
            t3 = setTimeout(dismissLoginIntro, 2020);

            overlay.addEventListener('click', dismissLoginIntro, { once: true });
            document.addEventListener('keydown', function (ev) {
                if (ev.key === 'Escape') dismissLoginIntro();
            }, { once: true });
        })();
    </script>
}
