@* Pure [HomeLedger] Trending 2.0s Live Canvas Vortex + SVG Stroke-Draw + Glass Glare Reveal (Home Page Only) *@
@{
    var alwaysShow = (ViewData["AlwaysShowHomeIntro"] as bool?) ?? false;
    var brandChars = new[] {
        new { Char = "H", Accent = false },
        new { Char = "o", Accent = false },
        new { Char = "m", Accent = false },
        new { Char = "e", Accent = false },
        new { Char = "L", Accent = true },
        new { Char = "e", Accent = true },
        new { Char = "d", Accent = true },
        new { Char = "g", Accent = true },
        new { Char = "e", Accent = true },
        new { Char = "r", Accent = true }
    };
}

<style>
    .hl-brand-curtain {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 50% 48%, #152238 0%, #0d1320 75%);
        cursor: pointer;
        user-select: none;
        overflow: hidden;
        pointer-events: none;
    }

    body.light-mode .hl-brand-curtain {
        background: radial-gradient(circle at 50% 48%, #f8fafc 0%, #e2e8f0 75%);
    }

    .hl-brand-curtain.is-playing {
        display: flex;
        pointer-events: auto;
        animation: hlPortalWipeOut 0.56s cubic-bezier(0.76, 0, 0.24, 1) 1.46s forwards;
    }

    #hlHomeIntroCanvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .hl-brand-stage {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        perspective: 1000px;
    }

    .hl-brand-curtain.is-playing .hl-brand-stage {
        animation: hlStageZoomExit 0.44s cubic-bezier(0.16, 1, 0.3, 1) 1.42s forwards;
    }

    .hl-brand-lockup {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        padding: 14px 26px;
        border-radius: 26px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(52, 211, 153, 0.22);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.12);
        overflow: hidden;
        opacity: 0;
        transform: scale(0.86) rotateX(14deg);
    }

    body.light-mode .hl-brand-lockup {
        background: rgba(255, 255, 255, 0.72);
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }

    .hl-brand-curtain.is-playing .hl-brand-lockup {
        animation: hlCapsuleSnap 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) 0.05s forwards;
    }

    /* Specular Metallic Glass Glare Sweep */
    .hl-brand-lockup::after {
        content: '';
        position: absolute;
        top: -20%;
        left: -60%;
        width: 38%;
        height: 150%;
        background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.28), transparent);
        transform: skewX(-22deg);
        pointer-events: none;
    }

    .hl-brand-curtain.is-playing .hl-brand-lockup::after {
        animation: hlSpecularSweep 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.68s forwards;
    }

    /* SVG Live Stroke-Draw Vault Badge */
    .hl-svg-badge {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.22), rgba(56, 189, 248, 0.16));
        border: 1.5px solid rgba(52, 211, 153, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 28px rgba(16, 185, 129, 0.35);
    }

    .hl-svg-path {
        stroke-dasharray: 180;
        stroke-dashoffset: 180;
    }

    .hl-brand-curtain.is-playing .hl-svg-path {
        animation: hlSvgDraw 0.82s cubic-bezier(0.22, 1, 0.36, 1) 0.12s forwards;
    }

    .hl-wordmark-row {
        display: inline-flex;
        align-items: baseline;
        overflow: hidden;
        padding: 4px 2px;
        font-family: var(--font-display, 'Plus Jakarta Sans', sans-serif);
        font-size: clamp(32px, 5.2vw, 50px);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.08;
    }

    .hl-char {
        display: inline-block;
        color: var(--text-primary, #f8fafc);
        opacity: 0;
        filter: blur(8px);
        transform: translateY(105%) rotateX(35deg);
        will-change: transform, opacity, filter;
    }

    .hl-char.accent {
        background: linear-gradient(135deg, #34d399 0%, #10b981 55%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hl-brand-curtain.is-playing .hl-char {
        animation: hlChar3DIn 0.52s cubic-bezier(0.16, 1, 0.3, 1) var(--char-delay) forwards;
    }

    .hl-photon-track {
        width: clamp(200px, 38vw, 300px);
        height: 3px;
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.18);
        overflow: hidden;
    }

    .hl-photon-fill {
        width: 0%;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #10b981, #38bdf8, #818cf8);
        box-shadow: 0 0 16px rgba(52, 211, 153, 0.9);
    }

    .hl-brand-curtain.is-playing .hl-photon-fill {
        animation: hlLineFill 1.15s cubic-bezier(0.22, 1, 0.36, 1) 0.25s forwards;
    }

    @@keyframes hlCapsuleSnap {
        from { opacity: 0; transform: scale(0.84) rotateX(16deg); }
        to { opacity: 1; transform: scale(1) rotateX(0deg); }
    }

    @@keyframes hlSpecularSweep {
        0% { left: -60%; }
        100% { left: 150%; }
    }

    @@keyframes hlSvgDraw {
        to { stroke-dashoffset: 0; }
    }

    @@keyframes hlChar3DIn {
        to { opacity: 1; filter: blur(0px); transform: translateY(0%) rotateX(0deg); }
    }

    @@keyframes hlLineFill {
        to { width: 100%; }
    }

    @@keyframes hlStageZoomExit {
        to { opacity: 0; transform: scale(1.08); filter: blur(6px); }
    }

    @@keyframes hlPortalWipeOut {
        0% { clip-path: circle(100% at 50% 50%); opacity: 1; pointer-events: auto; }
        15% { pointer-events: none; }
        100% { clip-path: circle(0% at 50% 50%); opacity: 0; visibility: hidden; pointer-events: none; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .hl-brand-curtain.is-playing { display: none !important; }
    }
</style>

<script>
    if (localStorage.getItem('homeledger_theme') === 'light') { document.body.classList.add('light-mode'); }
</script>

<div id="hlHomeIntroOverlay" class="hl-brand-curtain @(alwaysShow ? "is-playing" : "")" aria-hidden="true">
    <canvas id="hlHomeIntroCanvas"></canvas>

    <div class="hl-brand-stage">
        <div class="hl-brand-lockup">
            <div class="hl-svg-badge">
                <svg width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect class="hl-svg-path" x="4" y="6" width="28" height="24" rx="6" stroke="#34d399" stroke-width="2.4" />
                    <circle class="hl-svg-path" cx="18" cy="18" r="5.5" stroke="#38bdf8" stroke-width="2.2" />
                    <path class="hl-svg-path" d="M18 12.5V15.5M18 20.5V23.5M12.5 18H15.5M20.5 18H23.5" stroke="#a7f3d0" stroke-width="2" stroke-linecap="round" />
                </svg>
            </div>
            <div class="hl-wordmark-row" aria-label="HomeLedger">
                @for (int i = 0; i < brandChars.Length; i++)
                {
                    var item = brandChars[i];
                    var delayMs = 240 + (i * 42);
                    <span class="hl-char @(item.Accent ? "accent" : "")" style="--char-delay: @(delayMs)ms;">@item.Char</span>
                }
            </div>
        </div>
        <div class="hl-photon-track">
            <div class="hl-photon-fill"></div>
        </div>
    </div>
</div>

<script>
    (function () {
        var overlay = document.getElementById('hlHomeIntroOverlay');
        var canvas = document.getElementById('hlHomeIntroCanvas');
        if (!overlay) return;

        var alwaysShow = @(alwaysShow ? "true" : "false");
        var hideTimer1 = null, hideTimer2 = null, rafId = null;

        if (!alwaysShow) {
            try {
                var navEntries = performance.getEntriesByType && performance.getEntriesByType('navigation');
                var navType = (navEntries && navEntries.length > 0) ? navEntries[0].type : '';
                var ref = document.referrer || '';
                var isWorkspaceInternalNav = false;

                if (ref) {
                    var refPath = new URL(ref).pathname.toLowerCase();
                    var workspacePaths = ['/income', '/expense', '/udhar', '/budget', '/category', '/member', '/savingsgoal', '/reminder', '/report', '/backup', '/recurring'];
                    isWorkspaceInternalNav = workspacePaths.some(function (p) { return refPath.indexOf(p) === 0; });
                }

                if (navType === 'reload' || !ref || !isWorkspaceInternalNav) {
                    overlay.classList.add('is-playing');
                }
            } catch (e) {
                overlay.classList.add('is-playing');
            }
        }

        function startLiveVortexCanvas() {
            if (!canvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width = window.innerWidth;
            var h = canvas.height = window.innerHeight;
            var cx = w / 2, cy = h / 2;
            var startTs = performance.now();
            var palette = ['#34d399', '#10b981', '#38bdf8', '#818cf8'];

            var particles = [];
            for (var i = 0; i < 64; i++) {
                var angle = (Math.PI * 2 * i) / 64 + Math.random() * 0.4;
                var radius = Math.max(w, h) * (0.28 + Math.random() * 0.42);
                particles.push({
                    angle: angle,
                    radius: radius,
                    origRadius: radius,
                    speed: 0.025 + Math.random() * 0.03,
                    size: 1.8 + Math.random() * 2.8,
                    color: palette[i % palette.length]
                });
            }

            function drawFrame(now) {
                var elapsed = now - startTs;
                ctx.clearRect(0, 0, w, h);

                var progress = Math.min(elapsed / 1450, 1);
                var burst = elapsed > 1250 ? (elapsed - 1250) / 550 : 0;

                for (var i = 0; i < particles.length; i++) {
                    var p = particles[i];
                    p.angle += p.speed;
                    var targetR = burst > 0
                        ? p.origRadius * (0.1 + burst * 1.45)
                        : p.origRadius * (1 - Math.pow(progress, 1.35) * 0.88);

                    var px = cx + Math.cos(p.angle) * targetR;
                    var py = cy + Math.sin(p.angle) * targetR;
                    var prevX = cx + Math.cos(p.angle - 0.12) * (targetR + 8);
                    var prevY = cy + Math.sin(p.angle - 0.12) * (targetR + 8);

                    ctx.beginPath();
                    ctx.moveTo(prevX, prevY);
                    ctx.lineTo(px, py);
                    ctx.strokeStyle = p.color;
                    ctx.globalAlpha = Math.max(0, 0.72 * (1 - burst * 0.85));
                    ctx.lineWidth = p.size;
                    ctx.lineCap = 'round';
                    ctx.stroke();
                }
                ctx.globalAlpha = 1;

                if (elapsed < 2050) {
                    rafId = requestAnimationFrame(drawFrame);
                }
            }
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(drawFrame);
        }

        function dismissHomeIntro() {
            clearTimeout(hideTimer1);
            clearTimeout(hideTimer2);
            cancelAnimationFrame(rafId);
            overlay.style.display = 'none';
            overlay.classList.remove('is-playing');
        }

        function scheduleHomeDismiss() {
            clearTimeout(hideTimer1);
            clearTimeout(hideTimer2);
            startLiveVortexCanvas();
            hideTimer1 = setTimeout(function () {
                overlay.style.pointerEvents = 'none';
            }, 1460);
            hideTimer2 = setTimeout(dismissHomeIntro, 2020);
        }

        if (overlay.classList.contains('is-playing')) {
            scheduleHomeDismiss();
            overlay.addEventListener('click', dismissHomeIntro, { once: true });
            document.addEventListener('keydown', function (ev) {
                if (ev.key === 'Escape') dismissHomeIntro();
            }, { once: true });
        }
    })();
</script>
