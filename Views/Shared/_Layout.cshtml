<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HUD ADMIN</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 30px 20px;
        }
    </style>
</head>
@{
    var loginType = Context.Session.GetString("LoginType");
    var isAdmin = loginType == "Admin";
}
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <div style="display: flex; align-items: center; gap: 15px;">
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Dashboard" style="white-space: nowrap;">
                    <i class="fa-solid fa-cube"></i> HUD ADMIN
                </a>
            </div>
        </div>
    </nav>

    <div class="main-wrapper">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-content">
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Navigation</h3>
                    <ul class="sidebar-nav">
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Home" asp-action="Dashboard">
                                <i class="fa-solid fa-gauge"></i> Dashboard
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Income" asp-action="Index">
                                <i class="fa-solid fa-arrow-trend-up"></i> Income
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Expense" asp-action="Index">
                                <i class="fa-solid fa-arrow-trend-down"></i> Expenses
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Udhar" asp-action="Index">
                                <i class="fa-solid fa-hand-holding-dollar"></i> Udhar
                            </a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Budget" asp-action="Index">
                                    <i class="fa-solid fa-wallet"></i> Budget
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Reminder" asp-action="Index">
                                    <i class="fa-solid fa-bell"></i> Reminders
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="SavingsGoal" asp-action="Index">
                                    <i class="fa-solid fa-piggy-bank"></i> Savings
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="RecurringExpense" asp-action="Index">
                                    <i class="fa-solid fa-rotate"></i> Recurring Exp
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="RecurringIncome" asp-action="Index">
                                    <i class="fa-solid fa-rotate"></i> Recurring Inc
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Category" asp-action="Index">
                                    <i class="fa-solid fa-tags"></i> Categories
                                </a>
                            </li>
                        }
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Report" asp-action="Index">
                                <i class="fa-solid fa-chart-line"></i> Reports
                            </a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Member" asp-action="Index">
                                    <i class="fa-solid fa-users"></i> Members
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Backup" asp-action="Index">
                                    <i class="fa-solid fa-database"></i> Backup
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="sidebar-section">
                    <h3 class="sidebar-title">Quick Actions</h3>
                    <div class="sidebar-actions">
                        <i class="fa-solid fa-magnifying-glass" style="cursor: pointer;" title="Search" id="searchBtn"></i>
                        <i class="fa-solid fa-border-all" style="cursor: pointer;" title="Widgets" id="widgetsBtn"></i>
                        <i class="fa-solid fa-bell" style="cursor: pointer;" title="Notifications" id="notificationsBtn"></i>
                        <i class="fa-solid fa-circle-half-stroke" id="darkModeToggle" style="cursor: pointer;" title="Toggle Dark Mode"></i>
                    </div>
                </div>

                <div class="sidebar-section sidebar-user">
                    <div class="user-info">
                        <div class="user-avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div class="user-details">
                            <span class="user-name">@Context.Session.GetString("FamilyName")</span>
                        </div>
                        <a class="btn btn-sm btn-danger logout-btn" asp-area="" asp-controller="Account" asp-action="Logout">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="container">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

            <footer class="footer">
                <div class="container">
                    <p>&copy; 2026 - <strong>HUD ADMIN</strong> | Family Finance Control Terminal</p>
                </div>
            </footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Sidebar Toggle & Hover
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        
        // Initialize sidebar as collapsed
        sidebar.classList.add('collapsed');
        
        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
        });

        // Dark Mode Toggle
        const darkModeToggle = document.getElementById('darkModeToggle');
        const body = document.body;
        
        // Check for saved preference (default to dark mode)
        if (localStorage.getItem('lightMode') === 'true') {
            body.classList.add('light-mode');
            darkModeToggle.classList.remove('fa-circle-half-stroke');
            darkModeToggle.classList.add('fa-sun');
        }
        
        darkModeToggle.addEventListener('click', () => {
            body.classList.toggle('light-mode');
            const isLight = body.classList.contains('light-mode');
            localStorage.setItem('lightMode', isLight);
            
            if (isLight) {
                darkModeToggle.classList.remove('fa-circle-half-stroke');
                darkModeToggle.classList.add('fa-sun');
            } else {
                darkModeToggle.classList.remove('fa-sun');
                darkModeToggle.classList.add('fa-circle-half-stroke');
            }
        });

        // Quick Actions Buttons
        const searchBtn = document.getElementById('searchBtn');
        const widgetsBtn = document.getElementById('widgetsBtn');
        const notificationsBtn = document.getElementById('notificationsBtn');

        searchBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            console.log('Search button clicked - Search functionality will be implemented');
            // Visual feedback
            searchBtn.style.color = 'var(--hud-cyan)';
            setTimeout(() => {
                searchBtn.style.color = '';
            }, 500);
        });

        widgetsBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            console.log('Widgets button clicked - Widgets panel will be implemented');
            // Visual feedback
            widgetsBtn.style.color = 'var(--hud-cyan)';
            setTimeout(() => {
                widgetsBtn.style.color = '';
            }, 500);
        });

        notificationsBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            console.log('Notifications button clicked - Notifications panel will be implemented');
            // Visual feedback
            notificationsBtn.style.color = 'var(--hud-cyan)';
            setTimeout(() => {
                notificationsBtn.style.color = '';
            }, 500);
        });
    </script>
</body>
</html>
