<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HomeLedger</title>
    
    <!-- Premium Google Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Master Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var loginType = Context.Session.GetString("LoginType");
    var isAdmin = loginType == "Admin";
    var isMember = loginType == "Member";
    var memberName = Context.Session.GetString("MemberName") ?? "Member";
    var familyName = Context.Session.GetString("FamilyName") ?? "Family";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<body>
    <!-- Top Glassmorphism Navigation Bar -->
    <header class="top-navbar">
        <div class="brand-wrapper">
            <button class="nav-icon-btn d-lg-none" id="sidebarToggle" title="Toggle Navigation Menu">
                <i class="fa-solid fa-bars-staggered"></i>
            </button>
            <a asp-controller="Home" asp-action="@(isAdmin ? "Dashboard" : "MemberDashboard")" class="brand-logo">
                <div class="brand-icon-box">
                    <i class="fa-solid fa-vault"></i>
                </div>
                <div>
                    <span style="letter-spacing: -0.03em;">Home<span style="color: var(--emerald-400);">Ledger</span></span>
                    <small style="display: block; font-size: 10px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.8px; margin-top: -2px;">Family Wealth OS</small>
                </div>
            </a>
        </div>

        <div class="navbar-actions">
            <!-- Active Session Status Badge -->
            @if (isAdmin)
            {
                <div class="badge badge-emerald" style="padding: 6px 14px; font-size: 12px; gap: 8px;">
                    <i class="fa-solid fa-crown" style="font-size: 11px;"></i>
                    <span>@familyName (Admin Head)</span>
                </div>
            }
            else if (isMember)
            {
                <div class="badge badge-indigo" style="padding: 6px 14px; font-size: 12px; gap: 8px;">
                    <i class="fa-solid fa-user-check" style="font-size: 11px;"></i>
                    <span>@memberName (Member)</span>
                    <span style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; padding: 2px 6px; border-radius: 4px; font-size: 10px; margin-left: 4px;">
                        <i class="fa-solid fa-shield-halved"></i> Protected
                    </span>
                </div>
            }

            <!-- Quick Dark / Light Mode Toggle -->
            <button class="nav-icon-btn" id="themeToggle" title="Toggle Theme (Dark / Light)">
                <i class="fa-solid fa-sun"></i>
            </button>

            <!-- Quick Reports Shortcut -->
            <a asp-controller="Report" asp-action="Index" class="nav-icon-btn" title="View Financial Reports">
                <i class="fa-solid fa-chart-line"></i>
            </a>

            <!-- Logout Button -->
            @if (isMember)
            {
                <a asp-controller="Account" asp-action="MemberLogout" class="btn btn-sm btn-danger" style="gap: 6px;" title="Exit Member Session">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="d-none d-sm-inline">Logout</span>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-danger" style="gap: 6px;" title="Sign out of Admin Terminal">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="d-none d-sm-inline">Logout</span>
                </a>
            }
        </div>
    </header>

    <!-- Mobile Drawer Overlay -->
    <div id="sidebarOverlay" style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 998; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;"></div>

    <div class="app-layout-wrapper">
        <!-- Floating App Sidebar -->
        <aside class="app-sidebar" id="appSidebar">
            <div>
                <!-- Primary Navigation -->
                <div class="sidebar-group-title">Core Management</div>
                <ul class="sidebar-menu">
                    <li>
                        @if (isAdmin)
                        {
                            <a asp-controller="Home" asp-action="Dashboard" class="sidebar-link @(currentController == "Home" && currentAction == "Dashboard" ? "active" : "")">
                                <i class="fa-solid fa-grip-vertical"></i>
                                <span>Overview Dashboard</span>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="MemberDashboard" class="sidebar-link @(currentController == "Home" && currentAction == "MemberDashboard" ? "active" : "")">
                                <i class="fa-solid fa-id-badge"></i>
                                <span>Member Portal</span>
                            </a>
                        }
                    </li>
                    <li>
                        <a asp-controller="Income" asp-action="Index" class="sidebar-link @(currentController == "Income" ? "active" : "")">
                            <i class="fa-solid fa-arrow-trend-up" style="color: #10b981;"></i>
                            <span>@(isMember ? "My Incomes" : "Income Ledger")</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Expense" asp-action="Index" class="sidebar-link @(currentController == "Expense" ? "active" : "")">
                            <i class="fa-solid fa-arrow-trend-down" style="color: #f43f5e;"></i>
                            <span>@(isMember ? "My Expenses" : "Expense Ledger")</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Udhar" asp-action="Index" class="sidebar-link @(currentController == "Udhar" ? "active" : "")">
                            <i class="fa-solid fa-hand-holding-dollar" style="color: #f59e0b;"></i>
                            <span>@(isMember ? "My Udhar" : "Udhar Bahi-Khata")</span>
                        </a>
                    </li>
                </ul>

                <!-- Admin Suite (Exclusively visible to Family Head) -->
                @if (isAdmin)
                {
                    <div class="sidebar-group-title">Administration Suite</div>
                    <ul class="sidebar-menu">
                        <li>
                            <a asp-controller="Budget" asp-action="Index" class="sidebar-link @(currentController == "Budget" ? "active" : "")">
                                <i class="fa-solid fa-wallet" style="color: #6366f1;"></i>
                                <span>Budget Planner</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Category" asp-action="Index" class="sidebar-link @(currentController == "Category" ? "active" : "")">
                                <i class="fa-solid fa-tags"></i>
                                <span>Expense Categories</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Member" asp-action="Index" class="sidebar-link @(currentController == "Member" ? "active" : "")">
                                <i class="fa-solid fa-users"></i>
                                <span>Family Members & Keys</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="SavingsGoal" asp-action="Index" class="sidebar-link @(currentController == "SavingsGoal" ? "active" : "")">
                                <i class="fa-solid fa-piggy-bank" style="color: #0ea5e9;"></i>
                                <span>Savings Targets</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Reminder" asp-action="Index" class="sidebar-link @(currentController == "Reminder" ? "active" : "")">
                                <i class="fa-solid fa-bell"></i>
                                <span>Payment Reminders</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Backup" asp-action="Index" class="sidebar-link @(currentController == "Backup" ? "active" : "")">
                                <i class="fa-solid fa-database"></i>
                                <span>Database Vault</span>
                            </a>
                        </li>
                    </ul>
                }
                else
                {
                    <div style="margin: 20px 8px 10px; padding: 14px; background: rgba(245, 158, 11, 0.06); border: 1px dashed rgba(245, 158, 11, 0.3); border-radius: var(--radius-md);">
                        <div style="display: flex; align-items: center; gap: 8px; color: #f59e0b; font-size: 12px; font-weight: 700; margin-bottom: 4px;">
                            <i class="fa-solid fa-shield-halved"></i>
                            <span>Admin Suite Protected</span>
                        </div>
                        <p style="margin: 0; font-size: 11px; color: var(--text-dim); line-height: 1.4;">
                            Budgeting, backups, and member management are reserved for the Family Head.
                        </p>
                    </div>
                }

                <!-- Analytics Group -->
                <div class="sidebar-group-title">Analytics & Intelligence</div>
                <ul class="sidebar-menu">
                    <li>
                        <a asp-controller="Report" asp-action="Index" class="sidebar-link @(currentController == "Report" ? "active" : "")">
                            <i class="fa-solid fa-chart-pie" style="color: #38bdf8;"></i>
                            <span>Reports & Charts</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Sidebar User Profile Footer -->
            <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; border-radius: var(--radius-sm); background: @(isMember ? "rgba(99, 102, 241, 0.15)" : "rgba(16, 185, 129, 0.15)"); border: 1px solid @(isMember ? "#6366f1" : "#10b981"); display: flex; align-items: center; justify-content: center; font-weight: 700; color: @(isMember ? "#818cf8" : "#34d399"); font-size: 14px;">
                        @(isMember ? memberName.Substring(0, 1).ToUpper() : familyName.Substring(0, 1).ToUpper())
                    </div>
                    <div style="line-height: 1.2;">
                        <span style="font-size: 13px; font-weight: 700; color: var(--text-primary); display: block;">
                            @(isMember ? memberName : familyName)
                        </span>
                        <small style="font-size: 11px; color: var(--text-dim);">
                            @(isMember ? "Family Member" : "Family Admin")
                        </small>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Workspace Area -->
        <main class="app-main-content animate-fade-in-up">
            <!-- Flash Notifications -->
            @if (TempData["Error"] != null)
            {
                <div class="glass-card" style="border-left: 4px solid #f43f5e; margin-bottom: 24px; padding: 14px 20px; display: flex; align-items: center; gap: 14px;">
                    <div style="width: 36px; height: 36px; border-radius: var(--radius-sm); background: rgba(244, 63, 94, 0.15); display: flex; align-items: center; justify-content: center; color: #f43f5e; font-size: 16px; flex-shrink: 0;">
                        <i class="fa-solid fa-circle-exclamation"></i>
                    </div>
                    <div style="flex: 1;">
                        <strong style="color: #fb7185; font-size: 13px; display: block;">Notice / Alert</strong>
                        <span style="font-size: 13.5px; color: var(--text-secondary);">@TempData["Error"]</span>
                    </div>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="glass-card" style="border-left: 4px solid #10b981; margin-bottom: 24px; padding: 14px 20px; display: flex; align-items: center; gap: 14px;">
                    <div style="width: 36px; height: 36px; border-radius: var(--radius-sm); background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; color: #10b981; font-size: 16px; flex-shrink: 0;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div style="flex: 1;">
                        <strong style="color: #34d399; font-size: 13px; display: block;">Success</strong>
                        <span style="font-size: 13.5px; color: var(--text-secondary);">@TempData["Success"]</span>
                    </div>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Master Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
