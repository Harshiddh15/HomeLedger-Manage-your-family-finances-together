<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HUD ADMIN</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 30px 20px;
        }
    </style>
</head>
@{
    var loginType = Context.Session.GetString("LoginType");
    var isAdmin = loginType == "Admin";
    var isMember = loginType == "Member";
    var memberName = Context.Session.GetString("MemberName");
    var familyName = Context.Session.GetString("FamilyName");
}
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <div style="display: flex; align-items: center; gap: 15px;">
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fa-solid fa-bars"></i>
                </button>
                @if (isAdmin)
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Dashboard" style="white-space: nowrap;">
                        <i class="fa-solid fa-cube"></i> HUD ADMIN
                    </a>
                }
                else
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="MemberDashboard" style="white-space: nowrap; display: flex; align-items: center;">
                        <i class="fa-solid fa-user-shield" style="margin-right: 8px; color: #10b981;"></i> MEMBER PORTAL
                        <span style="font-size: 10px; padding: 2px 8px; background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid #f59e0b; border-radius: 4px; margin-left: 10px; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
                            <i class="fa-solid fa-lock"></i> ADMIN LOCKED
                        </span>
                    </a>
                }
            </div>
        </div>
    </nav>

    <div class="main-wrapper">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-content">
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Navigation</h3>
                    <ul class="sidebar-nav">
                        <li class="sidebar-nav-item">
                            @if (isAdmin)
                            {
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Home" asp-action="Dashboard">
                                    <i class="fa-solid fa-gauge"></i> Admin Dashboard
                                </a>
                            }
                            else
                            {
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Home" asp-action="MemberDashboard">
                                    <i class="fa-solid fa-id-badge"></i> Member Dashboard
                                </a>
                            }
                        </li>
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Income" asp-action="Index">
                                <i class="fa-solid fa-arrow-trend-up"></i> Income
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Expense" asp-action="Index">
                                <i class="fa-solid fa-arrow-trend-down"></i> Expenses
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Udhar" asp-action="Index">
                                <i class="fa-solid fa-hand-holding-dollar"></i> Udhar
                            </a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Budget" asp-action="Index">
                                    <i class="fa-solid fa-wallet"></i> Budget
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Reminder" asp-action="Index">
                                    <i class="fa-solid fa-bell"></i> Reminders
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="SavingsGoal" asp-action="Index">
                                    <i class="fa-solid fa-piggy-bank"></i> Savings
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="RecurringExpense" asp-action="Index">
                                    <i class="fa-solid fa-rotate"></i> Recurring Exp
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="RecurringIncome" asp-action="Index">
                                    <i class="fa-solid fa-rotate"></i> Recurring Inc
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Category" asp-action="Index">
                                    <i class="fa-solid fa-tags"></i> Categories
                                </a>
                            </li>
                        }
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-area="" asp-controller="Report" asp-action="Index">
                                <i class="fa-solid fa-chart-line"></i> Reports
                            </a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Member" asp-action="Index">
                                    <i class="fa-solid fa-users"></i> Members
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link" asp-area="" asp-controller="Backup" asp-action="Index">
                                    <i class="fa-solid fa-database"></i> Backup
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="sidebar-nav-item" style="margin-top: 15px;">
                                <div style="padding: 10px 14px; background: rgba(245, 158, 11, 0.08); border: 1px dashed rgba(245, 158, 11, 0.35); border-radius: 6px; font-size: 11px; color: #f59e0b; display: flex; align-items: center; gap: 8px;">
                                    <i class="fa-solid fa-lock"></i>
                                    <span>Admin Controls (Locked)</span>
                                </div>
                            </li>
                        }
                    </ul>
                </div>

                <div class="sidebar-section">
                    <h3 class="sidebar-title">Quick Actions</h3>
                    <div class="sidebar-actions">
                        <i class="fa-solid fa-magnifying-glass" style="cursor: pointer;" title="Search" id="searchBtn"></i>
                        <i class="fa-solid fa-border-all" style="cursor: pointer;" title="Widgets" id="widgetsBtn"></i>
                        <i class="fa-solid fa-bell" style="cursor: pointer;" title="Notifications" id="notificationsBtn"></i>
                        <i class="fa-solid fa-circle-half-stroke" id="darkModeToggle" style="cursor: pointer;" title="Toggle Dark Mode"></i>
                    </div>
                </div>

                <div class="sidebar-section sidebar-user">
                    <div class="user-info">
                        <div class="user-avatar" style="@(isMember ? "border-color: #10b981;" : "border-color: #00e5ff;")">
                            <i class="fa-solid @(isMember ? "fa-user-check" : "fa-user-shield")"></i>
                        </div>
                        <div class="user-details">
                            @if (isMember)
                            {
                                <span class="user-name" style="font-size: 13px; font-weight: 700; color: #fff;">@memberName</span>
                                <small style="display: block; font-size: 10px; color: #10b981; font-weight: 600; text-transform: uppercase;">Member Access</small>
                            }
                            else
                            {
                                <span class="user-name" style="font-size: 13px; font-weight: 700; color: #fff;">@familyName</span>
                                <small style="display: block; font-size: 10px; color: #00e5ff; font-weight: 600; text-transform: uppercase;">Admin Head</small>
                            }
                        </div>
                        <a class="btn btn-sm btn-danger logout-btn" asp-area="" asp-controller="Account" asp-action="Logout" title="Logout">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="container">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; padding: 14px 18px; border-radius: 6px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; font-weight: 600;">
                        <i class="fa-solid fa-circle-exclamation" style="font-size: 18px; color: #ef4444;"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #6ee7b7; padding: 14px 18px; border-radius: 6px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; font-weight: 600;">
                        <i class="fa-solid fa-circle-check" style="font-size: 18px; color: #10b981;"></i>
                        <span>@TempData["Success"]</span>
                    </div>
                }
                <main role="main">
                    @RenderBody()
                </main>
            </div>

            <footer class="footer">
                <div class="container">
                    <p>&copy; 2026 - <strong>@(isMember ? "HomeLedger Member Portal" : "HUD ADMIN")</strong> | Family Finance Control Terminal</p>
                </div>
            </footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Sidebar Toggle & Hover
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        
        // Initialize sidebar as collapsed
        sidebar.classList.add('collapsed');
        
        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
        });

        // Dark Mode Toggle
        const darkModeToggle = document.getElementById('darkModeToggle');
        const body = document.body;
        
        // Check for saved preference (default to dark mode)
        if (localStorage.getItem('lightMode') === 'true') {
            body.classList.add('light-mode');
            darkModeToggle.classList.remove('fa-circle-half-stroke');
            darkModeToggle.classList.add('fa-sun');
        }
        
        darkModeToggle.addEventListener('click', () => {
            body.classList.toggle('light-mode');
            const isLight = body.classList.contains('light-mode');
            localStorage.setItem('lightMode', isLight);
            
            if (isLight) {
                darkModeToggle.classList.remove('fa-circle-half-stroke');
                darkModeToggle.classList.add('fa-sun');
            } else {
                darkModeToggle.classList.remove('fa-sun');
                darkModeToggle.classList.add('fa-circle-half-stroke');
            }
        });

        // Quick Actions Buttons
        const searchBtn = document.getElementById('searchBtn');
        const widgetsBtn = document.getElementById('widgetsBtn');
        const notificationsBtn = document.getElementById('notificationsBtn');

        searchBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            searchBtn.style.color = 'var(--hud-cyan)';
            setTimeout(() => { searchBtn.style.color = ''; }, 500);
        });

        widgetsBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            widgetsBtn.style.color = 'var(--hud-cyan)';
            setTimeout(() => { widgetsBtn.style.color = ''; }, 500);
        });

        notificationsBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            notificationsBtn.style.color = 'var(--hud-cyan)';
            setTimeout(() => { notificationsBtn.style.color = ''; }, 500);
        });
    </script>
</body>
</html>
