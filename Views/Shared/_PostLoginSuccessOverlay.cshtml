@* Dedicated Post-Login Verification Success Animation (Plays ONLY right after successful Login -> Dashboard/MemberDashboard, ~1.95s) *@
@{
    var loginType = Context.Session.GetString("LoginType");
    var isMember = loginType == "Member";
    var displayName = isMember
        ? (Context.Session.GetString("MemberName") ?? "Member")
        : (Context.Session.GetString("FamilyName") ?? "Family Workspace");
    var roleBadge = isMember ? "MEMBER PORTAL UNLOCKED" : "ADMIN VAULT UNLOCKED";
}

<style>
    .hl-login-success-curtain {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: none;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 50% 45%, #122628 0%, #0e1525 75%);
        cursor: pointer;
        user-select: none;
        overflow: hidden;
    }

    body.light-mode .hl-login-success-curtain {
        background: radial-gradient(circle at 50% 45%, #ecfdf5 0%, #e2e8f0 75%);
    }

    .hl-login-success-curtain.is-playing {
        display: flex;
        animation: hlPostLoginCurtainOut 0.52s cubic-bezier(0.76, 0, 0.24, 1) 1.44s forwards;
    }

    #hlPostLoginCanvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .hl-postlogin-stage {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 16px;
        padding: 20px;
    }

    .hl-login-success-curtain.is-playing .hl-postlogin-stage {
        animation: hlPostLoginStageExit 0.42s cubic-bezier(0.16, 1, 0.3, 1) 1.4s forwards;
    }

    .hl-check-orb {
        position: relative;
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.24), rgba(56, 189, 248, 0.16));
        border: 1.5px solid rgba(52, 211, 153, 0.65);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 46px rgba(16, 185, 129, 0.48);
        opacity: 0;
        transform: scale(0.55);
    }

    .hl-login-success-curtain.is-playing .hl-check-orb {
        animation: hlCheckPop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.04s forwards;
    }

    .hl-check-shockwave {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid #34d399;
        opacity: 0;
    }

    .hl-login-success-curtain.is-playing .hl-check-shockwave {
        animation: hlCheckWave 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.38s forwards;
    }

    .hl-svg-circle {
        stroke-dasharray: 165;
        stroke-dashoffset: 165;
    }

    .hl-login-success-curtain.is-playing .hl-svg-circle {
        animation: hlDrawStroke 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.12s forwards;
    }

    .hl-svg-tick {
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
    }

    .hl-login-success-curtain.is-playing .hl-svg-tick {
        animation: hlDrawStroke 0.38s cubic-bezier(0.22, 1, 0.36, 1) 0.46s forwards;
    }

    .hl-welcome-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 14px;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(52, 211, 153, 0.38);
        color: #34d399;
        font-family: var(--font-mono, 'JetBrains Mono', monospace);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        opacity: 0;
        transform: translateY(10px);
    }

    body.light-mode .hl-welcome-badge {
        color: #059669;
    }

    .hl-login-success-curtain.is-playing .hl-welcome-badge {
        animation: hlWelcomeSlideUp 0.48s cubic-bezier(0.16, 1, 0.3, 1) 0.36s forwards;
    }

    .hl-welcome-heading {
        font-family: var(--font-display, 'Plus Jakarta Sans', sans-serif);
        font-size: clamp(24px, 4vw, 36px);
        font-weight: 800;
        color: var(--text-primary, #f8fafc);
        letter-spacing: -0.025em;
        margin: 0;
        opacity: 0;
        transform: translateY(16px);
    }

    .hl-login-success-curtain.is-playing .hl-welcome-heading {
        animation: hlWelcomeSlideUp 0.52s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
    }

    .hl-welcome-heading span {
        background: linear-gradient(135deg, #34d399 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hl-welcome-sub {
        font-size: 13.5px;
        color: var(--text-muted, #94a3b8);
        opacity: 0;
        transform: translateY(10px);
    }

    .hl-login-success-curtain.is-playing .hl-welcome-sub {
        animation: hlWelcomeSlideUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.68s forwards;
    }

    @@keyframes hlCheckPop {
        to { opacity: 1; transform: scale(1); }
    }

    @@keyframes hlCheckWave {
        0% { opacity: 0.9; transform: scale(1); }
        100% { opacity: 0; transform: scale(1.9); }
    }

    @@keyframes hlDrawStroke {
        to { stroke-dashoffset: 0; }
    }

    @@keyframes hlWelcomeSlideUp {
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes hlPostLoginStageExit {
        to { opacity: 0; transform: translateY(-18px) scale(0.97); }
    }

    @@keyframes hlPostLoginCurtainOut {
        0% { opacity: 1; transform: translateY(0%); pointer-events: auto; }
        15% { pointer-events: none; }
        100% { opacity: 0; transform: translateY(-100%); visibility: hidden; pointer-events: none; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .hl-login-success-curtain.is-playing { display: none !important; }
    }
</style>

<div id="hlPostLoginOverlay" class="hl-login-success-curtain" aria-hidden="true">
    <canvas id="hlPostLoginCanvas"></canvas>

    <div class="hl-postlogin-stage">
        <div style="position: relative; display: flex; align-items: center; justify-content: center;">
            <div class="hl-check-shockwave"></div>
            <div class="hl-check-orb">
                <svg width="56" height="56" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle class="hl-svg-circle" cx="30" cy="30" r="25" stroke="#34d399" stroke-width="2.8" />
                    <path class="hl-svg-tick" d="M19 30.5L26.5 38L41.5 22" stroke="#38bdf8" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>

        <div class="hl-welcome-badge">
            <i class="fa-solid fa-shield-check"></i>
            <span>@roleBadge</span>
        </div>

        <h2 class="hl-welcome-heading">Welcome, <span>@displayName</span></h2>
        <div class="hl-welcome-sub">Identity verified — opening your live ledger...</div>
    </div>
</div>

<script>
    (function () {
        var overlay = document.getElementById('hlPostLoginOverlay');
        var canvas = document.getElementById('hlPostLoginCanvas');
        if (!overlay) return;

        var shouldPlay = false;
        try {
            var flag = sessionStorage.getItem('hl_just_logged_in');
            var ref = document.referrer || '';
            var fromAuthRoute = false;
            if (ref) {
                var refPath = new URL(ref).pathname.toLowerCase();
                fromAuthRoute = refPath.indexOf('/account/login') === 0 ||
                                refPath.indexOf('/account/memberlogin') === 0 ||
                                refPath.indexOf('/account/register') === 0;
            }
            if (flag === '1' || fromAuthRoute) {
                shouldPlay = true;
                window.__hlPostLoginPlayed = true;
                sessionStorage.removeItem('hl_just_logged_in');
            }
        } catch (e) {}

        if (!shouldPlay) return;

        overlay.classList.add('is-playing');
        var rafId = null;

        function startRisingSparks() {
            if (!canvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width = window.innerWidth;
            var h = canvas.height = window.innerHeight;
            var startTs = performance.now();
            var palette = ['#34d399', '#10b981', '#38bdf8', '#a7f3d0'];

            var sparks = [];
            for (var i = 0; i < 45; i++) {
                sparks.push({
                    x: Math.random() * w,
                    y: h * (0.45 + Math.random() * 0.65),
                    vy: -(1.4 + Math.random() * 2.8),
                    vx: (Math.random() - 0.5) * 0.8,
                    r: 1.6 + Math.random() * 2.8,
                    color: palette[i % palette.length]
                });
            }

            function draw(now) {
                var elapsed = now - startTs;
                ctx.clearRect(0, 0, w, h);
                var alphaScale = elapsed > 1400 ? Math.max(0, 1 - (elapsed - 1400) / 480) : 1;

                for (var i = 0; i < sparks.length; i++) {
                    var s = sparks[i];
                    s.x += s.vx;
                    s.y += s.vy;
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = s.color;
                    ctx.globalAlpha = 0.65 * alphaScale;
                    ctx.fill();
                }
                ctx.globalAlpha = 1;

                if (elapsed < 1960) {
                    rafId = requestAnimationFrame(draw);
                }
            }
            rafId = requestAnimationFrame(draw);
        }

        function dismissPostLogin() {
            cancelAnimationFrame(rafId);
            overlay.style.display = 'none';
            overlay.classList.remove('is-playing');
        }

        startRisingSparks();
        setTimeout(function () { overlay.style.pointerEvents = 'none'; }, 1440);
        setTimeout(dismissPostLogin, 1980);

        overlay.addEventListener('click', dismissPostLogin, { once: true });
        document.addEventListener('keydown', function (ev) {
            if (ev.key === 'Escape') dismissPostLogin();
        }, { once: true });
    })();
</script>
