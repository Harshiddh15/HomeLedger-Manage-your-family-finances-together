@model Udhar
@{
    ViewData["Title"] = "Delete Udhar Record";
    Layout = "_Layout";
}

<div style="max-width: 580px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; margin: 0; color: #fb7185;">Delete Udhar Record</h1>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Are you sure you want to permanently delete this credit entry?</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Cancel
        </a>
    </div>

    <div class="glass-card" style="border-color: rgba(244, 63, 94, 0.3);">
        <div class="glass-card-header" style="background: rgba(244, 63, 94, 0.08); border-bottom: 1px solid rgba(244, 63, 94, 0.2);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(244, 63, 94, 0.2); color: #fb7185; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3 style="font-size: 15px; font-weight: 700; margin: 0; color: var(--text-primary);">Confirm Deletion</h3>
            </div>
            <span class="badge badge-rose">Permanent Action</span>
        </div>

        <div class="glass-card-body">
            <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 24px;">
                <div style="display: flex; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid var(--border-hairline);">
                    <span style="color: var(--text-muted); font-size: 13.5px;">Person / Counterparty</span>
                    <strong style="color: var(--text-primary); font-size: 14px;">@Model.PersonName</strong>
                </div>

                <div style="display: flex; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid var(--border-hairline);">
                    <span style="color: var(--text-muted); font-size: 13.5px;">Classification</span>
                    @if (Model.Type == "Lene Hai")
                    {
                        <span class="badge badge-cyan">Lene Hai (To Receive)</span>
                    }
                    else
                    {
                        <span class="badge badge-amber">Dene Hai (To Pay)</span>
                    }
                </div>

                <div style="display: flex; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid var(--border-hairline);">
                    <span style="color: var(--text-muted); font-size: 13.5px;">Total Principal</span>
                    <strong class="currency-amount" style="color: var(--text-primary); font-size: 15px;">₹@Model.Amount.ToString("N2")</strong>
                </div>

                <div style="display: flex; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid var(--border-hairline);">
                    <span style="color: var(--text-muted); font-size: 13.5px;">Repaid So Far</span>
                    <span class="currency-amount" style="color: var(--emerald-400); font-weight: 700;">₹@Model.PaidAmount.ToString("N2")</span>
                </div>

                <div style="display: flex; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid var(--border-hairline);">
                    <span style="color: var(--text-muted); font-size: 13.5px;">Remaining Balance</span>
                    <strong class="currency-amount" style="color: @(Model.RemainingAmount > 0 ? "#fbbf24" : "var(--text-dim)"); font-size: 15px;">
                        ₹@Model.RemainingAmount.ToString("N2")
                    </strong>
                </div>

                <div style="display: flex; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid var(--border-hairline);">
                    <span style="color: var(--text-muted); font-size: 13.5px;">Transaction Date</span>
                    <span style="color: var(--text-secondary); font-size: 13.5px;">@Model.Date.ToString("dd MMMM yyyy")</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Reason))
                {
                    <div style="display: flex; justify-content: space-between; padding-bottom: 10px;">
                        <span style="color: var(--text-muted); font-size: 13.5px;">Reason / Notes</span>
                        <span style="color: var(--text-secondary); font-size: 13.5px; max-width: 60%; text-align: right;">@Model.Reason</span>
                    </div>
                }
            </div>

            <form asp-action="Delete" method="post" style="display: flex; gap: 12px;">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger" style="flex: 1; padding: 12px 20px;">
                    <i class="fa-solid fa-trash"></i> Yes, Permanently Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>