@model Udhar
@{
    ViewData["Title"] = "Delete Udhar";
    Layout = "_Layout";
}

<style>
    .page-header {
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #333;
    }

    .card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        max-width: 600px;
    }

    .card-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 20px 25px;
    }

    .card-header h3 {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
    }

    .card-body {
        padding: 30px 25px;
    }

    .detail-row {
        display: flex;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f0f0f0;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        width: 150px;
        color: #666;
    }

    .detail-value {
        flex: 1;
        color: #333;
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.2s, box-shadow 0.2s;
        margin-right: 10px;
    }

    .btn-danger {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(240, 147, 251, 0.3);
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Delete Udhar</h1>
</div>

<div class="card">
    <div class="card-header">
        <h3>Confirm Deletion</h3>
    </div>
    <div class="card-body">
        <p style="margin-bottom: 20px; color: #666;">Are you sure you want to delete this udhar record?</p>
        
        <div class="detail-row">
            <span class="detail-label">Person Name:</span>
            <span class="detail-value">@Model.PersonName</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Type:</span>
            <span class="detail-value">@Model.Type</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Amount:</span>
            <span class="detail-value" style="font-weight: 600;">₹@Model.Amount.ToString("N2")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Paid:</span>
            <span class="detail-value">₹@Model.PaidAmount.ToString("N2")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Remaining:</span>
            <span class="detail-value" style="font-weight: 600; color: @(Model.RemainingAmount > 0 ? "#eb3349" : "#11998e");">₹@Model.RemainingAmount.ToString("N2")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Date:</span>
            <span class="detail-value">@Model.Date.ToString("d MMM yyyy")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Reason:</span>
            <span class="detail-value">@Model.Reason</span>
        </div>

        <form asp-action="Delete" method="post" style="margin-top: 20px;">
            <input type="hidden" name="id" value="@Model.Id">
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
