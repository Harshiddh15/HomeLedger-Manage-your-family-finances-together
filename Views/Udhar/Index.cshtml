@model List<Udhar>
@{
    var isMember = Context.Session.GetString("LoginType") == "Member";
    var memberName = Context.Session.GetString("MemberName");
    ViewData["Title"] = isMember ? "My Udhar Ledger" : "Family Udhar Bahi-Khata";
    Layout = "_Layout";
    var totalLene = Model?.Where(u => u.Type == "Lene Hai" && u.Status == "Pending").Sum(u => u.RemainingAmount) ?? 0;
    var totalDene = Model?.Where(u => u.Type == "Dene Hai" && u.Status == "Pending").Sum(u => u.RemainingAmount) ?? 0;
    var pendingCount = Model?.Count(u => u.Status == "Pending") ?? 0;
    var completedCount = Model?.Count(u => u.Status == "Completed") ?? 0;
}

<div>
    <!-- Top Summary Banner -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                <h1 style="font-size: 24px; font-weight: 800; margin: 0;">
                    @(isMember ? $"My Udhar Ledger ({memberName})" : "Family Udhar Bahi-Khata")
                </h1>
                <span class="badge badge-amber">@Model.Count Total Records</span>
            </div>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">
                Baki Lene Hai (Receivable): <strong class="currency-amount" style="color: #38bdf8;">₹@totalLene.ToString("N2")</strong> &bull;
                Baki Dene Hai (Payable): <strong class="currency-amount" style="color: #fbbf24;">₹@totalDene.ToString("N2")</strong>
            </p>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            @if (isMember)
            {
                <a asp-controller="Home" asp-action="MemberDashboard" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left"></i> Member Portal
                </a>
            }
            <a asp-action="Create" class="btn btn-primary btn-sm" style="background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);">
                <i class="fa-solid fa-plus"></i> Record Udhar
            </a>
        </div>
    </div>

    <!-- Quick Filter Tabs -->
    <div style="display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;">
        <button type="button" class="btn btn-secondary btn-sm filter-btn active" data-filter="all" onclick="filterUdhar('all', this)" style="border-radius: var(--radius-full); padding: 5px 14px; font-size: 12px;">
            All (@Model.Count)
        </button>
        <button type="button" class="btn btn-secondary btn-sm filter-btn" data-filter="Pending" onclick="filterUdhar('Pending', this)" style="border-radius: var(--radius-full); padding: 5px 14px; font-size: 12px; color: #fb7185;">
            <i class="fa-solid fa-clock"></i> Pending Baaki (@pendingCount)
        </button>
        <button type="button" class="btn btn-secondary btn-sm filter-btn" data-filter="Completed" onclick="filterUdhar('Completed', this)" style="border-radius: var(--radius-full); padding: 5px 14px; font-size: 12px; color: var(--emerald-400);">
            <i class="fa-solid fa-circle-check"></i> Settled Chukta (@completedCount)
        </button>
        <button type="button" class="btn btn-secondary btn-sm filter-btn" data-filter="Lene" onclick="filterUdhar('Lene', this)" style="border-radius: var(--radius-full); padding: 5px 14px; font-size: 12px; color: #38bdf8;">
            Lene Hai (Receivable)
        </button>
        <button type="button" class="btn btn-secondary btn-sm filter-btn" data-filter="Dene" onclick="filterUdhar('Dene', this)" style="border-radius: var(--radius-full); padding: 5px 14px; font-size: 12px; color: #fbbf24;">
            Dene Hai (Payable)
        </button>
    </div>

    <!-- Modern Table Container -->
    <div class="table-container">
        @if (Model != null && Model.Any())
        {
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Person / Store</th>
                        <th>Classification</th>
                        <th>Total Udhar</th>
                        <th>Repaid / Wapas</th>
                        <th>Remaining Baaki</th>
                        <th>Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="udharTableBody">
                    @foreach (var udhar in Model)
                    {
                        var rowType = udhar.Type == "Lene Hai" ? "Lene" : "Dene";
                        <tr class="udhar-row" data-status="@udhar.Status" data-type="@rowType">
                            <td style="color: var(--text-muted); font-size: 13px; white-space: nowrap;">
                                @udhar.Date.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <strong style="color: var(--text-primary); font-size: 14px; display: block;">@udhar.PersonName</strong>
                                <div style="display: flex; gap: 8px; align-items: center; margin-top: 2px;">
                                    @if (!string.IsNullOrEmpty(udhar.MemberName))
                                    {
                                        <span style="font-size: 11px; color: var(--text-dim);"><i class="fa-solid fa-user"></i> @udhar.MemberName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(udhar.Reason))
                                    {
                                        <span style="font-size: 11px; color: var(--text-dim);">&bull; @udhar.Reason</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (udhar.Type == "Lene Hai")
                                {
                                    <span class="badge badge-cyan" title="Receivable - Humne udhar diya hai, paise wapas lene hain">
                                        <i class="fa-solid fa-arrow-down-left"></i> Lene Hai
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-amber" title="Payable - Humne udhar liya hai, paise wapas dene hain">
                                        <i class="fa-solid fa-arrow-up-right"></i> Dene Hai
                                    </span>
                                }
                            </td>
                            <td class="currency-amount" style="font-weight: 700; color: var(--text-primary);">
                                ₹@udhar.Amount.ToString("N2")
                            </td>
                            <td class="currency-amount" style="color: var(--emerald-400);">
                                ₹@udhar.PaidAmount.ToString("N2")
                            </td>
                            <td class="currency-amount" style="font-weight: 800; font-size: 15px; color: @(udhar.RemainingAmount > 0 ? (udhar.Type == "Lene Hai" ? "#38bdf8" : "#fbbf24") : "var(--text-dim)");">
                                ₹@udhar.RemainingAmount.ToString("N2")
                            </td>
                            <td>
                                @if (udhar.Status == "Pending")
                                {
                                    <span class="badge badge-rose">
                                        <i class="fa-solid fa-clock" style="font-size: 10px;"></i> Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-emerald">
                                        <i class="fa-solid fa-check" style="font-size: 10px;"></i> Settled
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 6px; align-items: center; flex-wrap: wrap; justify-content: flex-end;">
                                    @if (udhar.Status == "Pending")
                                    {
                                        <!-- Quick Partial Repayment Button (Instalment Modal) -->
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="openRepaymentModal(@udhar.Id, '@udhar.PersonName', @udhar.Amount, @udhar.PaidAmount, @udhar.RemainingAmount, '@udhar.Type')" title="Add Instalment / Katwayein" style="padding: 4px 10px; font-size: 11px; color: #38bdf8; border-color: rgba(56, 189, 248, 0.35); background: rgba(56, 189, 248, 0.1);">
                                            <i class="fa-solid fa-hand-holding-dollar"></i> + Jama / Pay
                                        </button>

                                        <!-- Quick Full Settle Form -->
                                        <form asp-action="Settle" method="post" style="display: inline;" onsubmit="return confirm('Pura baaki udhar chukta mark karein?');">
                                            <input type="hidden" name="id" value="@udhar.Id" />
                                            <button type="submit" class="btn btn-secondary btn-sm" title="Quick Settle (Pura Chukta)" style="padding: 4px 10px; font-size: 11px; color: var(--emerald-400); border-color: rgba(16, 185, 129, 0.35); background: rgba(16, 185, 129, 0.1);">
                                                <i class="fa-solid fa-check-double"></i> Settle
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <!-- Quick Reopen Form -->
                                        <form asp-action="Reopen" method="post" style="display: inline;" onsubmit="return confirm('Dobara Pending karein (Reopen as pending)?');">
                                            <input type="hidden" name="id" value="@udhar.Id" />
                                            <button type="submit" class="btn btn-secondary btn-sm" title="Reopen as Pending" style="padding: 4px 10px; font-size: 11px; color: #fbbf24; border-color: rgba(245, 158, 11, 0.35); background: rgba(245, 158, 11, 0.1);">
                                                <i class="fa-solid fa-rotate-left"></i> Reopen
                                            </button>
                                        </form>
                                    }

                                    <!-- Edit -->
                                    <a asp-action="Edit" asp-route-id="@udhar.Id" class="btn btn-secondary btn-sm" title="Edit / Update" style="padding: 4px 10px; font-size: 11px;">
                                        <i class="fa-solid fa-pen"></i> Edit
                                    </a>

                                    <!-- Delete -->
                                    <a asp-action="Delete" asp-route-id="@udhar.Id" class="btn btn-danger btn-sm" title="Delete" style="padding: 4px 10px; font-size: 11px;">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="text-align: center; padding: 60px 20px; color: var(--text-muted);">
                <i class="fa-solid fa-hand-holding-dollar" style="font-size: 36px; opacity: 0.35; margin-bottom: 12px; display: block;"></i>
                <h4 style="font-size: 16px; font-weight: 700; color: var(--text-secondary); margin-bottom: 4px;">No Udhar Records Found</h4>
                <p style="font-size: 13.5px; margin: 0 0 16px;">Track money lent to friends, relatives, or shop credit here.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-plus"></i> Record First Udhar
                </a>
            </div>
        }
    </div>
</div>

<!-- QUICK REPAYMENT MODAL (Instalment Jama Popup) -->
<div id="repaymentModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div class="glass-card" style="width: 100%; max-width: 480px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7); border: 1px solid rgba(56, 189, 248, 0.3);">
        <div class="glass-card-header" style="background: rgba(56, 189, 248, 0.08); border-bottom: 1px solid rgba(56, 189, 248, 0.2); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(56, 189, 248, 0.2); color: #38bdf8; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
                <h3 style="font-size: 15px; font-weight: 700; margin: 0; color: var(--text-primary);">Kisht / Rashi Jama Karein</h3>
            </div>
            <button type="button" onclick="closeRepaymentModal()" style="background: none; border: none; color: var(--text-dim); font-size: 18px; cursor: pointer;">&times;</button>
        </div>

        <div class="glass-card-body">
            <form asp-action="AddRepayment" method="post" autocomplete="off" onsubmit="return validateRepayment()">
                <input type="hidden" id="modalUdharId" name="id" value="" />

                <div style="background: rgba(0, 0, 0, 0.25); border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); padding: 12px 16px; margin-bottom: 18px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                        <span style="font-size: 12.5px; color: var(--text-muted);">Person / Entity:</span>
                        <strong id="modalPersonName" style="color: var(--text-primary); font-size: 13.5px;">-</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                        <span style="font-size: 12.5px; color: var(--text-muted);">Total Principal:</span>
                        <span id="modalTotalAmount" class="currency-amount" style="font-weight: 600; color: var(--text-primary);">₹0.00</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                        <span style="font-size: 12.5px; color: var(--text-muted);">Previously Paid:</span>
                        <span id="modalPaidAmount" class="currency-amount" style="color: var(--emerald-400); font-weight: 600;">₹0.00</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding-top: 6px; border-top: 1px dashed var(--border-hairline);">
                        <span style="font-size: 13px; font-weight: 700; color: #fbbf24;">Abhi Tak Ka Baaki:</span>
                        <strong id="modalRemainingAmount" class="currency-amount" style="font-size: 14px; color: #fbbf24;">₹0.00</strong>
                    </div>
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" for="modalRepaymentInput" id="modalInputLabel" style="margin: 0; font-weight: 700;">
                            Aaj Kitne Paise Mile / Diye? (₹) *
                        </label>
                        <!-- Quick Presets -->
                        <div style="display: flex; gap: 4px;">
                            <button type="button" class="btn btn-secondary btn-sm" style="padding: 1px 6px; font-size: 10.5px;" onclick="setModalAmount(500)">500</button>
                            <button type="button" class="btn btn-secondary btn-sm" style="padding: 1px 6px; font-size: 10.5px;" onclick="setModalAmount(1000)">1000</button>
                            <button type="button" class="btn btn-primary btn-sm" style="padding: 1px 6px; font-size: 10.5px; background: #10b981;" onclick="setModalFull()">Pura</button>
                        </div>
                    </div>
                    <input type="number" id="modalRepaymentInput" name="repaymentAmount" class="form-control font-mono" required step="0.01" min="0.01" placeholder="e.g. 500" style="font-size: 18px; font-weight: 800; color: var(--emerald-400);" oninput="updateModalLiveCalc()" />
                </div>

                <!-- Live remaining preview banner -->
                <div id="modalLiveRemainingBox" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: var(--radius-sm); padding: 10px 14px; margin-bottom: 16px;">
                    <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 2px;">Yeh rashi katne ke baad naya balance:</span>
                    <strong id="modalNewRemainingText" style="font-size: 14px; color: #34d399;">₹0.00</strong>
                </div>

                <div class="form-group">
                    <label class="form-label" for="modalNote">Payment Note / Mode (Optional)</label>
                    <input type="text" id="modalNote" name="note" class="form-control" placeholder="e.g. UPI, Cash, Kisht 2, Bank transfer" />
                </div>

                <div style="display: flex; gap: 10px; margin-top: 24px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1; background: linear-gradient(135deg, #10b981, #059669); box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);">
                        <i class="fa-solid fa-check"></i> Katwayein & Jama Karein
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="closeRepaymentModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let activeModalMax = 0;

    function openRepaymentModal(id, person, total, paid, remaining, type) {
        activeModalMax = remaining;
        document.getElementById('modalUdharId').value = id;
        document.getElementById('modalPersonName').textContent = person;
        document.getElementById('modalTotalAmount').textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        document.getElementById('modalPaidAmount').textContent = '₹' + paid.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        document.getElementById('modalRemainingAmount').textContent = '₹' + remaining.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        
        const label = document.getElementById('modalInputLabel');
        if (type === 'Lene Hai') {
            label.textContent = 'Aaj kitne paise wapas mile? (₹) *';
        } else {
            label.textContent = 'Aaj kitne paise wapas diye? (₹) *';
        }

        document.getElementById('modalRepaymentInput').value = '';
        document.getElementById('modalRepaymentInput').max = remaining;
        document.getElementById('modalNote').value = '';
        updateModalLiveCalc();

        const modal = document.getElementById('repaymentModal');
        modal.style.display = 'flex';
        setTimeout(() => document.getElementById('modalRepaymentInput').focus(), 100);
    }

    function closeRepaymentModal() {
        document.getElementById('repaymentModal').style.display = 'none';
    }

    function setModalAmount(val) {
        document.getElementById('modalRepaymentInput').value = Math.min(val, activeModalMax);
        updateModalLiveCalc();
    }

    function setModalFull() {
        document.getElementById('modalRepaymentInput').value = activeModalMax.toFixed(2);
        updateModalLiveCalc();
    }

    function updateModalLiveCalc() {
        const inputVal = parseFloat(document.getElementById('modalRepaymentInput').value) || 0;
        const newRem = Math.max(0, activeModalMax - inputVal);
        const textElem = document.getElementById('modalNewRemainingText');
        
        if (inputVal <= 0) {
            textElem.textContent = '₹' + activeModalMax.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + ' (koi badlaav nahi)';
            textElem.style.color = '#fbbf24';
        } else if (newRem <= 0) {
            textElem.innerHTML = '🎉 ₹0.00 (Pura Udhar Settled / Chukta Ho Jayega!)';
            textElem.style.color = '#34d399';
        } else {
            textElem.innerHTML = `₹${newRem.toLocaleString('en-IN', { minimumFractionDigits: 2 })} (₹${inputVal.toLocaleString('en-IN', { minimumFractionDigits: 2 })} baaki me se kat jayega)`;
            textElem.style.color = '#38bdf8';
        }
    }

    function validateRepayment() {
        const val = parseFloat(document.getElementById('modalRepaymentInput').value) || 0;
        if (val <= 0) {
            alert('Kripya 0 se badi rashi dalein.');
            return false;
        }
        return true;
    }

    function filterUdhar(filter, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const rows = document.querySelectorAll('.udhar-row');
        rows.forEach(row => {
            const status = row.getAttribute('data-status');
            const type = row.getAttribute('data-type');

            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'Pending' || filter === 'Completed') {
                row.style.display = (status === filter) ? '' : 'none';
            } else if (filter === 'Lene' || filter === 'Dene') {
                row.style.display = (type === filter) ? '' : 'none';
            }
        });
    }
</script>