@model List<Udhar>
@{
    var isMember = Context.Session.GetString("LoginType") == "Member";
    var memberName = Context.Session.GetString("MemberName");
    ViewData["Title"] = isMember ? "My Udhar" : "Udhar Management";
    Layout = "_Layout";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px;">
    <h1 class="page-title" style="font-size: 24px; font-weight: 800; color: var(--hud-text-white); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 1px;">
        <span style="color: var(--hud-cyan); margin-right: 8px;">//</span> @(isMember ? $"My Udhar Ledger ({memberName})" : "Udhar Management")
    </h1>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        @if (isMember)
        {
            <a asp-controller="Home" asp-action="MemberDashboard" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Member Dashboard
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add Udhar
            </a>
        }
        else
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add Udhar
            </a>
        }
    </div>
</div>

<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700;">
            <i class="fa-solid fa-hand-holding-dollar" style="color: #f59e0b; margin-right: 8px;"></i>
            @(isMember ? $"My Udhar Records ({Model.Count})" : $"All Family Udhar Records ({Model.Count})")
        </h3>
    </div>
    <div class="table-responsive">
        @if (Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Person Name</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Paid</th>
                        <th>Remaining</th>
                        <th>Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var udhar in Model)
                    {
                        <tr>
                            <td>@udhar.Date.ToString("d MMM yyyy")</td>
                            <td>
                                <strong style="color: var(--hud-text-white);">@udhar.PersonName</strong>
                                @if (!string.IsNullOrEmpty(udhar.Reason))
                                {
                                    <small style="display: block; color: var(--hud-text-dim); font-size: 11px;">@udhar.Reason</small>
                                }
                            </td>
                            <td>
                                @if (udhar.Type == "Lene Hai")
                                {
                                    <span class="badge" style="background: rgba(0, 229, 255, 0.15); color: var(--hud-cyan); border: 1px solid rgba(0, 229, 255, 0.4);">
                                        <i class="fa-solid fa-arrow-down-left"></i> Lene Hai (Receivable)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4);">
                                        <i class="fa-solid fa-arrow-up-right"></i> Dene Hai (Payable)
                                    </span>
                                }
                            </td>
                            <td style="font-weight: 700; font-family: 'JetBrains Mono', monospace;">₹@udhar.Amount.ToString("N2")</td>
                            <td style="color: #10b981; font-family: 'JetBrains Mono', monospace;">₹@udhar.PaidAmount.ToString("N2")</td>
                            <td style="font-weight: 700; font-family: 'JetBrains Mono', monospace; color: @(udhar.RemainingAmount > 0 ? "#ef4444" : "#10b981");">
                                ₹@udhar.RemainingAmount.ToString("N2")
                            </td>
                            <td>
                                @if (udhar.Status == "Pending")
                                {
                                    <span class="badge badge-danger">Pending</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Completed</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                @if (isMember)
                                {
                                    <span style="font-size: 11px; color: var(--hud-text-muted); padding: 4px 8px; background: rgba(255, 255, 255, 0.05); border-radius: 4px;">
                                        <i class="fa-solid fa-lock" style="font-size: 9px;"></i> View Only
                                    </span>
                                }
                                else
                                {
                                    <div class="action-buttons" style="display: inline-flex; gap: 6px;">
                                        <a asp-action="Edit" asp-route-id="@udhar.Id" class="btn btn-sm btn-success">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@udhar.Id" class="btn btn-sm btn-danger">Delete</a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state" style="text-align: center; padding: 40px; color: var(--hud-text-muted);">
                <i class="fa-solid fa-hand-holding-dollar" style="font-size: 32px; opacity: 0.5; margin-bottom: 12px; display: block;"></i>
                <p>No udhar records found.</p>
            </div>
        }
    </div>
</div>
