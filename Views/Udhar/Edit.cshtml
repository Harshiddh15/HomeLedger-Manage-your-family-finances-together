@model Udhar
@{
    ViewData["Title"] = "Edit Udhar Transaction";
    Layout = "_Layout";
    var isLene = Model.Type == "Lene Hai";
}

<div style="max-width: 680px; margin: 0 auto;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                <h1 style="font-size: 24px; font-weight: 800; margin: 0;">Edit Udhar Entry</h1>
                @if (Model.Status == "Completed")
                {
                    <span id="headerStatusBadge" class="badge badge-emerald">Settled</span>
                }
                else
                {
                    <span id="headerStatusBadge" class="badge badge-rose">Pending</span>
                }
            </div>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Update principal, repayments, or terms for @Model.PersonName</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Back to Ledger
        </a>
    </div>

    <!-- Live Calculation Banner -->
    <div class="glass-card" style="margin-bottom: 24px; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(245, 158, 11, 0.25);">
        <div style="padding: 16px 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 16px; text-align: center;">
            <div style="border-right: 1px solid var(--border-hairline);">
                <span style="font-size: 11.5px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Total Udhar</span>
                <span id="calcTotal" class="currency-amount" style="font-size: 17px; font-weight: 800; color: var(--text-primary);">₹@Model.Amount.ToString("N2")</span>
            </div>
            <div style="border-right: 1px solid var(--border-hairline);">
                <span id="calcRepaidLabel" style="font-size: 11.5px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Repaid / Wapas</span>
                <span id="calcRepaid" class="currency-amount" style="font-size: 17px; font-weight: 800; color: var(--emerald-400);">₹@Model.PaidAmount.ToString("N2")</span>
            </div>
            <div style="border-right: 1px solid var(--border-hairline);">
                <span id="calcRemainingLabel" style="font-size: 11.5px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Remaining Baaki</span>
                <span id="calcRemaining" class="currency-amount" style="font-size: 17px; font-weight: 800; color: @(Model.RemainingAmount > 0 ? "#fbbf24" : "var(--text-dim)");">₹@Model.RemainingAmount.ToString("N2")</span>
            </div>
            <div>
                <span style="font-size: 11.5px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Computed Status</span>
                <span id="calcStatusText" style="font-size: 13px; font-weight: 700; color: @(Model.Status == "Completed" ? "var(--emerald-400)" : "#fb7185");">
                    @(Model.Status == "Completed" ? "✓ Settled" : "⏳ Pending")
                </span>
            </div>
        </div>
    </div>

    <!-- Main Edit Card -->
    <div class="glass-card">
        <div class="glass-card-header" style="background: rgba(245, 158, 11, 0.08); border-bottom: 1px solid rgba(245, 158, 11, 0.2);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(245, 158, 11, 0.2); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <h3 style="font-size: 15px; font-weight: 700; margin: 0; color: var(--text-primary);">Udhar Record Details</h3>
            </div>
            <span class="badge badge-amber">Admin Function</span>
        </div>

        <div class="glass-card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; color: #fb7185; font-size: 13px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p style="margin: 0 0 4px;"><i class="fa-solid fa-circle-exclamation"></i> @error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-action="Edit" method="post" autocomplete="off" id="udharEditForm">
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="form-group">
                    <label class="form-label" for="PersonName">External Person / Store Name *</label>
                    <input type="text" id="PersonName" name="PersonName" class="form-control" required value="@Model.PersonName" placeholder="e.g. Ramesh Bhai, Uncle, Grocery Store" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="MemberName">Family Member Involved</label>
                    <input type="text" id="MemberName" name="MemberName" class="form-control" value="@Model.MemberName" placeholder="e.g. Father, Mother, Self" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Type">Transaction Classification *</label>
                    <select id="Type" name="Type" class="form-control" required onchange="handleTypeChange()">
                        <option value="Lene Hai" selected="@(Model.Type == "Lene Hai" ? "selected" : null)">
                            Lene Hai (To Receive — Humne Udhar Diya Hai)
                        </option>
                        <option value="Dene Hai" selected="@(Model.Type == "Dene Hai" ? "selected" : null)">
                            Dene Hai (To Pay — Humne Udhar Liya Hai)
                        </option>
                    </select>
                    <small id="typeExplanation" style="color: var(--text-dim); font-size: 12px; display: block; margin-top: 4px;">
                        @(isLene ? "Aapne kisi ko udhar diya hai, paise wapas lene baaki hain." : "Aapne kisi se udhar liya hai, paise wapas chukane baaki hain.")
                    </small>
                </div>

                <!-- Total Amount Field -->
                <div class="form-group">
                    <label class="form-label" for="Amount">Total Principal Amount (₹) *</label>
                    <input type="number" id="Amount" name="Amount" class="form-control font-mono" required step="0.01" min="0" value="@Model.Amount.ToString("F2")" style="font-size: 18px; font-weight: 700;" oninput="updateCalculations()" />
                </div>

                <!-- Repaid / Settled Field with Helper Presets -->
                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" for="PaidAmount" id="paidAmountLabel" style="margin: 0;">
                            @(isLene ? "Repayment Received (Wapas Mil Gaya) ₹" : "Repayment Paid (Wapas De Diya) ₹")
                        </label>
                        <!-- Quick Repayment Presets -->
                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="btn btn-secondary btn-sm" style="padding: 2px 8px; font-size: 11px;" onclick="setRepayment(0)">
                                ₹0 (Kuch Nahi)
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" style="padding: 2px 8px; font-size: 11px;" onclick="setRepayment('half')">
                                50%
                            </button>
                            <button type="button" class="btn btn-primary btn-sm" style="padding: 2px 8px; font-size: 11px; background: linear-gradient(135deg, #10b981, #059669);" onclick="setRepayment('full')">
                                Full Settle (Chukta)
                            </button>
                        </div>
                    </div>
                    <input type="number" id="PaidAmount" name="PaidAmount" class="form-control font-mono" step="0.01" min="0" value="@Model.PaidAmount.ToString("F2")" oninput="updateCalculations()" />
                    <small style="color: var(--text-dim); font-size: 11.5px; display: block; margin-top: 4px;">
                        Agar udhar abhi pura wapas nahi hua hai, to yahan sirf utni hi rashi likhein jitni wapas mil chuki ya chuka chuke hain (agar kuch nahi diya to <strong>0</strong> rakhein).
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label" for="Date">Transaction Date *</label>
                    <input type="date" id="Date" name="Date" class="form-control" required value="@Model.Date.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Reason">Reason / Terms (Optional)</label>
                    <textarea id="Reason" name="Reason" class="form-control" rows="3" placeholder="Notes on interest, expected repayment date, or reason...">@Model.Reason</textarea>
                </div>

                <!-- Action Buttons -->
                <div style="display: flex; gap: 12px; margin-top: 28px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); box-shadow: 0 8px 24px -4px rgba(245, 158, 11, 0.4);">
                        <i class="fa-solid fa-floppy-disk"></i> Update Udhar Entry
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function handleTypeChange() {
        const type = document.getElementById('Type').value;
        const paidLabel = document.getElementById('paidAmountLabel');
        const explanation = document.getElementById('typeExplanation');
        const calcRepaidLabel = document.getElementById('calcRepaidLabel');
        const calcRemainingLabel = document.getElementById('calcRemainingLabel');

        if (type === 'Lene Hai') {
            paidLabel.textContent = 'Repayment Received (Wapas Mil Gaya) ₹';
            explanation.textContent = 'Aapne kisi ko udhar diya hai, paise wapas lene baaki hain.';
            calcRepaidLabel.textContent = 'Repayment Received';
            calcRemainingLabel.textContent = 'Remaining Lene Hai';
        } else {
            paidLabel.textContent = 'Repayment Paid (Wapas De Diya) ₹';
            explanation.textContent = 'Aapne kisi se udhar liya hai, paise wapas chukane baaki hain.';
            calcRepaidLabel.textContent = 'Repayment Paid';
            calcRemainingLabel.textContent = 'Remaining Dene Hai';
        }
        updateCalculations();
    }

    function setRepayment(val) {
        const amountInput = document.getElementById('Amount');
        const paidInput = document.getElementById('PaidAmount');
        const total = parseFloat(amountInput.value) || 0;

        if (val === 0) {
            paidInput.value = (0).toFixed(2);
        } else if (val === 'half') {
            paidInput.value = (total / 2).toFixed(2);
        } else if (val === 'full') {
            paidInput.value = total.toFixed(2);
        }
        updateCalculations();
    }

    function updateCalculations() {
        const amount = parseFloat(document.getElementById('Amount').value) || 0;
        const paid = parseFloat(document.getElementById('PaidAmount').value) || 0;
        const remaining = Math.max(0, amount - paid);

        document.getElementById('calcTotal').textContent = '₹' + amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('calcRepaid').textContent = '₹' + paid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        
        const remElem = document.getElementById('calcRemaining');
        remElem.textContent = '₹' + remaining.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        const statusElem = document.getElementById('calcStatusText');
        const headerBadge = document.getElementById('headerStatusBadge');

        if (remaining <= 0 && amount > 0) {
            statusElem.textContent = '✓ Settled';
            statusElem.style.color = 'var(--emerald-400)';
            remElem.style.color = 'var(--text-dim)';
            
            if (headerBadge) {
                headerBadge.className = 'badge badge-emerald';
                headerBadge.textContent = 'Settled';
            }
        } else {
            statusElem.textContent = '⏳ Pending';
            statusElem.style.color = '#fb7185';
            remElem.style.color = '#fbbf24';

            if (headerBadge) {
                headerBadge.className = 'badge badge-rose';
                headerBadge.textContent = 'Pending';
            }
        }
    }

    // Run on initial page load
    document.addEventListener('DOMContentLoaded', function() {
        updateCalculations();
    });
</script>