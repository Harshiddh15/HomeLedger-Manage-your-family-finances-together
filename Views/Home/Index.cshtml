            <div class="footer-col">
                <h4>System Status</h4>
                <div class="badge badge-emerald" style="text-transform: none; font-size: 11.5px; margin-bottom: 10px;">
                    <i class="fa-solid fa-circle-check"></i> Online &amp; DB Connected
                </div>
                <p style="font-size: 12px; color: var(--text-dim);">
                    100% Local MySQL &amp; BCrypt Encrypted Authentication.
                </p>
            </div>
        </div>

        <div style="max-width: 1200px; margin: 0 auto; padding-top: 22px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 12.5px; color: var(--text-dim);">
            <span>&copy; @DateTime.Now.Year HomeLedger. Engineered for Modern Households.</span>
            <span>ASP.NET Core MVC &bull; Balanced Slate Design System</span>
        </div>
    </footer>

    <!-- Shared App Script + Enhanced Landing Motion Engine -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // 1. Live Counter Engine (0 -> target over 1250ms, matching 1.0s-1.35s hero reveal)
        function runHeroCounters() {
            const counters = document.querySelectorAll('[data-hero-counter]');
            const duration = 1250;
            const startTime = performance.now();

            function tick(now) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);

                counters.forEach((el) => {
                    const target = parseFloat(el.getAttribute('data-hero-counter') || '0');
                    const prefix = el.getAttribute('data-prefix') || '';
                    const val = target * easeOut;
                    el.textContent = prefix + val.toLocaleString('en-IN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                });

                if (progress < 1) {
                    requestAnimationFrame(tick);
                }
            }
            requestAnimationFrame(tick);
        }

        // Run hero counters right as the [HomeLedger] split-shutter opens (~1.42s)
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(runHeroCounters, 1420);
        });

        // 2. One-Click Replay of the [HomeLedger] 2.0s Curtain + Hero Reveal
        function replayHeroIntro() {
            const card = document.getElementById('mockupCard');
            if (card) card.style.transform = '';
            if (window.replayHomeBrandIntro) window.replayHomeBrandIntro();
            document.body.classList.add('replay-reset');
            void document.body.offsetWidth; // Force CSS reflow
            document.body.classList.remove('replay-reset');
            setTimeout(runHeroCounters, 1420);
        }

        // Toggle Confidential Privacy Shield on Hero Mockup
        function toggleMockupPrivacy() {
            const card = document.getElementById('mockupCardInner');
            const icon = document.getElementById('privacyMaskIcon');
            const text = document.getElementById('privacyMaskText');
            if (!card) return;
            const isMasked = card.classList.toggle('privacy-masked');
            if (icon) {
                icon.className = isMasked ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
            }
            if (text) {
                text.textContent = isMasked ? 'Privacy Shield Active' : 'Privacy Shield Off';
            }
        }

        // 3. Scroll Progress Bar, Header Elevation & Active Section Indicator
        const landingHeader = document.getElementById('landingHeader');
        const scrollProgress = document.getElementById('scrollProgress');
        const navLinks = document.querySelectorAll('#landingNavLinks a[data-section]');
        const trackedSections = Array.from(navLinks)
            .map(a => document.getElementById(a.getAttribute('data-section')))
            .filter(Boolean);

        window.addEventListener('scroll', () => {
            const scrollY = window.scrollY;
            const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
            if (scrollProgress && maxScroll > 0) {
                scrollProgress.style.transform = `scaleX(${Math.min(scrollY / maxScroll, 1)})`;
            }
            if (landingHeader) {
                landingHeader.classList.toggle('is-scrolled', scrollY > 24);
            }

            // Active menu highlight
            let activeId = '';
            trackedSections.forEach(sec => {
                const rect = sec.getBoundingClientRect();
                if (rect.top <= 200) activeId = sec.id;
            });
            navLinks.forEach(link => {
                link.classList.toggle('active-link', link.getAttribute('data-section') === activeId);
            });
        }, { passive: true });

        // 4. Subtle 3D Mouse Tilt on Mockup Card (Desktop Only)
        const mockupWrapper = document.getElementById('mockupWrapper');
        const mockupCard = document.getElementById('mockupCard');
        if (mockupWrapper && mockupCard && window.matchMedia('(pointer: fine)').matches) {
            mockupWrapper.addEventListener('mousemove', (e) => {
                const rect = mockupWrapper.getBoundingClientRect();
                const x = (e.clientX - rect.left) / rect.width - 0.5;
                const y = (e.clientY - rect.top) / rect.height - 0.5;
                mockupCard.style.transform = `rotateX(${(-y * 4).toFixed(2)}deg) rotateY(${(x * 4.5).toFixed(2)}deg)`;
            });
            mockupWrapper.addEventListener('mouseleave', () => {
                mockupCard.style.transform = 'rotateX(0deg) rotateY(0deg)';
            });
        }

        // 5. Mobile Navigation Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileNavDrawer = document.getElementById('mobileNavDrawer');
        if (mobileMenuBtn && mobileNavDrawer) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileNavDrawer.classList.toggle('open');
            });
        }
        function closeMobileNav() {
            if (mobileNavDrawer) mobileNavDrawer.classList.remove('open');
        }



        // 7. Live 60fps Interactive Financial Constellation Canvas
        (function () {
            const canvas = document.getElementById('homeLiveCanvas');
            if (!canvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const ctx = canvas.getContext('2d');
            let w = canvas.width = window.innerWidth;
            let h = canvas.height = window.innerHeight;
            let mouse = { x: -9999, y: -9999 };

            window.addEventListener('resize', () => {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            });
            window.addEventListener('mousemove', (e) => {
                mouse.x = e.clientX;
                mouse.y = e.clientY;
            }, { passive: true });
            window.addEventListener('mouseleave', () => {
                mouse.x = -9999; mouse.y = -9999;
            });

            const count = Math.min(44, Math.floor((w * h) / 30000));
            const nodes = Array.from({ length: count }, (_, idx) => ({
                x: Math.random() * w,
                y: Math.random() * h,
                vx: (Math.random() - 0.5) * 0.4,
                vy: (Math.random() - 0.5) * 0.4,
                r: 1.4 + Math.random() * 1.6,
                color: idx % 2 === 0 ? '52, 211, 153' : '56, 189, 248'
            }));

            function tick() {
                ctx.clearRect(0, 0, w, h);
                for (let i = 0; i < nodes.length; i++) {
                    const n = nodes[i];
                    n.x += n.vx;
                    n.y += n.vy;
                    if (n.x < 0 || n.x > w) n.vx *= -1;
                    if (n.y < 0 || n.y > h) n.vy *= -1;

                    ctx.beginPath();
                    ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(${n.color}, 0.5)`;
                    ctx.fill();

                    for (let j = i + 1; j < nodes.length; j++) {
                        const m = nodes[j];
                        const d = Math.hypot(n.x - m.x, n.y - m.y);
                        if (d < 135) {
                            ctx.beginPath();
                            ctx.moveTo(n.x, n.y);
                            ctx.lineTo(m.x, m.y);
                            ctx.strokeStyle = `rgba(52, 211, 153, ${(1 - d / 135) * 0.16})`;
                            ctx.lineWidth = 1;
                            ctx.stroke();
                        }
                    }

                    const md = Math.hypot(n.x - mouse.x, n.y - mouse.y);
                    if (md < 170) {
                        ctx.beginPath();
                        ctx.moveTo(n.x, n.y);
                        ctx.lineTo(mouse.x, mouse.y);
                        ctx.strokeStyle = `rgba(56, 189, 248, ${(1 - md / 170) * 0.35})`;
                        ctx.lineWidth = 1.1;
                        ctx.stroke();
                    }
                }
                requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        })();
    </script>
</body>
</html>
