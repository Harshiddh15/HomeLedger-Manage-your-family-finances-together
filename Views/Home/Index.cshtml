    <!-- Section 3: Feature Comparison -->
    <section class="section-container" id="comparison">
        <div class="section-header">
            <span class="section-tag">Transparent Comparison</span>
            <h2 class="section-title">Why HomeLedger Outclasses Other Alternatives</h2>
            <p class="section-desc">See how HomeLedger compares against generic apps and paper diaries.</p>
        </div>

        <div class="table-container">
            <table class="comparison-table">
                <thead>
                    <tr>
                        <th style="width: 35%;">Key Capability</th>
                        <th style="width: 25%; color: var(--emerald-400);"><i class="fa-solid fa-vault"></i> HomeLedger</th>
                        <th style="width: 20%;">Splitwise / Khatabook</th>
                        <th style="width: 20%;">Paper Bahi-Khata / Excel</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Role-Based Privacy (Father Admin vs Members)</td>
                        <td style="color: var(--emerald-400); font-weight: 700;"><i class="fa-solid fa-circle-check"></i> Built-in Isolation</td>
                        <td style="color: #f43f5e;"><i class="fa-solid fa-circle-xmark"></i> Not Supported</td>
                        <td style="color: #f43f5e;"><i class="fa-solid fa-circle-xmark"></i> Open to Anyone</td>
                    </tr>
                    <tr>
                        <td>Separate Udhar (Lene/Dene) Ledger</td>
                        <td style="color: var(--emerald-400); font-weight: 700;"><i class="fa-solid fa-circle-check"></i> Dedicated Module</td>
                        <td style="color: var(--amber-400);"><i class="fa-solid fa-triangle-exclamation"></i> Only Split or Business</td>
                        <td style="color: var(--amber-400);"><i class="fa-solid fa-triangle-exclamation"></i> Prone to Calculation Errors</td>
                    </tr>
                    <tr>
                        <td>Consolidated Monthly Reports + Charts</td>
                        <td style="color: var(--emerald-400); font-weight: 700;"><i class="fa-solid fa-circle-check"></i> Visual &amp; Instant</td>
                        <td style="color: var(--amber-400);"><i class="fa-solid fa-triangle-exclamation"></i> Paywalled or Basic</td>
                        <td style="color: #f43f5e;"><i class="fa-solid fa-circle-xmark"></i> Manual Charting</td>
                    </tr>
                    <tr>
                        <td>Private Self-Hosted &amp; Zero Ad Tracking</td>
                        <td style="color: var(--emerald-400); font-weight: 700;"><i class="fa-solid fa-circle-check"></i> 100% Private Database</td>
                        <td style="color: #f43f5e;"><i class="fa-solid fa-circle-xmark"></i> Cloud Third-Party Ads</td>
                        <td style="color: var(--emerald-400);"><i class="fa-solid fa-circle-check"></i> Offline Only</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Section 4: High-Impact Call to Action Banner -->
    <section class="section-container" style="padding-top: 20px;">
        <div class="cta-banner">
            <h2 style="font-size: clamp(30px, 4vw, 44px); font-weight: 800; margin-bottom: 16px;">
                Bring Financial Clarity to Your Family Today.
            </h2>
            <p style="font-size: 17px; color: var(--text-secondary); max-width: 600px; margin: 0 auto 32px; line-height: 1.6;">
                Join hundreds of households tracking income, smart budgets, and Udhar with complete role protection. Setup takes less than 60 seconds.
            </p>
            <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
                    <i class="fa-solid fa-bolt"></i>
                    <span>Create Your Family Vault</span>
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-secondary btn-lg">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    <span>Sign In to Existing Account</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="landing-footer">
        <div style="display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; flex-wrap: wrap; gap: 20px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="brand-icon-box" style="width: 28px; height: 28px; font-size: 13px;">
                    <i class="fa-solid fa-vault"></i>
                </div>
                <span style="font-weight: 700; color: var(--text-primary);">HomeLedger</span>
                <span>— Secure Family Wealth OS</span>
            </div>
            <div>
                <span class="badge badge-emerald" style="text-transform: none; font-size: 11px;">
                    <i class="fa-solid fa-circle-check"></i> System Online &amp; Database Connected
                </span>
            </div>
            <div>
                <p style="margin: 0;">&copy; @DateTime.Now.Year HomeLedger. Engineered for Modern Households.</p>
            </div>
        </div>
    </footer>

    <!-- Interactive Script for Scenario Tabs -->
    <script>
        function switchScenario(key, btn) {
            document.querySelectorAll('.scenario-content').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.scenario-tab-btn').forEach(el => el.classList.remove('active'));
            const target = document.getElementById('scenario-' + key);
            if (target) {
                target.style.display = 'block';
                target.classList.add('animate-fade-in-up');
            }
            if (btn) btn.classList.add('active');
        }
    </script>
</body>
</html>
