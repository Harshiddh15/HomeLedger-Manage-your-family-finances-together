@{
    ViewData["Title"] = "HomeLedger — Modern Family Wealth & Shared Expense Intelligence";
    Layout = null;
    var isLoggedIn = Context.Session.GetInt32("FamilyDbId") != null;
    var loginType = Context.Session.GetString("LoginType");
    var dashboardAction = loginType == "Member" ? "MemberDashboard" : "Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Premium Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Master Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ========================================================
           LANDING PAGE MOTION & VISUAL ARCHITECTURE (1.35s ENTRANCE)
           ======================================================== */
        .landing-body {
            position: relative;
            overflow-x: hidden;
        }

        /* Subtle Top Kinetic Intro Sweep (Finishes in 1.25s, Non-Blocking) */
        .intro-kinetic-beam {
            position: fixed;
            top: 0;
            left: 0;
            height: 2.5px;
            width: 0%;
            z-index: 2000;
            background: linear-gradient(90deg, #10b981, #38bdf8, #818cf8);
            box-shadow: 0 0 14px rgba(16, 185, 129, 0.75);
            pointer-events: none;
            animation: kineticBeamSweep 1.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Live Scroll Progress Bar */
        .scroll-progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 2.5px;
            background: linear-gradient(90deg, #10b981, #38bdf8);
            transform-origin: 0% 50%;
            transform: scaleX(0);
            z-index: 1999;
            pointer-events: none;
        }

        /* Ambient Background Orbs (Light GPU-only motion) */
        .ambient-canvas {
            position: fixed;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: 0;
        }

        .ambient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(85px);
            opacity: 0.24;
            will-change: transform;
        }

        .ambient-orb-1 {
            width: 520px;
            height: 520px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.55), transparent 70%);
            top: -140px;
            left: 12%;
            animation: orbDriftOne 16s ease-in-out infinite alternate;
        }

        .ambient-orb-2 {
            width: 460px;
            height: 460px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.45), transparent 70%);
            top: 180px;
            right: 6%;
            animation: orbDriftTwo 19s ease-in-out infinite alternate;
        }

        .ambient-orb-3 {
            width: 380px;
            height: 380px;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.35), transparent 70%);
            bottom: 10%;
            left: 22%;
            animation: orbDriftOne 22s ease-in-out infinite alternate-reverse;
        }

        body.light-mode .ambient-orb {
            opacity: 0.16;
        }

        /* Header Navigation */
        .landing-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 14px 36px;
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: padding 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
            animation: headerSlideIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .landing-header.is-scrolled {
            padding: 11px 36px;
            box-shadow: var(--shadow-lg);
        }

        .landing-nav-links {
            display: flex;
            align-items: center;
            gap: 6px;
            list-style: none;
            background: var(--bg-glass-subtle);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-full);
            padding: 4px;
        }

        .landing-nav-links a {
            display: inline-block;
            padding: 7px 14px;
            border-radius: var(--radius-full);
            font-size: 13.5px;
            font-weight: 500;
            color: var(--text-muted);
            transition: color 0.2s ease, background-color 0.2s ease;
        }

        .landing-nav-links a:hover,
        .landing-nav-links a.active-link {
            color: var(--text-primary);
            background: rgba(16, 185, 129, 0.14);
        }

        .landing-nav-links a.active-link {
            color: var(--emerald-400);
            font-weight: 600;
        }

        /* Mobile Drawer for Landing Navigation */
        .mobile-nav-drawer {
            position: fixed;
            top: 66px;
            left: 16px;
            right: 16px;
            z-index: 999;
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-lg);
            padding: 18px;
            box-shadow: var(--shadow-xl);
            display: flex;
            flex-direction: column;
            gap: 10px;
            opacity: 0;
            transform: translateY(-12px) scale(0.98);
            pointer-events: none;
            transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .mobile-nav-drawer.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }

        .mobile-nav-drawer a {
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .mobile-nav-drawer a:hover {
            background: rgba(16, 185, 129, 0.12);
            color: var(--emerald-400);
        }

        /* ========================================================
           HERO SECTION & 1.35s CHOREOGRAPHED ENTRANCE
           ======================================================== */
        .hero-section {
            padding: 132px 24px 72px;
            max-width: 1240px;
            margin: 0 auto;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 18px;
            border-radius: var(--radius-full);
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.32);
            color: var(--emerald-400);
            font-size: 12.5px;
            font-weight: 600;
            margin-bottom: 24px;
            letter-spacing: 0.25px;
            opacity: 0;
            animation: heroPopUp 0.42s cubic-bezier(0.16, 1, 0.3, 1) 1.44s forwards;
        }

        body.light-mode .hero-badge {
            color: var(--emerald-600);
            background: rgba(16, 185, 129, 0.1);
        }

        .hero-title {
            font-size: clamp(36px, 5.4vw, 66px);
            font-weight: 800;
            line-height: 1.13;
            letter-spacing: -0.035em;
            margin-bottom: 22px;
            max-width: 940px;
            margin-left: auto;
            margin-right: auto;
        }

        .reveal-mask {
            display: block;
            overflow: hidden;
            padding-bottom: 4px;
        }

        .reveal-line-1 {
            display: block;
            opacity: 0;
            transform: translateY(105%);
            animation: maskLineRise 0.46s cubic-bezier(0.16, 1, 0.3, 1) 1.48s forwards;
        }

        .reveal-line-2 {
            display: block;
            opacity: 0;
            transform: translateY(105%);
            animation: maskLineRise 0.48s cubic-bezier(0.16, 1, 0.3, 1) 1.56s forwards;
        }

        .hero-subtitle {
            font-size: clamp(16px, 1.8vw, 18.5px);
            color: var(--text-muted);
            max-width: 710px;
            margin: 0 auto 34px;
            line-height: 1.65;
            opacity: 0;
            transform: translateY(20px);
            animation: heroGlideUp 0.44s cubic-bezier(0.16, 1, 0.3, 1) 1.64s forwards;
        }

        .hero-cta-group {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 38px;
            opacity: 0;
            transform: translateY(18px) scale(0.97);
            animation: heroPopUp 0.42s cubic-bezier(0.16, 1, 0.3, 1) 1.72s forwards;
        }

        /* Magnetic Shine Micro-Interaction on Primary CTA */
        .btn-shine {
            position: relative;
            overflow: hidden;
        }

        .btn-shine::after {
            content: '';
            position: absolute;
            top: 0;
            left: -120%;
            width: 60%;
            height: 100%;
            background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.28), transparent);
            transition: left 0.55s ease;
        }

        .btn-shine:hover::after {
            left: 140%;
        }

        .trust-pills {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 22px;
            flex-wrap: wrap;
            font-size: 13px;
            color: var(--text-muted);
            opacity: 0;
            transform: translateY(14px);
            animation: heroGlideUp 0.42s cubic-bezier(0.16, 1, 0.3, 1) 1.78s forwards;
        }

        .trust-pill-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* 3D Interactive Glass Dashboard Mockup (Unfolds ~1.58s -> 2.10s) */
        .mockup-wrapper {
            position: relative;
            max-width: 1040px;
            margin: 48px auto 0;
            perspective: 1400px;
            opacity: 0;
            transform: perspective(1200px) rotateX(10deg) translateY(38px) scale(0.96);
            animation: mockupUnfold 0.52s cubic-bezier(0.16, 1, 0.3, 1) 1.58s forwards;
            will-change: transform, opacity;
        }

        @@property --home-beam {
            syntax: '<angle>';
            initial-value: 0deg;
            inherits: false;
        }

        .mockup-beam-shell {
            padding: 1.5px;
            border-radius: calc(var(--radius-xl) + 1.5px);
            background: conic-gradient(from var(--home-beam), transparent 0deg, transparent 260deg, rgba(16, 185, 129, 0.8) 315deg, rgba(56, 189, 248, 0.9) 345deg, transparent 360deg);
            animation: homeBeamOrbit 6s linear infinite;
            box-shadow: var(--shadow-xl), 0 0 54px rgba(16, 185, 129, 0.14);
        }

        .mockup-card {
            background: var(--bg-card);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-xl);
            overflow: hidden;
            text-align: left;
            transition: transform 0.22s ease-out, box-shadow 0.35s ease;
            transform-style: preserve-3d;
        }

        #homeLiveCanvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .live-pulse-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: liveBeacon 1.8s infinite;
        }

        .sparkline-draw {
            stroke-dasharray: 420;
            stroke-dashoffset: 420;
            animation: sparkDraw 1.5s cubic-bezier(0.22, 1, 0.36, 1) 1.75s forwards;
        }

        @@keyframes homeBeamOrbit {
            from { --home-beam: 0deg; }
            to { --home-beam: 360deg; }
        }

        @@keyframes liveBeacon {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        @@keyframes sparkDraw {
            to { stroke-dashoffset: 0; }
        }

        .mockup-header-bar {
            padding: 14px 22px;
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        .browser-dots {
            display: flex;
            gap: 7px;
        }

        .browser-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .mockup-tx-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 14px;
            background: var(--bg-glass-subtle);
            border: 1px solid transparent;
            border-radius: var(--radius-sm);
            opacity: 0;
            transform: translateX(-12px);
            transition: border-color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
        }

        .mockup-tx-row:hover {
            border-color: var(--border-card);
            background: rgba(16, 185, 129, 0.06);
        }

        .mockup-tx-1 { animation: txSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) 1.70s forwards; }
        .mockup-tx-2 { animation: txSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) 1.80s forwards; }
        .mockup-tx-3 { animation: txSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) 1.90s forwards; }

        .replay-intro-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            border: 1px solid var(--border-card);
            background: var(--bg-glass-subtle);
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .replay-intro-btn:hover {
            color: var(--emerald-400);
            border-color: var(--emerald-400);
            background: rgba(16, 185, 129, 0.1);
        }

        /* ========================================================
           PAGE SECTIONS & CARDS
           ======================================================== */
        .section-container {
            padding: 86px 24px;
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .section-header {
            text-align: center;
            max-width: 680px;
            margin: 0 auto 52px;
        }

        .section-tag {
            font-size: 12px;
            font-weight: 700;
            color: var(--emerald-400);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            display: inline-block;
        }

        body.light-mode .section-tag {
            color: var(--emerald-600);
        }

        .section-title {
            font-size: clamp(28px, 3.5vw, 40px);
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 14px;
        }

        .section-desc {
            font-size: 16px;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .pillars-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 22px;
        }

        .pillar-card {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-lg);
            padding: 30px 26px;
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.28s ease, box-shadow 0.28s ease;
            position: relative;
        }

        .pillar-card:hover {
            transform: translateY(-6px);
            border-color: rgba(16, 185, 129, 0.45);
            box-shadow: 0 18px 36px -10px rgba(16, 185, 129, 0.18);
        }

        .pillar-icon-box {
            width: 52px;
            height: 52px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 18px;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .pillar-card:hover .pillar-icon-box {
            transform: scale(1.08) rotate(-3deg);
        }

        /* ========================================================
           CONFIDENTIAL PRIVACY SHIELD FOR HERO MOCKUP
           ======================================================== */
        .mockup-privacy-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 11px;
            border-radius: var(--radius-full);
            border: 1px solid var(--border-card);
            background: var(--bg-surface-elevated);
            color: var(--text-muted);
            font-size: 11.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .mockup-privacy-btn:hover {
            color: var(--emerald-400);
            border-color: var(--emerald-400);
            background: rgba(16, 185, 129, 0.12);
        }

        .confidential-num {
            transition: filter 0.28s ease, opacity 0.28s ease;
        }

        .privacy-masked .confidential-num {
            filter: blur(6px);
            user-select: none;
            opacity: 0.6;
        }

        .mockup-card.privacy-masked:hover .confidential-num {
            filter: blur(0);
            opacity: 1;
        }

        .comparison-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            border-radius: var(--radius-lg);
            overflow: hidden;
            border: 1px solid var(--border-card);
            background: var(--bg-card);
        }

        .comparison-table th, .comparison-table td {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-subtle);
            text-align: center;
            font-size: 14px;
        }

        .comparison-table th:first-child, .comparison-table td:first-child {
            text-align: left;
            font-weight: 600;
        }

        .comparison-table th {
            background: var(--bg-surface);
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .cta-banner {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.16) 0%, rgba(99, 102, 241, 0.16) 100%);
            border: 1px solid rgba(16, 185, 129, 0.32);
            border-radius: var(--radius-xl);
            padding: 58px 36px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        /* Structured Agency Footer */
        .landing-footer {
            padding: 56px 24px 36px;
            border-top: 1px solid var(--border-subtle);
            background: var(--bg-surface);
            color: var(--text-muted);
            font-size: 13.5px;
            position: relative;
            z-index: 1;
        }

        .footer-grid {
            max-width: 1200px;
            margin: 0 auto 36px;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 32px;
        }

        .footer-col h4 {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-primary);
            margin-bottom: 14px;
        }

        .footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .footer-col a {
            color: var(--text-muted);
            font-size: 13.5px;
        }

        .footer-col a:hover {
            color: var(--emerald-400);
        }

        /* ========================================================
           CHOREOGRAPHED KEYFRAMES (ALL FINISH <= 1.35s)
           ======================================================== */
        @@keyframes kineticBeamSweep {
            0% { width: 0%; opacity: 1; }
            82% { width: 100%; opacity: 1; }
            100% { width: 100%; opacity: 0; }
        }

        @@keyframes headerSlideIn {
            from { opacity: 0; transform: translateY(-16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes maskLineRise {
            from { opacity: 0; transform: translateY(105%); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes heroGlideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes heroPopUp {
            from { opacity: 0; transform: translateY(16px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        @@keyframes mockupUnfold {
            from {
                opacity: 0;
                transform: perspective(1200px) rotateX(10deg) translateY(38px) scale(0.96);
            }
            to {
                opacity: 1;
                transform: perspective(1200px) rotateX(0deg) translateY(0) scale(1);
            }
        }

        @@keyframes txSlideIn {
            from { opacity: 0; transform: translateX(-12px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @@keyframes orbDriftOne {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(40px, 28px) scale(1.08); }
        }

        @@keyframes orbDriftTwo {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(-36px, 22px) scale(1.06); }
        }

        /* Replay trigger utility */
        .replay-reset .intro-kinetic-beam,
        .replay-reset .hero-badge,
        .replay-reset .reveal-line-1,
        .replay-reset .reveal-line-2,
        .replay-reset .hero-subtitle,
        .replay-reset .hero-cta-group,
        .replay-reset .trust-pills,
        .replay-reset .mockup-wrapper,
        .replay-reset .mockup-tx-row {
            animation: none !important;
        }

        /* Responsive Adjustments */
        @@media (max-width: 900px) {
            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 640px) {
            .landing-header {
                padding: 12px 18px;
            }
            .landing-header.is-scrolled {
                padding: 10px 18px;
            }
            .hero-section {
                padding: 108px 16px 56px;
            }
            .footer-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="landing-body">
    @await Html.PartialAsync("_HomeIntroOverlay", new ViewDataDictionary(ViewData) { { "AlwaysShowHomeIntro", true } })

    <!-- Top Kinetic Entrance Beam + Scroll Progress -->
    <div class="intro-kinetic-beam" id="kineticBeam"></div>
    <div class="scroll-progress-bar" id="scrollProgress"></div>

    <!-- Subtle Floating Ambient Background Orbs + Live Constellation Canvas -->
    <div class="ambient-canvas" aria-hidden="true">
        <div class="ambient-orb ambient-orb-1"></div>
        <div class="ambient-orb ambient-orb-2"></div>
        <div class="ambient-orb ambient-orb-3"></div>
    </div>
    <canvas id="homeLiveCanvas" aria-hidden="true"></canvas>

    <!-- Top Landing Header -->
    <header class="landing-header" id="landingHeader">
        <div class="brand-wrapper">
            <a asp-controller="Home" asp-action="Landing" class="brand-logo">
                <div class="brand-icon-box">
                    <i class="fa-solid fa-vault"></i>
                </div>
                <div>
                    <span>Home<span style="color: var(--emerald-400);">Ledger</span></span>
                    <small style="display: block; font-size: 10px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.8px;">Family Wealth OS</small>
                </div>
            </a>
        </div>

