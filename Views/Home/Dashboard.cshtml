@model DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
    Layout = "_Layout";
    var familyName = Context.Session.GetString("FamilyName") ?? "Family";
    var netSavings = Model.TotalIncome - Model.TotalExpense;
    var savingsRate = Model.TotalIncome > 0 ? (netSavings / Model.TotalIncome) * 100 : 0;
}

<div class="dashboard-wrapper">
    <!-- Header Greeting with Quick Actions -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                <h1 style="font-size: 26px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                    Welcome back, <span class="gradient-text-emerald">@familyName</span>
                </h1>
                <span class="badge badge-emerald" style="font-size: 11px;">
                    <i class="fa-solid fa-crown"></i> Family Head
                </span>
            </div>
            <p style="color: var(--text-muted); font-size: 14px; margin: 0;">
                Consolidated household wealth terminal &bull; @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </p>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a asp-controller="Income" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-plus"></i>
                <span>Add Income</span>
            </a>
            <a asp-controller="Expense" asp-action="Create" class="btn btn-secondary btn-sm">
                <i class="fa-solid fa-minus"></i>
                <span>Add Expense</span>
            </a>
            <a asp-controller="Report" asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Reports</span>
            </a>
        </div>
    </div>

    <!-- 5 Glass KPI Stat Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 18px; margin-bottom: 30px;">
        <!-- Card 1: Remaining Balance -->
        <div class="glass-card" style="padding: 22px; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">Remaining Balance</span>
                <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-wallet"></i>
                </div>
            </div>
            <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: var(--emerald-400); margin-bottom: 6px;">
                ₹@Model.RemainingBalance.ToString("N2")
            </h2>
            <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-dim);">
                <span style="color: var(--emerald-400); font-weight: 600;">@savingsRate.ToString("0.0")%</span>
                <span>net retention rate</span>
            </div>
        </div>

        <!-- Card 2: Total Income -->
        <div class="glass-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">Total Income</span>
                <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(14, 165, 233, 0.15); color: #0ea5e9; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
            </div>
            <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: var(--text-primary); margin-bottom: 6px;">
                ₹@Model.TotalIncome.ToString("N2")
            </h2>
            <div style="font-size: 12px; color: var(--text-dim);">
                Household earnings &amp; salaries
            </div>
        </div>

        <!-- Card 3: Total Expenses -->
        <div class="glass-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">Total Expenses</span>
                <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(244, 63, 94, 0.15); color: #f43f5e; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-arrow-trend-down"></i>
                </div>
            </div>
            <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: #fb7185; margin-bottom: 6px;">
                ₹@Model.TotalExpense.ToString("N2")
            </h2>
            <div style="font-size: 12px; color: var(--text-dim);">
                Groceries, bills &amp; education
            </div>
        </div>

        <!-- Card 4: Udhar to Receive -->
        <div class="glass-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">To Receive (Lene Hai)</span>
                <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(56, 189, 248, 0.15); color: #38bdf8; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
            </div>
            <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: #38bdf8; margin-bottom: 6px;">
                ₹@Model.TotalLene.ToString("N2")
            </h2>
            <div style="font-size: 12px; color: var(--text-dim);">
                Receivables &amp; lent money
            </div>
        </div>

        <!-- Card 5: Udhar to Pay -->
        <div class="glass-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">To Pay (Dene Hai)</span>
                <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(245, 158, 11, 0.15); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
            </div>
            <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: #fbbf24; margin-bottom: 6px;">
                ₹@Model.TotalDene.ToString("N2")
            </h2>
            <div style="font-size: 12px; color: var(--text-dim);">
                Pending credit &amp; shop dues
            </div>
        </div>
    </div>

    <!-- Admin Available Functions Grid -->
    <div style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
            <h3 style="font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin: 0;">
                <i class="fa-solid fa-bolt" style="color: var(--emerald-400); margin-right: 8px;"></i>
                Admin Command Suite
            </h3>
            <span style="font-size: 12px; color: var(--text-dim);">Quick workspace shortcuts</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;">
            <a asp-controller="Income" asp-action="Create" class="glass-card" style="padding: 18px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <div>
                    <h4 style="font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0;">Add Income</h4>
                    <small style="color: var(--text-dim); font-size: 11px;">Record salary or earnings</small>
                </div>
            </a>

            <a asp-controller="Expense" asp-action="Create" class="glass-card" style="padding: 18px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(244, 63, 94, 0.15); color: #f43f5e; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <i class="fa-solid fa-minus"></i>
                </div>
                <div>
                    <h4 style="font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0;">Add Expense</h4>
                    <small style="color: var(--text-dim); font-size: 11px;">Log household spend</small>
                </div>
            </a>

            <a asp-controller="Udhar" asp-action="Index" class="glass-card" style="padding: 18px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(245, 158, 11, 0.15); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
                <div>
                    <h4 style="font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0;">Udhar Ledger</h4>
                    <small style="color: var(--text-dim); font-size: 11px;">Lene &amp; Dene bahi-khata</small>
                </div>
            </a>

            <a asp-controller="Report" asp-action="Index" class="glass-card" style="padding: 18px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(14, 165, 233, 0.15); color: #0ea5e9; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
                <div>
                    <h4 style="font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0;">View Reports</h4>
                    <small style="color: var(--text-dim); font-size: 11px;">Monthly &amp; yearly charts</small>
                </div>
            </a>

            <a asp-controller="Budget" asp-action="Index" class="glass-card" style="padding: 18px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(99, 102, 241, 0.15); color: #6366f1; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <i class="fa-solid fa-wallet"></i>
                </div>
                <div>
                    <h4 style="font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0;">Family Budget</h4>
                    <small style="color: var(--text-dim); font-size: 11px;">Monthly spend caps</small>
                </div>
            </a>

            <a asp-controller="Member" asp-action="Index" class="glass-card" style="padding: 18px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(168, 85, 247, 0.15); color: #a855f7; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <h4 style="font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0;">Manage Members</h4>
                    <small style="color: var(--text-dim); font-size: 11px;">Passwords &amp; access keys</small>
                </div>
            </a>
        </div>
    </div>

    <!-- Recent Activities & Financial Health Overview -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 24px;">
        <!-- Left: Recent Household Transactions -->
        <div class="glass-card">
            <div class="glass-card-header">
                <div>
                    <h3 style="font-size: 15px; margin: 0; font-weight: 700;">
                        <i class="fa-solid fa-clock-rotate-left" style="color: var(--emerald-400); margin-right: 8px;"></i>
                        Recent Household Activities
                    </h3>
                    <small style="color: var(--text-dim); font-size: 12px;">Latest financial movements</small>
                </div>
                <a asp-controller="Expense" asp-action="Index" class="btn btn-secondary btn-sm">View All</a>
            </div>
            <div class="glass-card-body" style="padding: 0;">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Transaction</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th style="text-align: right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var act in Model.RecentActivities)
                            {
                                <tr>
                                    <td>
                                        <strong style="font-size: 13.5px; color: var(--text-primary); display: block;">@act.Title</strong>
                                    </td>
                                    <td>
                                        @if (act.Type == "Income")
                                        {
                                            <span class="badge badge-emerald">
                                                <i class="fa-solid fa-arrow-up"></i> Income
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-rose">
                                                <i class="fa-solid fa-arrow-down"></i> Expense
                                            </span>
                                        }
                                    </td>
                                    <td style="color: var(--text-muted); font-size: 13px;">@act.Date.ToString("dd MMM yyyy")</td>
                                    <td style="text-align: right; font-weight: 700; font-family: var(--font-mono); color: @(act.Type == "Income" ? "var(--emerald-400)" : "#fb7185");">
                                        @(act.Type == "Income" ? "+" : "-")₹@act.Amount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align: center; padding: 40px 20px; color: var(--text-muted);">
                        <i class="fa-solid fa-receipt" style="font-size: 32px; opacity: 0.4; margin-bottom: 10px; display: block;"></i>
                        <p style="margin: 0;">No transactions recorded yet this month.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Family Health & Summary -->
        <div class="glass-card" style="padding: 24px;">
            <h3 style="font-size: 15px; margin: 0 0 16px; font-weight: 700;">
                <i class="fa-solid fa-shield-halved" style="color: var(--indigo-400); margin-right: 8px;"></i>
                Household Financial Health
            </h3>

            <!-- Progress Bar of Savings vs Expense -->
            <div style="margin-bottom: 24px;">
                <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 8px;">
                    <span style="color: var(--text-secondary); font-weight: 600;">Monthly Budget Utilization</span>
                    <span style="font-weight: 700; color: var(--text-primary);">
                        @(Model.TotalIncome > 0 ? ((Model.TotalExpense / Model.TotalIncome) * 100).ToString("0.0") : "0")%
                    </span>
                </div>
                <div style="height: 8px; border-radius: var(--radius-full); background: rgba(255, 255, 255, 0.08); overflow: hidden;">
                    <div style="height: 100%; border-radius: var(--radius-full); background: linear-gradient(90deg, #10b981, #f43f5e); width: @(Model.TotalIncome > 0 ? Math.Min(100, (Model.TotalExpense / Model.TotalIncome) * 100).ToString("0") : "0")%;"></div>
                </div>
            </div>

            <!-- Highlights Checklist -->
            <div style="display: flex; flex-direction: column; gap: 14px;">
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-circle-check" style="color: var(--emerald-400);"></i>
                        <span style="font-size: 13px; color: var(--text-secondary);">Role Security Active</span>
                    </div>
                    <span class="badge badge-emerald" style="font-size: 10px;">Protected</span>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-database" style="color: var(--cyan-400);"></i>
                        <span style="font-size: 13px; color: var(--text-secondary);">MySQL Database Vault</span>
                    </div>
                    <span class="badge badge-cyan" style="font-size: 10px;">Online</span>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-file-pdf" style="color: var(--indigo-400);"></i>
                        <span style="font-size: 13px; color: var(--text-secondary);">Monthly Audit Ready</span>
                    </div>
                    <a asp-controller="Report" asp-action="MonthlyReport" class="btn btn-secondary btn-sm" style="padding: 4px 10px; font-size: 11px;">Generate</a>
                </div>
            </div>
        </div>
    </div>
</div>
