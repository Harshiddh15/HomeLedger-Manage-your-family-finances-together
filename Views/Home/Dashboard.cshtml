@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
    var loginType = Context.Session.GetString("LoginType");
    var isAdmin = loginType == "Admin";
}

<style>
    .dashboard-wrapper {
        padding: 10px 0;
    }

    .page-title {
        font-size: 26px;
        font-weight: 800;
        margin-bottom: 30px;
        color: var(--hud-text-white);
        letter-spacing: 1px;
        font-family: 'JetBrains Mono', monospace;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .page-title::before {
        content: '//';
        color: var(--hud-cyan);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        position: relative;
        background: var(--hud-bg-card);
        backdrop-filter: blur(8px);
        border-radius: 6px;
        padding: 22px;
        border: 1px solid var(--hud-border);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        gap: 18px;
        transition: all 0.3s ease;
    }

    .stat-card::before, .stat-card::after {
        content: '';
        position: absolute;
        width: 10px;
        height: 10px;
        pointer-events: none;
    }

    .stat-card::before {
        top: 0;
        left: 0;
        border-top: 2px solid var(--hud-cyan);
        border-left: 2px solid var(--hud-cyan);
    }

    .stat-card::after {
        bottom: 0;
        right: 0;
        border-bottom: 2px solid var(--hud-cyan);
        border-right: 2px solid var(--hud-cyan);
    }

    .stat-card:hover {
        transform: translateY(-4px);
        border-color: var(--hud-cyan);
        box-shadow: 0 8px 30px rgba(0, 229, 255, 0.2);
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .stat-icon.balance {
        background: rgba(0, 229, 255, 0.12);
        color: var(--hud-cyan);
        border: 1px solid var(--hud-cyan);
        box-shadow: 0 0 12px rgba(0, 229, 255, 0.3);
    }

    .stat-icon.income {
        background: rgba(16, 185, 129, 0.12);
        color: var(--hud-teal);
        border: 1px solid var(--hud-teal);
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
    }

    .stat-icon.expense {
        background: rgba(244, 63, 94, 0.12);
        color: var(--hud-rose);
        border: 1px solid var(--hud-rose);
        box-shadow: 0 0 12px rgba(244, 63, 94, 0.3);
    }

    .stat-icon.lene {
        background: rgba(245, 158, 11, 0.12);
        color: var(--hud-amber);
        border: 1px solid var(--hud-amber);
        box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);
    }

    .stat-icon.dene {
        background: rgba(168, 85, 247, 0.12);
        color: var(--hud-purple);
        border: 1px solid var(--hud-purple);
        box-shadow: 0 0 12px rgba(168, 85, 247, 0.3);
    }

    .stat-details h4 {
        font-size: 11px;
        color: var(--hud-text-muted);
        margin-bottom: 4px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .stat-details h2 {
        font-size: 22px;
        font-weight: 800;
        color: var(--hud-text-white);
        font-family: 'JetBrains Mono', monospace;
    }

    .card {
        background: var(--hud-bg-card);
        border-radius: 6px;
        border: 1px solid var(--hud-border);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        overflow: hidden;
    }

    .card-header {
        background-color: var(--hud-bg-card-header);
        color: var(--hud-text-white);
        padding: 16px 24px;
        border-bottom: 1px solid var(--hud-border);
    }

    .card-header h3 {
        font-size: 15px;
        font-weight: 700;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--hud-cyan);
    }

    .table-responsive {
        padding: 16px 24px;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    th {
        text-align: left;
        padding: 12px 16px;
        color: var(--hud-cyan);
        background-color: rgba(15, 24, 38, 0.9);
        font-weight: 700;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 1px solid var(--hud-border-cyan);
    }

    td {
        padding: 16px 16px;
        border-bottom: 1px solid rgba(30, 45, 66, 0.6);
        font-size: 14px;
        color: var(--hud-text-white);
    }

    tr:last-child td {
        border-bottom: none;
    }

    .badge {
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .badge-success {
        background: rgba(16, 185, 129, 0.15);
        color: var(--hud-teal);
        border: 1px solid var(--hud-teal);
    }

    .badge-danger {
        background: rgba(244, 63, 94, 0.15);
        color: var(--hud-rose);
        border: 1px solid var(--hud-rose);
    }
</style>

<div class="dashboard-wrapper">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h1 class="page-title" style="margin-bottom: 0;">Overview Dashboard</h1>
        @if (isAdmin)
        {
            <div style="padding: 8px 16px; background: rgba(0, 229, 255, 0.15); border: 1px solid var(--hud-cyan); border-radius: 4px; color: var(--hud-cyan); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">
                <i class="fa-solid fa-user-shield"></i> Admin Access
            </div>
        }
        else
        {
            <div style="padding: 8px 16px; background: rgba(168, 85, 247, 0.15); border: 1px solid var(--hud-purple); border-radius: 4px; color: var(--hud-purple); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">
                <i class="fa-solid fa-user"></i> Member Access
            </div>
        }
    </div>
    
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon balance">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div class="stat-details">
                <h4>Remaining Balance</h4>
                <h2>₹@Model.RemainingBalance.ToString("N2")</h2>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon income">
                <i class="fa-solid fa-arrow-trend-up"></i>
            </div>
            <div class="stat-details">
                <h4>Total Income</h4>
                <h2>₹@Model.TotalIncome.ToString("N2")</h2>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon expense">
                <i class="fa-solid fa-arrow-trend-down"></i>
            </div>
            <div class="stat-details">
                <h4>Total Expense</h4>
                <h2>₹@Model.TotalExpense.ToString("N2")</h2>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon lene">
                <i class="fa-solid fa-hand-holding-dollar"></i>
            </div>
            <div class="stat-details">
                <h4>To Receive</h4>
                <h2>₹@Model.TotalLene.ToString("N2")</h2>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon dene">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <div class="stat-details">
                <h4>To Pay</h4>
                <h2>₹@Model.TotalDene.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Recent Activities</h3>
        </div>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Description/Category</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentActivities.Any())
                    {
                        @foreach (var act in Model.RecentActivities)
                        {
                            <tr>
                                <td>@act.Date.ToString("d MMM yyyy")</td>
                                <td>
                                    @if (act.Type == "Income")
                                    {
                                        <span class="badge badge-success">Income</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Expense</span>
                                    }
                                </td>
                                <td>@act.Title</td>
                                <td style="font-weight: 600; color: @(act.Type == "Income" ? "#11998e" : "#eb3349")">
                                    @(act.Type == "Income" ? "+" : "-") ₹@act.Amount.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center;">No recent activities found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
