@model DashboardViewModel
@{
    ViewData["Title"] = "Member Financial Portal";
    Layout = "_Layout";
    var memberName = ViewBag.MemberName as string ?? Context.Session.GetString("MemberName") ?? "Member";
    var familyName = ViewBag.FamilyName as string ?? Context.Session.GetString("FamilyName") ?? "Family";
}

<div class="member-portal-wrapper">
    <!-- Member Header Banner -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 26px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                <h1 style="font-size: 26px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                    Welcome, <span class="gradient-text-indigo">@memberName</span>
                </h1>
                <span class="badge badge-indigo">
                    <i class="fa-solid fa-user-check"></i> Member Session
                </span>
            </div>
            <p style="color: var(--text-muted); font-size: 14px; margin: 0;">
                Family: <strong style="color: var(--text-primary);">@familyName</strong> &bull; Personal Ledger Workspace
            </p>
        </div>

        <div style="display: flex; gap: 10px;">
            <div class="badge badge-amber" style="padding: 8px 14px; font-size: 11.5px; gap: 6px;">
                <i class="fa-solid fa-lock"></i> Admin Suite Protected
            </div>
        </div>
    </div>

    <!-- Security & Isolation Reassurance Card -->
    <div class="glass-card" style="padding: 20px 24px; margin-bottom: 28px; border-left: 4px solid #f59e0b; background: rgba(245, 158, 11, 0.04);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: rgba(245, 158, 11, 0.15); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <h3 style="font-size: 15px; font-weight: 700; color: #fbbf24; margin: 0 0 4px;">
                    Personal Ledger Active &bull; Family Administration Locked
                </h3>
                <p style="margin: 0; font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;">
                    Aap Member Login ke tahat <strong>@memberName</strong> ke roop mein active hain. Family budget allocation, member password management, aur database backups <strong>Family Admin</strong> ke liye reserved hain. Aap bina kisi rok-tok ke apni personal income, kharche aur udhar add kar sakte hain.
                </p>
            </div>
        </div>
    </div>

    <!-- Member's Personal KPI Stat Grid -->
    <div style="margin-bottom: 30px;">
        <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 14px;">
            <i class="fa-solid fa-chart-simple" style="color: var(--emerald-400); margin-right: 6px;"></i>
            My Personal Financial Contributions (@memberName)
        </h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 18px;">
            <!-- Personal Income -->
            <div class="glass-card" style="padding: 22px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">My Income</span>
                    <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                    </div>
                </div>
                <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: var(--emerald-400); margin-bottom: 6px;">
                    ₹@Model.TotalIncome.ToString("N2")
                </h2>
                <small style="color: var(--text-dim); font-size: 11px;">Earnings by @memberName</small>
            </div>

            <!-- Personal Expenses -->
            <div class="glass-card" style="padding: 22px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">My Expenses</span>
                    <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(244, 63, 94, 0.15); color: #f43f5e; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                        <i class="fa-solid fa-arrow-trend-down"></i>
                    </div>
                </div>
                <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: #fb7185; margin-bottom: 6px;">
                    ₹@Model.TotalExpense.ToString("N2")
                </h2>
                <small style="color: var(--text-dim); font-size: 11px;">Spent by @memberName</small>
            </div>

            <!-- Personal Udhar to Pay -->
            <div class="glass-card" style="padding: 22px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">My Udhar (Dene Hai)</span>
                    <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(245, 158, 11, 0.15); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>
                <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: #fbbf24; margin-bottom: 6px;">
                    ₹@Model.TotalDene.ToString("N2")
                </h2>
                <small style="color: var(--text-dim); font-size: 11px;">Payable balance</small>
            </div>

            <!-- Personal Udhar to Receive -->
            <div class="glass-card" style="padding: 22px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted);">My Udhar (Lene Hai)</span>
                    <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(56, 189, 248, 0.15); color: #38bdf8; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </div>
                </div>
                <h2 class="currency-amount" style="font-size: 26px; font-weight: 800; color: #38bdf8; margin-bottom: 6px;">
                    ₹@Model.TotalLene.ToString("N2")
                </h2>
                <small style="color: var(--text-dim); font-size: 11px;">Receivable balance</small>
            </div>
        </div>
    </div>

    <!-- Member Available Functions Grid -->
    <div style="margin-bottom: 30px;">
        <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 14px;">
            <i class="fa-solid fa-bolt" style="color: var(--indigo-400); margin-right: 6px;"></i>
            Member Available Functions
        </h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
            <a asp-controller="Expense" asp-action="Create" class="glass-card" style="padding: 20px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: rgba(244, 63, 94, 0.15); color: #f43f5e; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                    <i class="fa-solid fa-minus"></i>
                </div>
                <div>
                    <h4 style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0 0 2px;">Add Expense</h4>
                    <small style="color: var(--text-dim); font-size: 12px;">Log your personal spend</small>
                </div>
            </a>

            <a asp-controller="Income" asp-action="Create" class="glass-card" style="padding: 20px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <div>
                    <h4 style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0 0 2px;">Add Income</h4>
                    <small style="color: var(--text-dim); font-size: 12px;">Log your earnings</small>
                </div>
            </a>

            <a asp-controller="Udhar" asp-action="Index" class="glass-card" style="padding: 20px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: rgba(245, 158, 11, 0.15); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
                <div>
                    <h4 style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0 0 2px;">Udhar Ledger</h4>
                    <small style="color: var(--text-dim); font-size: 12px;">View your personal credits</small>
                </div>
            </a>

            <a asp-controller="Report" asp-action="Index" class="glass-card" style="padding: 20px; text-decoration: none; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: rgba(56, 189, 248, 0.15); color: #38bdf8; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
                <div>
                    <h4 style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0 0 2px;">View Reports</h4>
                    <small style="color: var(--text-dim); font-size: 12px;">Visual monthly charts</small>
                </div>
            </a>
        </div>
    </div>

    <!-- Member Recent Transactions Feed -->
    <div class="glass-card">
        <div class="glass-card-header">
            <div>
                <h3 style="font-size: 15px; margin: 0; font-weight: 700;">
                    <i class="fa-solid fa-clock-rotate-left" style="color: var(--indigo-400); margin-right: 8px;"></i>
                    My Recent Transactions (@memberName)
                </h3>
                <small style="color: var(--text-dim); font-size: 12px;">Your personal recorded entries</small>
            </div>
        </div>
        <div class="glass-card-body" style="padding: 0;">
            @if (Model.RecentActivities != null && Model.RecentActivities.Any())
            {
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th style="text-align: right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var act in Model.RecentActivities)
                        {
                            <tr>
                                <td>
                                    <strong style="font-size: 13.5px; color: var(--text-primary); display: block;">@act.Title</strong>
                                </td>
                                <td>
                                    @if (act.Type == "Income")
                                    {
                                        <span class="badge badge-emerald">Income</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-rose">Expense</span>
                                    }
                                </td>
                                <td style="color: var(--text-muted); font-size: 13px;">@act.Date.ToString("dd MMM yyyy")</td>
                                <td style="text-align: right; font-weight: 700; font-family: var(--font-mono); color: @(act.Type == "Income" ? "var(--emerald-400)" : "#fb7185");">
                                    @(act.Type == "Income" ? "+" : "-")₹@act.Amount.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="text-align: center; padding: 40px 20px; color: var(--text-muted);">
                    <i class="fa-solid fa-receipt" style="font-size: 32px; opacity: 0.4; margin-bottom: 10px; display: block;"></i>
                    <p style="margin: 0;">No personal transactions recorded yet for @memberName.</p>
                </div>
            }
        </div>
    </div>
</div>
