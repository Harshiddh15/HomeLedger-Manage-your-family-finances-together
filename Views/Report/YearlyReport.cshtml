@using FinanceManagementNet.Models
@model YearlyReportViewModel
@{
    ViewData["Title"] = "Yearly Report";
    Layout = "_Layout";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
    <h1 class="page-title" style="font-size: 24px; font-weight: 800; color: var(--hud-text-white); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 1px; margin: 0;">
        <span style="color: var(--hud-cyan); margin-right: 8px;">//</span> Yearly Report — @Model.Year
    </h1>

    <!-- Quick Year Selector -->
    <form asp-action="YearlyReport" method="get" style="display: flex; gap: 10px; align-items: center;">
        <select name="year" class="form-control" style="width: auto; min-width: 120px; padding: 6px 12px; background: #0f1826; color: #fff; border: 1px solid var(--hud-border-cyan);">
            @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
            {
                <option value="@y" selected="@(y == Model.Year)">@y</option>
            }
        </select>
        <button type="submit" class="btn btn-primary" style="padding: 6px 16px;">
            <i class="fa-solid fa-filter"></i> Apply
        </button>
    </form>
</div>

<!-- 1. Top Summary KPI Cards (Existing Kept) -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px;">
    <div class="card" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white; box-shadow: 0 8px 24px rgba(17, 153, 142, 0.25);">
        <div class="card-body" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <h3 style="margin: 0; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Total Income (@Model.Year)</h3>
                <i class="fa-solid fa-arrow-trend-up" style="font-size: 20px; opacity: 0.85;"></i>
            </div>
            <p style="margin: 0; font-size: 30px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">₹@Model.TotalIncome.ToString("N2")</p>
            <small style="opacity: 0.85; font-size: 12px;">Full annual income</small>
        </div>
    </div>
    <div class="card" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); color: white; box-shadow: 0 8px 24px rgba(235, 51, 73, 0.25);">
        <div class="card-body" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <h3 style="margin: 0; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Total Expenses (@Model.Year)</h3>
                <i class="fa-solid fa-arrow-trend-down" style="font-size: 20px; opacity: 0.85;"></i>
            </div>
            <p style="margin: 0; font-size: 30px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">₹@Model.TotalExpense.ToString("N2")</p>
            <small style="opacity: 0.85; font-size: 12px;">Full annual expenses</small>
        </div>
    </div>
    <div class="card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; box-shadow: 0 8px 24px rgba(102, 126, 234, 0.25);">
        <div class="card-body" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <h3 style="margin: 0; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Net Annual Savings</h3>
                <i class="fa-solid fa-piggy-bank" style="font-size: 20px; opacity: 0.85;"></i>
            </div>
            <p style="margin: 0; font-size: 30px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">₹@((Model.TotalIncome - Model.TotalExpense).ToString("N2"))</p>
            <small style="opacity: 0.85; font-size: 12px;">Net balance retained</small>
        </div>
    </div>
</div>

<!-- 2. NEW: YEARLY CHARTS SECTION -->
<div style="margin-bottom: 30px;">
    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
        <i class="fa-solid fa-chart-line" style="color: var(--hud-cyan); font-size: 20px;"></i>
        <h2 style="font-size: 18px; font-weight: 700; color: var(--hud-text-white); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 1px; margin: 0;">
            Annual Financial Analytics Charts
        </h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 20px; margin-bottom: 20px;">
        <!-- Chart 1: Month-by-Month Income vs Expense Bar Chart -->
        <div class="card" style="background: var(--hud-bg-card); border: 1px solid var(--hud-border);">
            <div class="card-header" style="background: var(--hud-bg-card-header); border-bottom: 1px solid var(--hud-border); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--hud-text-white);">
                    <i class="fa-solid fa-chart-column" style="color: var(--hud-teal); margin-right: 8px;"></i> Monthly Income vs Expenses (@Model.Year)
                </h3>
                <span style="font-size: 11px; color: var(--hud-teal); font-family: 'JetBrains Mono', monospace;">MONTHLY COMPARISON</span>
            </div>
            <div class="card-body" style="padding: 20px;">
                <div style="position: relative; height: 280px; width: 100%;">
                    <canvas id="yearlyBarChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 2: Cumulative / Balance Trend Line Chart -->
        <div class="card" style="background: var(--hud-bg-card); border: 1px solid var(--hud-border);">
            <div class="card-header" style="background: var(--hud-bg-card-header); border-bottom: 1px solid var(--hud-border); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--hud-text-white);">
                    <i class="fa-solid fa-arrow-trend-up" style="color: var(--hud-cyan); margin-right: 8px;"></i> Monthly Net Savings Curve
                </h3>
                <span style="font-size: 11px; color: var(--hud-cyan); font-family: 'JetBrains Mono', monospace;">SAVINGS TREND</span>
            </div>
            <div class="card-body" style="padding: 20px;">
                <div style="position: relative; height: 280px; width: 100%;">
                    <canvas id="yearlyLineChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3. Monthly Overview Table (Existing Kept) -->
<div class="card" style="margin-bottom: 30px;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0;">Monthly Overview Table (@Model.Year)</h3>
        <span style="font-size: 12px; color: var(--hud-text-muted);">12-Month Performance</span>
    </div>
    <div class="card-body">
        <table>
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Income</th>
                    <th>Expenses</th>
                    <th>Balance</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var month in Model.MonthlyData)
                {
                    <tr>
                        <td><strong>@month.MonthName</strong></td>
                        <td style="color: #38ef7d; font-family: 'JetBrains Mono', monospace;">₹@month.Income.ToString("N2")</td>
                        <td style="color: #f45c43; font-family: 'JetBrains Mono', monospace;">₹@month.Expense.ToString("N2")</td>
                        <td style="color: @(month.Balance >= 0 ? "#00e5ff" : "#f43f5e"); font-weight: 700; font-family: 'JetBrains Mono', monospace;">₹@month.Balance.ToString("N2")</td>
                        <td>
                            @if (month.Income == 0 && month.Expense == 0)
                            {
                                <span class="badge" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8;">No Activity</span>
                            }
                            else if (month.Balance >= 0)
                            {
                                <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4);">Surplus</span>
                            }
                            else
                            {
                                <span class="badge" style="background: rgba(244, 63, 94, 0.2); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.4);">Deficit</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div style="display: flex; gap: 12px; margin-top: 20px;">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Back to Reports
    </a>
    <a asp-action="MonthlyReport" asp-route-year="@Model.Year" asp-route-month="10" class="btn btn-primary">
        <i class="fa-solid fa-calendar-day"></i> View October Report
    </a>
</div>

@section Scripts {
    <!-- Load Chart.js (Local first with CDN fallback) -->
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        if (typeof Chart === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"><\/script>');
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Chart.defaults.color = '#94a3b8';
            Chart.defaults.font.family = "'Inter', sans-serif";

            const monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyData.Select(m => m.MonthName)));
            const incomeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyData.Select(m => m.Income)));
            const expenseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyData.Select(m => m.Expense)));
            const balanceData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyData.Select(m => m.Balance)));

            // 1. Grouped Bar Chart (Income vs Expense)
            const barCtx = document.getElementById('yearlyBarChart');
            if (barCtx) {
                new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: [
                            {
                                label: 'Income',
                                data: incomeData,
                                backgroundColor: 'rgba(16, 185, 129, 0.85)',
                                borderColor: '#10b981',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Expenses',
                                data: expenseData,
                                backgroundColor: 'rgba(239, 68, 68, 0.85)',
                                borderColor: '#ef4444',
                                borderWidth: 1,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { color: '#cbd5e1', font: { weight: '600' } }
                            },
                            tooltip: {
                                backgroundColor: '#0f1826',
                                borderColor: '#00e5ff',
                                borderWidth: 1,
                                callbacks: {
                                    label: function(context) {
                                        return ` ${context.dataset.label}: ₹${Number(context.raw).toLocaleString('en-IN')}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                ticks: { color: '#cbd5e1' }
                            },
                            y: {
                                grid: { color: 'rgba(255, 255, 255, 0.08)' },
                                ticks: {
                                    callback: function(value) {
                                        return '₹' + Number(value).toLocaleString('en-IN');
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Savings Curve Line Chart
            const lineCtx = document.getElementById('yearlyLineChart');
            if (lineCtx) {
                new Chart(lineCtx, {
                    type: 'line',
                    data: {
                        labels: monthLabels,
                        datasets: [
                            {
                                label: 'Net Monthly Savings',
                                data: balanceData,
                                borderColor: '#00e5ff',
                                backgroundColor: 'rgba(0, 229, 255, 0.15)',
                                fill: true,
                                tension: 0.35,
                                pointBackgroundColor: '#00e5ff',
                                pointBorderColor: '#fff',
                                pointRadius: 5,
                                pointHoverRadius: 7
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { color: '#cbd5e1', font: { weight: '600' } }
                            },
                            tooltip: {
                                backgroundColor: '#0f1826',
                                borderColor: '#00e5ff',
                                borderWidth: 1,
                                callbacks: {
                                    label: function(context) {
                                        return ` Savings: ₹${Number(context.raw).toLocaleString('en-IN')}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                ticks: { color: '#cbd5e1' }
                            },
                            y: {
                                grid: { color: 'rgba(255, 255, 255, 0.08)' },
                                ticks: {
                                    callback: function(value) {
                                        return '₹' + Number(value).toLocaleString('en-IN');
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
