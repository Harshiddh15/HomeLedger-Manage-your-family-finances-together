@using FinanceManagementNet.Models
@model MonthlyReportViewModel
@{
    ViewData["Title"] = "Monthly Report";
    Layout = "_Layout";
}

@if (Model == null)
{
    <div class="card">
        <div class="card-body">
            <p style="color: #f43f5e;">No data available for this report.</p>
            <a asp-action="Index" class="btn btn-secondary">Back to Reports</a>
        </div>
    </div>
}
else
{
    <div class="page-header" style="margin-bottom: 30px;">
        <h1 class="page-title" style="font-size: 24px; font-weight: 800; color: var(--hud-text-white); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 1px;">
            <span style="color: var(--hud-cyan); margin-right: 8px;">//</span> Monthly Report - @Model.Month/@Model.Year
        </h1>
    </div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px;">
    <div class="card" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white;">
        <div class="card-body" style="padding: 25px;">
            <h3 style="margin: 0 0 10px 0; font-size: 14px; opacity: 0.9;">Total Income</h3>
            <p style="margin: 0; font-size: 32px; font-weight: 700;">₹@Model.TotalIncome.ToString("N2")</p>
        </div>
    </div>
    <div class="card" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); color: white;">
        <div class="card-body" style="padding: 25px;">
            <h3 style="margin: 0 0 10px 0; font-size: 14px; opacity: 0.9;">Total Expenses</h3>
            <p style="margin: 0; font-size: 32px; font-weight: 700;">₹@Model.TotalExpense.ToString("N2")</p>
        </div>
    </div>
    <div class="card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
        <div class="card-body" style="padding: 25px;">
            <h3 style="margin: 0 0 10px 0; font-size: 14px; opacity: 0.9;">Net Balance</h3>
            <p style="margin: 0; font-size: 32px; font-weight: 700;">₹@((Model.TotalIncome - Model.TotalExpense).ToString("N2"))</p>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 20px;">
    <div class="card">
        <div class="card-header">
            <h3>Category-wise Expenses</h3>
        </div>
        <div class="card-body">
            @if (Model.CategoryWiseExpenses != null && Model.CategoryWiseExpenses.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>%</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CategoryWiseExpenses)
                        {
                            var percentage = Model.TotalExpense > 0 ? (item.Amount / Model.TotalExpense * 100) : 0;
                            <tr>
                                <td>@item.Category</td>
                                <td>₹@item.Amount.ToString("N2")</td>
                                <td>@percentage.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="text-align: center; color: #666;">No expense data for this month</p>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Recent Transactions</h3>
        </div>
        <div class="card-body">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var income in Model.Incomes.Take(5))
                    {
                        <tr>
                            <td>@income.Date.ToString("d MMM")</td>
                            <td style="color: #11998e;">Income</td>
                            <td style="color: #11998e;">+₹@income.Amount.ToString("N2")</td>
                        </tr>
                    }
                    @foreach (var expense in Model.Expenses.Take(5))
                    {
                        <tr>
                            <td>@expense.Date.ToString("d MMM")</td>
                            <td style="color: #eb3349;">Expense</td>
                            <td style="color: #eb3349;">-₹@expense.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary" style="margin-top: 20px;">
    <i class="fa-solid fa-arrow-left"></i> Back to Reports
</a>
}
