@using FinanceManagementNet.Models
@model MonthlyReportViewModel
@{
    ViewData["Title"] = "Monthly Report";
    Layout = "_Layout";
    var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model?.Month ?? DateTime.Now.Month);
}

@if (Model == null)
{
    <div class="card">
        <div class="card-body">
            <p style="color: #f43f5e;">No data available for this report.</p>
            <a asp-action="Index" class="btn btn-secondary">Back to Reports</a>
        </div>
    </div>
}
else
{
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
        <h1 class="page-title" style="font-size: 24px; font-weight: 800; color: var(--hud-text-white); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 1px; margin: 0;">
            <span style="color: var(--hud-cyan); margin-right: 8px;">//</span> Monthly Report — @monthName @Model.Year
        </h1>

        <!-- Quick Month / Year Selector -->
        <form asp-action="MonthlyReport" method="get" style="display: flex; gap: 10px; align-items: center;">
            <select name="year" class="form-control" style="width: auto; min-width: 100px; padding: 6px 12px; background: #0f1826; color: #fff; border: 1px solid var(--hud-border-cyan);">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                {
                    <option value="@y" selected="@(y == Model.Year)">@y</option>
                }
            </select>
            <select name="month" class="form-control" style="width: auto; min-width: 130px; padding: 6px 12px; background: #0f1826; color: #fff; border: 1px solid var(--hud-border-cyan);">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
            <button type="submit" class="btn btn-primary" style="padding: 6px 16px;">
                <i class="fa-solid fa-filter"></i> Apply
            </button>
        </form>
    </div>

    <!-- 1. Top Summary KPI Cards (Existing Kept) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px;">
        <div class="card" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white; box-shadow: 0 8px 24px rgba(17, 153, 142, 0.25);">
            <div class="card-body" style="padding: 22px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h3 style="margin: 0; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Total Income</h3>
                    <i class="fa-solid fa-arrow-trend-up" style="font-size: 20px; opacity: 0.85;"></i>
                </div>
                <p style="margin: 0; font-size: 30px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">₹@Model.TotalIncome.ToString("N2")</p>
                <small style="opacity: 0.85; font-size: 12px;">@Model.Incomes.Count transactions recorded</small>
            </div>
        </div>
        <div class="card" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); color: white; box-shadow: 0 8px 24px rgba(235, 51, 73, 0.25);">
            <div class="card-body" style="padding: 22px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h3 style="margin: 0; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Total Expenses</h3>
                    <i class="fa-solid fa-arrow-trend-down" style="font-size: 20px; opacity: 0.85;"></i>
                </div>
                <p style="margin: 0; font-size: 30px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">₹@Model.TotalExpense.ToString("N2")</p>
                <small style="opacity: 0.85; font-size: 12px;">@Model.Expenses.Count expenses paid</small>
            </div>
        </div>
        <div class="card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; box-shadow: 0 8px 24px rgba(102, 126, 234, 0.25);">
            <div class="card-body" style="padding: 22px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h3 style="margin: 0; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Net Balance / Savings</h3>
                    <i class="fa-solid fa-wallet" style="font-size: 20px; opacity: 0.85;"></i>
                </div>
                <p style="margin: 0; font-size: 30px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">₹@((Model.TotalIncome - Model.TotalExpense).ToString("N2"))</p>
                <small style="opacity: 0.85; font-size: 12px;">Income minus expenses</small>
            </div>
        </div>
    </div>

    <!-- 2. NEW: VISUAL ANALYTICS CHARTS SECTION -->
    <div style="margin-bottom: 30px;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
            <i class="fa-solid fa-chart-pie" style="color: var(--hud-cyan); font-size: 20px;"></i>
            <h2 style="font-size: 18px; font-weight: 700; color: var(--hud-text-white); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 1px; margin: 0;">
                Interactive Financial Charts & Analytics
            </h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 20px; margin-bottom: 20px;">
            <!-- Chart 1: Category Expense Breakdown (Doughnut) -->
            <div class="card" style="background: var(--hud-bg-card); border: 1px solid var(--hud-border);">
                <div class="card-header" style="background: var(--hud-bg-card-header); border-bottom: 1px solid var(--hud-border); display: flex; justify-content: space-between; align-items: center;">
                    <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--hud-text-white);">
                        <i class="fa-solid fa-chart-pie" style="color: #f59e0b; margin-right: 8px;"></i> Expense by Category
                    </h3>
                    <span style="font-size: 11px; color: var(--hud-cyan); font-family: 'JetBrains Mono', monospace;">BREAKDOWN</span>
                </div>
                <div class="card-body" style="padding: 20px; position: relative;">
                    @if (Model.CategoryWiseExpenses != null && Model.CategoryWiseExpenses.Any())
                    {
                        <div style="position: relative; height: 260px; width: 100%;">
                            <canvas id="categoryChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <p style="text-align: center; color: var(--hud-text-muted); padding: 50px 0;">No expense data to chart</p>
                    }
                </div>
            </div>

            <!-- Chart 2: Income vs Expense Comparison (Bar) -->
            <div class="card" style="background: var(--hud-bg-card); border: 1px solid var(--hud-border);">
                <div class="card-header" style="background: var(--hud-bg-card-header); border-bottom: 1px solid var(--hud-border); display: flex; justify-content: space-between; align-items: center;">
                    <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--hud-text-white);">
                        <i class="fa-solid fa-chart-simple" style="color: var(--hud-cyan); margin-right: 8px;"></i> Financial Overview
                    </h3>
                    <span style="font-size: 11px; color: var(--hud-teal); font-family: 'JetBrains Mono', monospace;">COMPARISON</span>
                </div>
                <div class="card-body" style="padding: 20px; position: relative;">
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="overviewBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 3: Daily Timeline Trend (Line / Area Chart across full month) -->
        <div class="card" style="background: var(--hud-bg-card); border: 1px solid var(--hud-border);">
            <div class="card-header" style="background: var(--hud-bg-card-header); border-bottom: 1px solid var(--hud-border); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--hud-text-white);">
                    <i class="fa-solid fa-chart-line" style="color: var(--hud-blue); margin-right: 8px;"></i> Daily Cash Flow & Transaction Timeline (@monthName @Model.Year)
                </h3>
                <span style="font-size: 11px; color: var(--hud-blue); font-family: 'JetBrains Mono', monospace;">DAILY TREND</span>
            </div>
            <div class="card-body" style="padding: 20px;">
                <div style="position: relative; height: 280px; width: 100%;">
                    <canvas id="dailyTimelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. EXISTING TABLES SECTION (Category-wise & Recent Transactions) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 20px; margin-bottom: 30px;">
        <!-- Category-wise Expenses Table -->
        <div class="card">
            <div class="card-header">
                <h3>Category-wise Expenses</h3>
            </div>
            <div class="card-body">
                @if (Model.CategoryWiseExpenses != null && Model.CategoryWiseExpenses.Any())
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CategoryWiseExpenses)
                            {
                                var percentage = Model.TotalExpense > 0 ? (item.Amount / Model.TotalExpense * 100) : 0;
                                <tr>
                                    <td><strong>@item.Category</strong></td>
                                    <td style="font-weight: 600;">₹@item.Amount.ToString("N2")</td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
                                                <div style="width: @percentage.ToString("F1")%; height: 100%; background: #00e5ff;"></div>
                                            </div>
                                            <span style="min-width: 45px; text-align: right; font-size: 12px; font-family: 'JetBrains Mono', monospace;">@percentage.ToString("F1")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p style="text-align: center; color: #666; padding: 20px 0;">No expense data for this month</p>
                }
            </div>
        </div>

        <!-- Recent Transactions Table -->
        <div class="card">
            <div class="card-header">
                <h3>Transactions List (@monthName)</h3>
            </div>
            <div class="card-body" style="max-height: 420px; overflow-y: auto;">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var income in Model.Incomes)
                        {
                            <tr>
                                <td>@income.Date.ToString("d MMM")</td>
                                <td>@(string.IsNullOrEmpty(income.Description) ? income.Source : income.Description)</td>
                                <td><span class="badge" style="background: rgba(17, 153, 142, 0.2); color: #38ef7d; border: 1px solid rgba(56, 239, 125, 0.4);">Income</span></td>
                                <td style="color: #38ef7d; font-weight: 600; font-family: 'JetBrains Mono', monospace;">+₹@income.Amount.ToString("N2")</td>
                            </tr>
                        }
                        @foreach (var expense in Model.Expenses)
                        {
                            <tr>
                                <td>@expense.Date.ToString("d MMM")</td>
                                <td>@(string.IsNullOrEmpty(expense.Description) ? expense.Category : expense.Description)</td>
                                <td><span class="badge" style="background: rgba(235, 51, 73, 0.2); color: #f45c43; border: 1px solid rgba(244, 92, 67, 0.4);">Expense</span></td>
                                <td style="color: #f45c43; font-weight: 600; font-family: 'JetBrains Mono', monospace;">-₹@expense.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div style="display: flex; gap: 12px; margin-top: 20px;">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Back to Reports
        </a>
        <a asp-action="YearlyReport" asp-route-year="@Model.Year" class="btn btn-primary">
            <i class="fa-solid fa-calendar-days"></i> View Yearly Report
        </a>
    </div>
}

@section Scripts {
    <!-- Load Chart.js (Local first with CDN fallback) -->
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        if (typeof Chart === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"><\/script>');
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Colors palette matching HUD Admin dark theme
            const palette = [
                '#f59e0b', '#00e5ff', '#ef4444', '#8b5cf6', 
                '#10b981', '#ec4899', '#3b82f6', '#14b8a6', 
                '#f97316', '#6366f1'
            ];

            Chart.defaults.color = '#94a3b8';
            Chart.defaults.font.family = "'Inter', sans-serif";

            // 1. Category Doughnut Chart
            @if (Model?.CategoryWiseExpenses != null && Model.CategoryWiseExpenses.Any())
            {
                <text>
                const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryWiseExpenses.Select(c => c.Category)));
                const catAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryWiseExpenses.Select(c => c.Amount)));

                const catCtx = document.getElementById('categoryChart');
                if (catCtx) {
                    new Chart(catCtx, {
                        type: 'doughnut',
                        data: {
                            labels: catLabels,
                            datasets: [{
                                data: catAmounts,
                                backgroundColor: palette.slice(0, catLabels.length),
                                borderColor: '#0b111e',
                                borderWidth: 3,
                                hoverOffset: 8
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'right',
                                    labels: {
                                        boxWidth: 12,
                                        padding: 12,
                                        color: '#cbd5e1',
                                        font: { size: 12 }
                                    }
                                },
                                tooltip: {
                                    backgroundColor: '#0f1826',
                                    borderColor: '#00e5ff',
                                    borderWidth: 1,
                                    padding: 10,
                                    callbacks: {
                                        label: function(context) {
                                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                            const val = context.raw || 0;
                                            const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                            return ` ₹${val.toLocaleString('en-IN')} (${pct}%)`;
                                        }
                                    }
                                }
                            },
                            cutout: '65%'
                        }
                    });
                }
                </text>
            }

            // 2. Financial Overview Bar Chart (Income vs Expense vs Net)
            const overviewCtx = document.getElementById('overviewBarChart');
            if (overviewCtx) {
                const totalInc = @Model?.TotalIncome;
                const totalExp = @Model?.TotalExpense;
                const netBal = @(Model != null ? (Model.TotalIncome - Model.TotalExpense) : 0);

                new Chart(overviewCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Total Income', 'Total Expenses', 'Net Balance'],
                        datasets: [{
                            data: [totalInc, totalExp, netBal],
                            backgroundColor: [
                                'rgba(17, 153, 142, 0.85)',
                                'rgba(235, 51, 73, 0.85)',
                                'rgba(0, 229, 255, 0.85)'
                            ],
                            borderColor: [
                                '#11998e',
                                '#eb3349',
                                '#00e5ff'
                            ],
                            borderWidth: 2,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f1826',
                                borderColor: '#00e5ff',
                                borderWidth: 1,
                                callbacks: {
                                    label: function(context) {
                                        return ` ₹${Number(context.raw).toLocaleString('en-IN')}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                ticks: { color: '#cbd5e1', font: { weight: '600' } }
                            },
                            y: {
                                grid: { color: 'rgba(255, 255, 255, 0.08)' },
                                ticks: {
                                    callback: function(value) {
                                        return '₹' + Number(value).toLocaleString('en-IN');
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 3. Daily Timeline Chart (Income vs Expense Spikes)
            @if (Model?.DailyData != null && Model.DailyData.Any())
            {
                <text>
                const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyData.Select(d => d.DateLabel)));
                const dailyIncomes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyData.Select(d => d.Income)));
                const dailyExpenses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyData.Select(d => d.Expense)));

                const dailyCtx = document.getElementById('dailyTimelineChart');
                if (dailyCtx) {
                    new Chart(dailyCtx, {
                        type: 'line',
                        data: {
                            labels: dailyLabels,
                            datasets: [
                                {
                                    label: 'Income (+)',
                                    data: dailyIncomes,
                                    borderColor: '#10b981',
                                    backgroundColor: 'rgba(16, 185, 129, 0.15)',
                                    fill: true,
                                    tension: 0.35,
                                    pointBackgroundColor: '#10b981',
                                    pointBorderColor: '#fff',
                                    pointRadius: 4,
                                    pointHoverRadius: 6
                                },
                                {
                                    label: 'Expense (−)',
                                    data: dailyExpenses,
                                    borderColor: '#ef4444',
                                    backgroundColor: 'rgba(239, 68, 68, 0.15)',
                                    fill: true,
                                    tension: 0.35,
                                    pointBackgroundColor: '#ef4444',
                                    pointBorderColor: '#fff',
                                    pointRadius: 4,
                                    pointHoverRadius: 6
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: {
                                mode: 'index',
                                intersect: false
                            },
                            plugins: {
                                legend: {
                                    position: 'top',
                                    labels: {
                                        color: '#cbd5e1',
                                        font: { size: 12, weight: '600' }
                                    }
                                },
                                tooltip: {
                                    backgroundColor: '#0f1826',
                                    borderColor: '#00e5ff',
                                    borderWidth: 1,
                                    padding: 10,
                                    callbacks: {
                                        label: function(context) {
                                            return ` ${context.dataset.label}: ₹${Number(context.raw).toLocaleString('en-IN')}`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                    ticks: {
                                        color: '#94a3b8',
                                        maxRotation: 45,
                                        minRotation: 45
                                    }
                                },
                                y: {
                                    grid: { color: 'rgba(255, 255, 255, 0.08)' },
                                    ticks: {
                                        callback: function(value) {
                                            return '₹' + Number(value).toLocaleString('en-IN');
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
                </text>
            }
        });
    </script>
}
