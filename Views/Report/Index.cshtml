@{
    ViewData["Title"] = "Financial Reports & Visual Intelligence";
    Layout = "_Layout";
    
    var currentYear = DateTime.Now.Year;
    var currentMonth = DateTime.Now.Month;
    var isMember = Context.Session.GetString("LoginType") == "Member";
}

<div>
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; margin: 0;">Financial Reports &amp; Intelligence</h1>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Audited category breakdowns, interactive charts, and cash-flow timelines</p>
        </div>
        <div>
            @if (isMember)
            {
                <a asp-controller="Home" asp-action="MemberDashboard" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left"></i> Member Portal
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left"></i> Admin Dashboard
                </a>
            }
        </div>
    </div>

    <!-- Report Generator Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px; margin-bottom: 30px;">
        <!-- Card 1: Monthly Deep-Dive Report -->
        <div class="glass-card" style="padding: 28px; position: relative;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
                <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: rgba(99, 102, 241, 0.15); color: #818cf8; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <div>
                    <h3 style="font-size: 18px; font-weight: 800; margin: 0;">Monthly Financial Report</h3>
                    <small style="color: var(--text-dim); font-size: 12px;">Category doughnut, timeline &amp; tables</small>
                </div>
            </div>
            <p style="color: var(--text-muted); font-size: 13.5px; line-height: 1.5; margin-bottom: 22px;">
                Comprehensive month-by-month cashflow breakdown, category-wise expenditure chart, and itemized transaction ledger.
            </p>
            <form asp-action="MonthlyReport" method="get" style="display: flex; gap: 10px; flex-wrap: wrap;">
                <select name="year" class="form-control" style="flex: 1; min-width: 100px;">
                    @for (int y = currentYear; y >= currentYear - 5; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <select name="month" class="form-control" style="flex: 1; min-width: 120px;">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == currentMonth || m == 10)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
                <button type="submit" class="btn btn-indigo" style="padding: 10px 18px;">
                    <i class="fa-solid fa-arrow-right"></i> View Report
                </button>
            </form>
        </div>

        <!-- Card 2: Yearly Executive Overview -->
        <div class="glass-card" style="padding: 28px; position: relative;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
                <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: rgba(16, 185, 129, 0.15); color: #34d399; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="fa-solid fa-chart-column"></i>
                </div>
                <div>
                    <h3 style="font-size: 18px; font-weight: 800; margin: 0;">Annual Wealth Summary</h3>
                    <small style="color: var(--text-dim); font-size: 12px;">Full-year aggregate performance</small>
                </div>
            </div>
            <p style="color: var(--text-muted); font-size: 13.5px; line-height: 1.5; margin-bottom: 22px;">
                Multi-month trend analysis, annual savings retention rate, and year-over-year spending pattern comparisons.
            </p>
            <form asp-action="YearlyReport" method="get" style="display: flex; gap: 10px; flex-wrap: wrap;">
                <select name="year" class="form-control" style="flex: 1; min-width: 140px;">
                    @for (int y = currentYear; y >= currentYear - 5; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary" style="padding: 10px 22px;">
                    <i class="fa-solid fa-arrow-right"></i> View Annual
                </button>
            </form>
        </div>
    </div>
</div>
